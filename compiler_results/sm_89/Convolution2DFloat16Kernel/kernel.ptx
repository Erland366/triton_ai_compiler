.version 8.7
.target sm_89
.address_size 64

.extern .shared .align 16 .b8 global_smem[];

.visible .entry kernel(
    .param .u64 x_ptr,
    .param .u64 weight_ptr,
    .param .u64 output_ptr,
    .param .u64 dummy_ptr1,
    .param .u64 dummy_ptr2
)
{
    .reg .pred %p<8>;
    .reg .b32 %r<96>;
    .reg .b64 %rd<24>;
    .reg .b32 %g<8>, %e<8>;
    .reg .b128 %zero;
    .reg .b32 %a<8>, %b<16>;
    .reg .f32 %f<128>;

    // Decode the CTA, warp, and paired NCHW spatial coordinates.
    ld.param.u64 %rd0, [x_ptr];
    ld.param.u64 %rd1, [weight_ptr];
    mov.u32 %r0, %tid.x;
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ctaid.y;
    mov.u32 %r3, %laneid;
    shr.u32 %r4, %r0, 5;
    shr.u32 %r5, %r4, 1;
    shl.b32 %r5, %r5, 6;
    shl.b32 %r2, %r2, 7;
    add.u32 %r5, %r5, %r2;
    and.b32 %r6, %r4, 1;
    shl.b32 %r6, %r6, 6;
    shl.b32 %r7, %r1, 7;
    and.b32 %r8, %r0, 63;
    shl.b32 %r8, %r8, 1;
    add.u32 %r9, %r7, %r8;
    div.u32 %r10, %r9, 2916;
    rem.u32 %r11, %r9, 2916;
    div.u32 %r12, %r11, 54;
    rem.u32 %r13, %r11, 54;
    mad.lo.u32 %r14, %r10, 200704, %r13;
    mad.lo.u32 %r14, %r12, 56, %r14;
    mul.wide.u32 %rd3, %r14, 2;
    add.u64 %rd3, %rd0, %rd3;
    mov.u32 %r15, global_smem;

    // Swizzle shared-memory tiles for conflict-free tensor-core matrix loads.
    and.b32 %r16, %r3, 15;
    shr.u32 %r17, %r3, 4;
    shr.u32 %r18, %r3, 2;
    and.b32 %r18, %r18, 1;
    xor.b32 %r18, %r18, %r17;
    shl.b32 %r18, %r18, 4;
    sub.u32 %r19, %r5, %r2;
    add.u32 %r19, %r19, %r16;
    mad.lo.u32 %r20, %r19, 32, %r18;
    add.u32 %r20, %r20, %r15;
    and.b32 %r18, %r3, 7;
    xor.b32 %r18, %r18, %r17;
    shl.b32 %r18, %r18, 4;
    shl.b32 %r19, %r6, 1;
    add.u32 %r18, %r18, %r19;
    mad.lo.u32 %r21, %r16, 256, %r18;
    add.u32 %r21, %r21, 4096;
    add.u32 %r21, %r21, %r15;
    xor.b32 %r22, %r21, 32;
    xor.b32 %r23, %r21, 64;
    xor.b32 %r24, %r21, 96;

    // Assign two aligned weight vectors to each thread.
    shr.u32 %r25, %r0, 1;
    and.b32 %r26, %r0, 1;
    shr.u32 %r27, %r25, 2;
    and.b32 %r27, %r27, 1;
    xor.b32 %r27, %r27, %r26;
    shl.b32 %r27, %r27, 4;
    mad.lo.u32 %r28, %r25, 32, %r27;
    add.u32 %r28, %r28, %r15;
    add.u32 %r25, %r25, %r2;
    shl.b32 %r26, %r26, 3;
    mad.lo.u32 %r29, %r25, 576, %r26;
    mul.wide.u32 %rd4, %r29, 2;
    add.u64 %rd4, %rd1, %rd4;

    // Initialize all FP32 accumulators and paired input-store addresses.
    mov.u32 %r49, 0;
    mov.b128 %zero, {%r49,%r49,%r49,%r49};
    mov.b128 {%f0,%f1,%f2,%f3},%zero;
    mov.b128 {%f4,%f5,%f6,%f7},%zero;
    mov.b128 {%f8,%f9,%f10,%f11},%zero;
    mov.b128 {%f12,%f13,%f14,%f15},%zero;
    mov.b128 {%f16,%f17,%f18,%f19},%zero;
    mov.b128 {%f20,%f21,%f22,%f23},%zero;
    mov.b128 {%f24,%f25,%f26,%f27},%zero;
    mov.b128 {%f28,%f29,%f30,%f31},%zero;
    mov.b128 {%f32,%f33,%f34,%f35},%zero;
    mov.b128 {%f36,%f37,%f38,%f39},%zero;
    mov.b128 {%f40,%f41,%f42,%f43},%zero;
    mov.b128 {%f44,%f45,%f46,%f47},%zero;
    mov.b128 {%f48,%f49,%f50,%f51},%zero;
    mov.b128 {%f52,%f53,%f54,%f55},%zero;
    mov.b128 {%f56,%f57,%f58,%f59},%zero;
    mov.b128 {%f60,%f61,%f62,%f63},%zero;
    mov.b128 {%f64,%f65,%f66,%f67},%zero;
    mov.b128 {%f68,%f69,%f70,%f71},%zero;
    mov.b128 {%f72,%f73,%f74,%f75},%zero;
    mov.b128 {%f76,%f77,%f78,%f79},%zero;
    mov.b128 {%f80,%f81,%f82,%f83},%zero;
    mov.b128 {%f84,%f85,%f86,%f87},%zero;
    mov.b128 {%f88,%f89,%f90,%f91},%zero;
    mov.b128 {%f92,%f93,%f94,%f95},%zero;
    mov.b128 {%f96,%f97,%f98,%f99},%zero;
    mov.b128 {%f100,%f101,%f102,%f103},%zero;
    mov.b128 {%f104,%f105,%f106,%f107},%zero;
    mov.b128 {%f108,%f109,%f110,%f111},%zero;
    mov.b128 {%f112,%f113,%f114,%f115},%zero;
    mov.b128 {%f116,%f117,%f118,%f119},%zero;
    mov.b128 {%f120,%f121,%f122,%f123},%zero;
    mov.b128 {%f124,%f125,%f126,%f127},%zero;
    shr.u32 %r32, %r0, 6;
    shl.b32 %r40, %r32, 3;
    xor.b32 %r40, %r40, %r8;
    shl.b32 %r40, %r40, 1;
    mad.lo.u32 %r52, %r32, 256, %r40;
    add.u32 %r52, %r52, 4096;
    add.u32 %r52, %r52, %r15;

    // Each lane computes one displacement for reuse by its warp.
    and.b32 %r54, %r3, 7;
    shl.b32 %r54, %r54, 1;
    add.u32 %r54, %r54, %r32;
    mov.u32 %r30, 0;
    mov.u32 %r50, 0;
    mov.u32 %r51, 0;
    mov.pred %p1, 1;
    mov.pred %p2, 0;
PREFETCH:
    // Two 8192-byte buffers overlap weight copies and NCHW gathers with tensor cores.
    add.u32 %r53, %r28, %r51;
    cp.async.ca.shared.global [%r53], [%rd4], 16;
    add.u32 %r31, %r53, 2048;
    add.u64 %rd5, %rd4, 73728;
    cp.async.ca.shared.global [%r31], [%rd5], 16;
    cp.async.commit_group;

    // The filter column is k modulo three, uniform within each staging warp.
    add.u32 %r60, %r30, %r32;
    mul.hi.u32 %r61, %r60, 2863311531;
    shr.u32 %r61, %r61, 1;
    mad.lo.s32 %r60, %r61, -3, %r60;
    setp.eq.u32 %p3, %r60, 1;
    setp.eq.u32 %p4, %r60, 2;
    setp.eq.u32 %p5, %r60, 0;

    // Decode the NCHW channel and 3 by 3 filter displacement cooperatively.
    add.u32 %r33, %r30, %r54;
    mul.hi.u32 %r34, %r33, 954437177;
    shr.u32 %r34, %r34, 1;
    mad.lo.s32 %r35, %r34, -9, %r33;
    mul.hi.u32 %r36, %r35, 2863311531;
    shr.u32 %r36, %r36, 1;
    mad.lo.u32 %r38, %r34, 3127, %r33;
    mad.lo.u32 %r38, %r36, 53, %r38;

    // Load aligned pairs, fetching an extra half only for odd filter columns.
    shfl.sync.idx.b32 %r60, %r38, 0, 31, -1;
    and.b32 %r61, %r60, -2;
    mul.wide.u32 %rd6, %r61, 2;
    add.u64 %rd6, %rd3, %rd6;
    ld.global.L1::evict_last.b32 %g0, [%rd6];
    mov.b32 %e0, 0;
    @%p3 ld.global.L1::evict_last.u16 %e0, [%rd6+4];
    shfl.sync.idx.b32 %r60, %r38, 1, 31, -1;
    and.b32 %r61, %r60, -2;
    mul.wide.u32 %rd6, %r61, 2;
    add.u64 %rd6, %rd3, %rd6;
    ld.global.L1::evict_last.b32 %g1, [%rd6];
    mov.b32 %e1, 0;
    @%p4 ld.global.L1::evict_last.u16 %e1, [%rd6+4];
    shfl.sync.idx.b32 %r60, %r38, 2, 31, -1;
    and.b32 %r61, %r60, -2;
    mul.wide.u32 %rd6, %r61, 2;
    add.u64 %rd6, %rd3, %rd6;
    ld.global.L1::evict_last.b32 %g2, [%rd6];
    mov.b32 %e2, 0;
    @%p5 ld.global.L1::evict_last.u16 %e2, [%rd6+4];
    shfl.sync.idx.b32 %r60, %r38, 3, 31, -1;
    and.b32 %r61, %r60, -2;
    mul.wide.u32 %rd6, %r61, 2;
    add.u64 %rd6, %rd3, %rd6;
    ld.global.L1::evict_last.b32 %g3, [%rd6];
    mov.b32 %e3, 0;
    @%p3 ld.global.L1::evict_last.u16 %e3, [%rd6+4];
    shfl.sync.idx.b32 %r60, %r38, 4, 31, -1;
    and.b32 %r61, %r60, -2;
    mul.wide.u32 %rd6, %r61, 2;
    add.u64 %rd6, %rd3, %rd6;
    ld.global.L1::evict_last.b32 %g4, [%rd6];
    mov.b32 %e4, 0;
    @%p4 ld.global.L1::evict_last.u16 %e4, [%rd6+4];
    shfl.sync.idx.b32 %r60, %r38, 5, 31, -1;
    and.b32 %r61, %r60, -2;
    mul.wide.u32 %rd6, %r61, 2;
    add.u64 %rd6, %rd3, %rd6;
    ld.global.L1::evict_last.b32 %g5, [%rd6];
    mov.b32 %e5, 0;
    @%p5 ld.global.L1::evict_last.u16 %e5, [%rd6+4];
    shfl.sync.idx.b32 %r60, %r38, 6, 31, -1;
    and.b32 %r61, %r60, -2;
    mul.wide.u32 %rd6, %r61, 2;
    add.u64 %rd6, %rd3, %rd6;
    ld.global.L1::evict_last.b32 %g6, [%rd6];
    mov.b32 %e6, 0;
    @%p3 ld.global.L1::evict_last.u16 %e6, [%rd6+4];
    shfl.sync.idx.b32 %r60, %r38, 7, 31, -1;
    and.b32 %r61, %r60, -2;
    mul.wide.u32 %rd6, %r61, 2;
    add.u64 %rd6, %rd3, %rd6;
    ld.global.L1::evict_last.b32 %g7, [%rd6];
    mov.b32 %e7, 0;
    @%p4 ld.global.L1::evict_last.u16 %e7, [%rd6+4];
    @%p1 bra.uni FINISH_STAGE;

COMPUTE:
    // Compute the previous tile while the next gathered input is in flight.
    bar.warp.sync -1;
    add.u32 %r55, %r20, %r50;

    // Load weights early and retain input fragments across all channel fragments.
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a0,%a1,%a2,%a3}, [%r55];
    add.u32 %r56, %r21, %r50;
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b0,%b1,%b2,%b3}, [%r56];
    add.u32 %r56, %r22, %r50;
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b4,%b5,%b6,%b7}, [%r56];
    add.u32 %r56, %r23, %r50;
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b8,%b9,%b10,%b11}, [%r56];
    add.u32 %r56, %r24, %r50;
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b12,%b13,%b14,%b15}, [%r56];
    add.u32 %r42, %r55, 512;
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a4,%a5,%a6,%a7}, [%r42];

    // Accumulate the first channel fragment while the next weights are in flight.
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f0,%f1,%f2,%f3}, {%a0,%a1,%a2,%a3}, {%b0,%b1}, {%f0,%f1,%f2,%f3};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f4,%f5,%f6,%f7}, {%a0,%a1,%a2,%a3}, {%b2,%b3}, {%f4,%f5,%f6,%f7};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f8,%f9,%f10,%f11}, {%a0,%a1,%a2,%a3}, {%b4,%b5}, {%f8,%f9,%f10,%f11};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f12,%f13,%f14,%f15}, {%a0,%a1,%a2,%a3}, {%b6,%b7}, {%f12,%f13,%f14,%f15};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f16,%f17,%f18,%f19}, {%a0,%a1,%a2,%a3}, {%b8,%b9}, {%f16,%f17,%f18,%f19};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f20,%f21,%f22,%f23}, {%a0,%a1,%a2,%a3}, {%b10,%b11}, {%f20,%f21,%f22,%f23};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f24,%f25,%f26,%f27}, {%a0,%a1,%a2,%a3}, {%b12,%b13}, {%f24,%f25,%f26,%f27};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f28,%f29,%f30,%f31}, {%a0,%a1,%a2,%a3}, {%b14,%b15}, {%f28,%f29,%f30,%f31};
    add.u32 %r42, %r55, 1024;
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a0,%a1,%a2,%a3}, [%r42];

    // Accumulate the second channel fragment.
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f32,%f33,%f34,%f35}, {%a4,%a5,%a6,%a7}, {%b0,%b1}, {%f32,%f33,%f34,%f35};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f36,%f37,%f38,%f39}, {%a4,%a5,%a6,%a7}, {%b2,%b3}, {%f36,%f37,%f38,%f39};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f40,%f41,%f42,%f43}, {%a4,%a5,%a6,%a7}, {%b4,%b5}, {%f40,%f41,%f42,%f43};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f44,%f45,%f46,%f47}, {%a4,%a5,%a6,%a7}, {%b6,%b7}, {%f44,%f45,%f46,%f47};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f48,%f49,%f50,%f51}, {%a4,%a5,%a6,%a7}, {%b8,%b9}, {%f48,%f49,%f50,%f51};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f52,%f53,%f54,%f55}, {%a4,%a5,%a6,%a7}, {%b10,%b11}, {%f52,%f53,%f54,%f55};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f56,%f57,%f58,%f59}, {%a4,%a5,%a6,%a7}, {%b12,%b13}, {%f56,%f57,%f58,%f59};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f60,%f61,%f62,%f63}, {%a4,%a5,%a6,%a7}, {%b14,%b15}, {%f60,%f61,%f62,%f63};
    add.u32 %r42, %r55, 1536;
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a4,%a5,%a6,%a7}, [%r42];

    // Accumulate the third channel fragment.
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f64,%f65,%f66,%f67}, {%a0,%a1,%a2,%a3}, {%b0,%b1}, {%f64,%f65,%f66,%f67};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f68,%f69,%f70,%f71}, {%a0,%a1,%a2,%a3}, {%b2,%b3}, {%f68,%f69,%f70,%f71};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f72,%f73,%f74,%f75}, {%a0,%a1,%a2,%a3}, {%b4,%b5}, {%f72,%f73,%f74,%f75};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f76,%f77,%f78,%f79}, {%a0,%a1,%a2,%a3}, {%b6,%b7}, {%f76,%f77,%f78,%f79};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f80,%f81,%f82,%f83}, {%a0,%a1,%a2,%a3}, {%b8,%b9}, {%f80,%f81,%f82,%f83};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f84,%f85,%f86,%f87}, {%a0,%a1,%a2,%a3}, {%b10,%b11}, {%f84,%f85,%f86,%f87};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f88,%f89,%f90,%f91}, {%a0,%a1,%a2,%a3}, {%b12,%b13}, {%f88,%f89,%f90,%f91};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f92,%f93,%f94,%f95}, {%a0,%a1,%a2,%a3}, {%b14,%b15}, {%f92,%f93,%f94,%f95};

    // Accumulate the final channel fragment from the prefetched weights.
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f96,%f97,%f98,%f99}, {%a4,%a5,%a6,%a7}, {%b0,%b1}, {%f96,%f97,%f98,%f99};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f100,%f101,%f102,%f103}, {%a4,%a5,%a6,%a7}, {%b2,%b3}, {%f100,%f101,%f102,%f103};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f104,%f105,%f106,%f107}, {%a4,%a5,%a6,%a7}, {%b4,%b5}, {%f104,%f105,%f106,%f107};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f108,%f109,%f110,%f111}, {%a4,%a5,%a6,%a7}, {%b6,%b7}, {%f108,%f109,%f110,%f111};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f112,%f113,%f114,%f115}, {%a4,%a5,%a6,%a7}, {%b8,%b9}, {%f112,%f113,%f114,%f115};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f116,%f117,%f118,%f119}, {%a4,%a5,%a6,%a7}, {%b10,%b11}, {%f116,%f117,%f118,%f119};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f120,%f121,%f122,%f123}, {%a4,%a5,%a6,%a7}, {%b12,%b13}, {%f120,%f121,%f122,%f123};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f124,%f125,%f126,%f127}, {%a4,%a5,%a6,%a7}, {%b14,%b15}, {%f124,%f125,%f126,%f127};
    @%p2 bra.uni OUTPUT;

FINISH_STAGE:
    // Shift odd columns by one half and publish the next swizzled input tile.
    add.u32 %r57, %r52, %r51;
    @%p3 shf.r.wrap.b32 %g0,%g0,%e0,16;
    xor.b32 %r41,%r57,0;
    st.shared.b32 [%r41],%g0;
    @%p4 shf.r.wrap.b32 %g1,%g1,%e1,16;
    xor.b32 %r41,%r57,32;
    st.shared.b32 [%r41+512],%g1;
    @%p5 shf.r.wrap.b32 %g2,%g2,%e2,16;
    xor.b32 %r41,%r57,64;
    st.shared.b32 [%r41+1024],%g2;
    @%p3 shf.r.wrap.b32 %g3,%g3,%e3,16;
    xor.b32 %r41,%r57,96;
    st.shared.b32 [%r41+1536],%g3;
    @%p4 shf.r.wrap.b32 %g4,%g4,%e4,16;
    xor.b32 %r41,%r57,0;
    st.shared.b32 [%r41+2048],%g4;
    @%p5 shf.r.wrap.b32 %g5,%g5,%e5,16;
    xor.b32 %r41,%r57,32;
    st.shared.b32 [%r41+2560],%g5;
    @%p3 shf.r.wrap.b32 %g6,%g6,%e6,16;
    xor.b32 %r41,%r57,64;
    st.shared.b32 [%r41+3072],%g6;
    @%p4 shf.r.wrap.b32 %g7,%g7,%e7,16;
    xor.b32 %r41,%r57,96;
    st.shared.b32 [%r41+3584],%g7;

    // Publish the next tile and protect the preceding shared-memory buffer.
    cp.async.wait_group 0;
    bar.sync 0;
    mov.u32 %r50, %r51;
    xor.b32 %r51, %r51, 8192;
    add.u64 %rd4, %rd4, 32;
    add.u32 %r30, %r30, 16;
    mov.pred %p1, 0;
    setp.lt.u32 %p0, %r30, 576;
    @%p0 bra.uni PREFETCH;

    // Drain the last tile without an out-of-range prefetch.
    mov.pred %p2, 1;
    bra.uni COMPUTE;

OUTPUT:
    // Complete all matrix reads before reusing shared memory for output.
    bar.sync 0;

    // Reload epilogue coordinates instead of retaining them during reduction.
    ld.param.u64 %rd2, [output_ptr];
    mov.u32 %r0, %tid.x;
    mov.u32 %r3, %laneid;
    mov.u32 %r2, %ctaid.y;
    shl.b32 %r2, %r2, 7;
    mov.u32 %r7, %ctaid.x;
    shl.b32 %r7, %r7, 7;
    shr.u32 %r4, %r0, 5;
