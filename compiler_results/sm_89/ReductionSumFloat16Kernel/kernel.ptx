.version 8.7
.target sm_89
.address_size 64

.extern .shared .align 16 .b8 global_smem[];

.visible .entry kernel(
    .param .u64 x_ptr,
    .param .u64 output_ptr,
    .param .u64 dummy_ptr1,
    .param .u64 dummy_ptr2
)
{
    .reg .pred %p<2>;
    .reg .b16 %h<16>;
    .reg .b32 %r<8>, %a<8>;
    .reg .b64 %rd<5>;
    .reg .f32 %f<17>;

    // Warp zero explicitly covers all 512 elements with sixteen values per lane.
    mov.u32 %r0, %tid.x;
    setp.ge.u32 %p0, %r0, 32;
    @%p0 bra DONE;
    ld.param.u64 %rd0, [x_ptr];
    ld.param.u64 %rd1, [output_ptr];
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ctaid.y;
    shl.b32 %r3, %r2, 13;
    shl.b32 %r4, %r1, 10;
    add.u32 %r3, %r3, %r4;
    mad.lo.u32 %r3, %r0, 16, %r3;
    cvt.u64.u32 %rd2, %r3;
    add.u64 %rd2, %rd0, %rd2;

    // Two coalesced vector loads cover the entire unmasked tile.
    ld.global.v4.b32 {%a0, %a1, %a2, %a3}, [%rd2];
    ld.global.v4.b32 {%a4, %a5, %a6, %a7}, [%rd2+512];
    mov.b32 {%h0, %h1}, %a0;
    mov.b32 {%h2, %h3}, %a1;
    mov.b32 {%h4, %h5}, %a2;
    mov.b32 {%h6, %h7}, %a3;
    mov.b32 {%h8, %h9}, %a4;
    mov.b32 {%h10, %h11}, %a5;
    mov.b32 {%h12, %h13}, %a6;
    mov.b32 {%h14, %h15}, %a7;

    // Convert every half to FP32 before a balanced local reduction.
    cvt.f32.f16 %f0, %h0;
    cvt.f32.f16 %f1, %h1;
    cvt.f32.f16 %f2, %h2;
    cvt.f32.f16 %f3, %h3;
    cvt.f32.f16 %f4, %h4;
    cvt.f32.f16 %f5, %h5;
    cvt.f32.f16 %f6, %h6;
    cvt.f32.f16 %f7, %h7;
    cvt.f32.f16 %f8, %h8;
    cvt.f32.f16 %f9, %h9;
    cvt.f32.f16 %f10, %h10;
    cvt.f32.f16 %f11, %h11;
    cvt.f32.f16 %f12, %h12;
    cvt.f32.f16 %f13, %h13;
    cvt.f32.f16 %f14, %h14;
    cvt.f32.f16 %f15, %h15;
    add.f32 %f0, %f0, %f8;
    add.f32 %f1, %f1, %f9;
    add.f32 %f2, %f2, %f10;
    add.f32 %f3, %f3, %f11;
    add.f32 %f4, %f4, %f12;
    add.f32 %f5, %f5, %f13;
    add.f32 %f6, %f6, %f14;
    add.f32 %f7, %f7, %f15;
    add.f32 %f0, %f0, %f4;
    add.f32 %f1, %f1, %f5;
    add.f32 %f2, %f2, %f6;
    add.f32 %f3, %f3, %f7;
    add.f32 %f0, %f0, %f2;
    add.f32 %f1, %f1, %f3;
    add.f32 %f0, %f0, %f1;

    // Combine all thirty-two lane sums without shared memory or a CTA barrier.
    shfl.sync.bfly.b32 %f16, %f0, 16, 31, 0xffffffff;
    add.f32 %f0, %f0, %f16;
    shfl.sync.bfly.b32 %f16, %f0, 8, 31, 0xffffffff;
    add.f32 %f0, %f0, %f16;
    shfl.sync.bfly.b32 %f16, %f0, 4, 31, 0xffffffff;
    add.f32 %f0, %f0, %f16;
    shfl.sync.bfly.b32 %f16, %f0, 2, 31, 0xffffffff;
    add.f32 %f0, %f0, %f16;
    shfl.sync.bfly.b32 %f16, %f0, 1, 31, 0xffffffff;
    add.f32 %f0, %f0, %f16;

    // A single lane atomically adds the tile sum to the existing output.
    mul.wide.u32 %rd3, %r2, 4;
    add.u64 %rd3, %rd1, %rd3;
    setp.eq.u32 %p1, %r0, 0;
    @%p1 red.relaxed.gpu.global.add.f32 [%rd3], %f0;
DONE:
    ret;
}
