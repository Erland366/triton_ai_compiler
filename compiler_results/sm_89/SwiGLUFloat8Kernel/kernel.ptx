.version 8.7
.target sm_89
.address_size 64

.extern .shared .align 16 .b8 global_smem[];

.visible .entry kernel(
    .param .u64 gate_ptr,
    .param .u64 value_ptr,
    .param .u64 output_ptr,
    .param .u64 dummy_ptr1,
    .param .u64 dummy_ptr2
)
{
    .reg .b32 %r<12>;
    .reg .b64 %p<7>;
    .reg .b16 %h<12>;
    .reg .f32 %g<4>, %v<4>, %a<4>;

    // Map all 512 threads to four adjacent elements each.
    ld.param.u64 %p0,[gate_ptr];
    ld.param.u64 %p1,[value_ptr];
    ld.param.u64 %p2,[output_ptr];
    mov.u32 %r0,%ctaid.x;
    mov.u32 %r1,%tid.x;
    shl.b32 %r1,%r1,2;
    mad.lo.u32 %r0,%r0,2048,%r1;
    cvt.u64.u32 %p3,%r0;
    add.u64 %p4,%p0,%p3;
    add.u64 %p5,%p1,%p3;
    shl.b64 %p3,%p3,1;
    add.u64 %p6,%p2,%p3;

    // Bypass L1 for streaming packed FP8 loads; convert exactly to FP32.
    ld.global.cg.u32 %r2,[%p4];
    ld.global.cg.u32 %r3,[%p5];
    mov.b32 {%h0,%h1},%r2;
    mov.b32 {%h2,%h3},%r3;
    cvt.rn.f16x2.e4m3x2 %r4,%h0;
    cvt.rn.f16x2.e4m3x2 %r5,%h1;
    cvt.rn.f16x2.e4m3x2 %r6,%h2;
    cvt.rn.f16x2.e4m3x2 %r7,%h3;
    mov.b32 {%h4,%h5},%r4;
    mov.b32 {%h6,%h7},%r5;
    mov.b32 {%h8,%h9},%r6;
    mov.b32 {%h10,%h11},%r7;
    cvt.f32.f16 %g0,%h4;
    cvt.f32.f16 %g1,%h5;
    cvt.f32.f16 %g2,%h6;
    cvt.f32.f16 %g3,%h7;
    cvt.f32.f16 %v0,%h8;
    cvt.f32.f16 %v1,%h9;
    cvt.f32.f16 %v2,%h10;
    cvt.f32.f16 %v3,%h11;

    // Form 1 + exp(-gate) with the base-two exponential.
    mul.f32 %a0,%g0,0fBFB8AA3B;
    mul.f32 %a1,%g1,0fBFB8AA3B;
    mul.f32 %a2,%g2,0fBFB8AA3B;
    mul.f32 %a3,%g3,0fBFB8AA3B;
    ex2.approx.f32 %a0,%a0;
    ex2.approx.f32 %a1,%a1;
    ex2.approx.f32 %a2,%a2;
    ex2.approx.f32 %a3,%a3;
    add.f32 %a0,%a0,0f3F800000;
    add.f32 %a1,%a1,0f3F800000;
    add.f32 %a2,%a2,0f3F800000;
    add.f32 %a3,%a3,0f3F800000;

    // Divide the gate first, then multiply by the value.
    rcp.approx.f32 %a0,%a0;
    rcp.approx.f32 %a1,%a1;
    rcp.approx.f32 %a2,%a2;
    rcp.approx.f32 %a3,%a3;
    mul.f32 %g0,%g0,%a0;
    mul.f32 %g1,%g1,%a1;
    mul.f32 %g2,%g2,%a2;
    mul.f32 %g3,%g3,%a3;
    mul.f32 %g0,%g0,%v0;
    mul.f32 %g1,%g1,%v1;
    mul.f32 %g2,%g2,%v2;
    mul.f32 %g3,%g3,%v3;

    // Round to FP16 and store the full tile with no boundary mask.
    cvt.rn.f16x2.f32 %r8,%g1,%g0;
    cvt.rn.f16x2.f32 %r9,%g3,%g2;
    st.global.v2.b32 [%p6],{%r8,%r9};
    ret;
}
