.version 8.7
.target sm_89
.address_size 64

.extern .shared .align 16 .b8 global_smem[];

.visible .entry kernel(
    .param .u64 x_ptr,
    .param .u64 output_ptr,
    .param .u64 dummy_ptr1,
    .param .u64 dummy_ptr2
)
{
    .reg .b32 %t, %b, %i, %raw, %hp0, %hp1, %out0, %out1;
    .reg .b64 %x, %y, %ix, %iy, %ax, %ay;
    .reg .b16 %q0, %q1, %h0, %h1, %h2, %h3;
    .reg .f32 %f0, %f1, %f2, %f3;

    // Index four-element groups: 512 threads cover each 2048-element tile.
    ld.param.u64 %x, [x_ptr];
    ld.param.u64 %y, [output_ptr];
    mov.u32 %t, %tid.x;
    mov.u32 %b, %ctaid.x;
    mad.lo.u32 %i, %b, 512, %t;
    mul.wide.u32 %ix, %i, 4;
    mul.wide.u32 %iy, %i, 8;
    add.u64 %ax, %x, %ix;
    add.u64 %ay, %y, %iy;

    // Load four FP8 values without L1 allocation and convert the pairs exactly.
    ld.global.cg.b32 %raw, [%ax];
    mov.b32 {%q0, %q1}, %raw;
    cvt.rn.f16x2.e4m3x2 %hp0, %q0;
    cvt.rn.f16x2.e4m3x2 %hp1, %q1;
    mov.b32 {%h0, %h1}, %hp0;
    mov.b32 {%h2, %h3}, %hp1;
    cvt.f32.f16 %f0, %h0;
    cvt.f32.f16 %f1, %h1;
    cvt.f32.f16 %f2, %h2;
    cvt.f32.f16 %f3, %h3;

    // Evaluate sigmoid in float; float subnormals cannot affect half rounding.
    mul.f32 %f0, %f0, 0fBFB8AA3B;
    mul.f32 %f1, %f1, 0fBFB8AA3B;
    mul.f32 %f2, %f2, 0fBFB8AA3B;
    mul.f32 %f3, %f3, 0fBFB8AA3B;
    ex2.approx.ftz.f32 %f0, %f0;
    ex2.approx.ftz.f32 %f1, %f1;
    ex2.approx.ftz.f32 %f2, %f2;
    ex2.approx.ftz.f32 %f3, %f3;
    add.f32 %f0, %f0, 0f3F800000;
    add.f32 %f1, %f1, 0f3F800000;
    add.f32 %f2, %f2, 0f3F800000;
    add.f32 %f3, %f3, 0f3F800000;
    rcp.approx.ftz.f32 %f0, %f0;
    rcp.approx.ftz.f32 %f1, %f1;
    rcp.approx.ftz.f32 %f2, %f2;
    rcp.approx.ftz.f32 %f3, %f3;

    // Round to half and issue one aligned, coalesced 64-bit output store.
    cvt.rn.f16x2.f32 %out0, %f1, %f0;
    cvt.rn.f16x2.f32 %out1, %f3, %f2;
    st.global.v2.b32 [%ay], {%out0, %out1};
    ret;
}
