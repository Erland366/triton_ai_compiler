  "candidate": {
    "ptx": ".version 8.7\n.target sm_89\n.address_size 64\n\n.extern .shared .align 16 .b8 global_smem[];\n\n.visible .entry kernel(\n    .param .u64 x_ptr,\n    .param .u64 output_ptr,\n    .param .u64 dummy_ptr1,\n    .param .u64 dummy_ptr2\n)\n{\n    .reg .b32 %t, %b, %i, %raw, %hp0, %hp1, %out0, %out1;\n    .reg .b64 %x, %y, %ix, %iy, %ax, %ay;\n    .reg .b16 %q0, %q1, %h0, %h1, %h2, %h3;\n    .reg .f32 %f0, %f1, %f2, %f3;\n\n    // Index four-element groups: 512 threads cover each 2048-element tile.\n    ld.param.u64 %x, [x_ptr];\n    ld.param.u64 %y, [output_ptr];\n    mov.u32 %t, %tid.x;\n    mov.u32 %b, %ctaid.x;\n    mad.lo.u32 %i, %b, 512, %t;\n    mul.wide.u32 %ix, %i, 4;\n    mul.wide.u32 %iy, %i, 8;\n    add.u64 %ax, %x, %ix;\n    add.u64 %ay, %y, %iy;\n\n    // Load four FP8 values without L1 allocation and convert the pairs exactly.\n    ld.global.cg.b32 %raw, [%ax];\n    mov.b32 {%q0, %q1}, %raw;\n    cvt.rn.f16x2.e4m3x2 %hp0, %q0;\n    cvt.rn.f16x2.e4m3x2 %hp1, %q1;\n    mov.b32 {%h0, %h1}, %hp0;\n    mov.b32 {%h2, %h3}, %hp1;\n    cvt.f32.f16 %f0, %h0;\n    cvt.f32.f16 %f1, %h1;\n    cvt.f32.f16 %f2, %h2;\n    cvt.f32.f16 %f3, %h3;\n\n    // Evaluate sigmoid in float; float subnormals cannot affect half rounding.\n    mul.f32 %f0, %f0, 0fBFB8AA3B;\n    mul.f32 %f1, %f1, 0fBFB8AA3B;\n    mul.f32 %f2, %f2, 0fBFB8AA3B;\n    mul.f32 %f3, %f3, 0fBFB8AA3B;\n    ex2.approx.ftz.f32 %f0, %f0;\n    ex2.approx.ftz.f32 %f1, %f1;\n    ex2.approx.ftz.f32 %f2, %f2;\n    ex2.approx.ftz.f32 %f3, %f3;\n    add.f32 %f0, %f0, 0f3F800000;\n    add.f32 %f1, %f1, 0f3F800000;\n    add.f32 %f2, %f2, 0f3F800000;\n    add.f32 %f3, %f3, 0f3F800000;\n    rcp.approx.ftz.f32 %f0, %f0;\n    rcp.approx.ftz.f32 %f1, %f1;\n    rcp.approx.ftz.f32 %f2, %f2;\n    rcp.approx.ftz.f32 %f3, %f3;\n\n    // Round to half and issue one aligned, coalesced 64-bit output store.\n    cvt.rn.f16x2.f32 %out0, %f1, %f0;\n    cvt.rn.f16x2.f32 %out1, %f3, %f2;\n    st.global.v2.b32 [%ay], {%out0, %out1};\n    ret;\n}\n",
