.version 8.7
.target sm_89
.address_size 64

.extern .shared .align 16 .b8 global_smem[];

.visible .entry kernel(
    .param .u64 x_ptr,
    .param .u64 weight_ptr,
    .param .u64 output_ptr,
    .param .u64 dummy_ptr1,
    .param .u64 dummy_ptr2
)
{
.reg .pred %p<8>;
.reg .b32 %r<96>, %a<4>, %b<8>, %v<8>;
.reg .b64 %rd<20>;
.reg .f32 %c<128>;

// Four warps cover the complete 128-channel by 128-pixel output tile.
ld.param.u64 %rd0, [x_ptr];
ld.param.u64 %rd1, [weight_ptr];
ld.param.u64 %rd2, [output_ptr];
mov.u32 %r0, %tid.x;
and.b32 %r1, %r0, 31;
shr.u32 %r2, %r0, 5;
shr.u32 %r3, %r1, 2;
and.b32 %r4, %r1, 3;
shl.b32 %r5, %r4, 2;
mov.u32 %r6, %ctaid.x;
shl.b32 %r6, %r6, 7;
mov.u32 %r7, %ctaid.y;
shl.b32 %r7, %r7, 7;
mov.u32 %r8, global_smem;
rem.u32 %r9, %r2, 4;
mul.lo.u32 %r9, %r9, 32;
div.u32 %r10, %r2, 4;
mul.lo.u32 %r10, %r10, 128;

// A 400-byte per-channel window covers the convolution halo and batch crossings.
div.u32 %r20, %r6, 2916;
rem.u32 %r21, %r6, 2916;
div.u32 %r22, %r21, 54;
rem.u32 %r23, %r21, 54;
mad.lo.u32 %r24, %r22, 56, %r23;
and.b32 %r24, %r24, 0xfffffff0;
sub.u32 %r50, 3136, %r24;
mad.lo.u32 %r48, %r20, 200704, %r24;
add.u32 %r21, %r20, 1;
mul.lo.u32 %r49, %r21, 200704;
sub.u32 %r49, %r49, %r50;
mad.lo.u32 %r51, %r20, 3136, %r24;
add.u32 %r11, %r6, %r9;
add.u32 %r11, %r11, %r3;

// Compute shared spatial addresses in the concatenated per-channel images.
add.u32 %r20, %r11, 0;
div.u32 %r21, %r20, 2916;
rem.u32 %r22, %r20, 2916;
div.u32 %r23, %r22, 54;
rem.u32 %r24, %r22, 54;
mad.lo.u32 %r25, %r23, 56, %r24;
mad.lo.u32 %r25, %r21, 3136, %r25;
sub.u32 %r25, %r25, %r51;
add.u32 %r60, %r25, %r8;
add.u32 %r20, %r11, 8;
div.u32 %r21, %r20, 2916;
rem.u32 %r22, %r20, 2916;
div.u32 %r23, %r22, 54;
rem.u32 %r24, %r22, 54;
mad.lo.u32 %r25, %r23, 56, %r24;
mad.lo.u32 %r25, %r21, 3136, %r25;
sub.u32 %r25, %r25, %r51;
add.u32 %r61, %r25, %r8;
add.u32 %r20, %r11, 16;
div.u32 %r21, %r20, 2916;
rem.u32 %r22, %r20, 2916;
div.u32 %r23, %r22, 54;
rem.u32 %r24, %r22, 54;
mad.lo.u32 %r25, %r23, 56, %r24;
mad.lo.u32 %r25, %r21, 3136, %r25;
sub.u32 %r25, %r25, %r51;
add.u32 %r62, %r25, %r8;
add.u32 %r20, %r11, 24;
div.u32 %r21, %r20, 2916;
rem.u32 %r22, %r20, 2916;
div.u32 %r23, %r22, 54;
rem.u32 %r24, %r22, 54;
mad.lo.u32 %r25, %r23, 56, %r24;
mad.lo.u32 %r25, %r21, 3136, %r25;
sub.u32 %r25, %r25, %r51;
add.u32 %r63, %r25, %r8;

// Shared layout: input [0,6400), weights [6400,22784), lookup [22784,23936).
// The lookup maps all 576 K indices into a circular sixteen-channel input cache.
add.u32 %r57, %r8, 22784;
mov.u32 %r26, %r0;
LUT_INIT:
div.u32 %r21, %r26, 9;
rem.u32 %r22, %r26, 9;
div.u32 %r23, %r22, 3;
rem.u32 %r24, %r22, 3;
mad.lo.u32 %r25, %r23, 56, %r24;
and.b32 %r21, %r21, 15;
mad.lo.u32 %r25, %r21, 400, %r25;
mad.lo.u32 %r27, %r26, 2, %r57;
st.shared.u16 [%r27], %r25;
add.u32 %r26, %r26, 128;
setp.lt.u32 %p3, %r26, 576;
@%p3 bra LUT_INIT;

// Swizzle 16-byte weight vectors and initialize a four-stage L1-cached pipeline.
shr.u32 %r12, %r0, 1;
and.b32 %r13, %r0, 1;
shl.b32 %r13, %r13, 4;
and.b32 %r14, %r12, 4;
shl.b32 %r14, %r14, 2;
xor.b32 %r14, %r14, %r13;
mad.lo.u32 %r15, %r12, 32, %r14;
add.u32 %r15, %r15, %r8;
add.u32 %r15, %r15, 6400;
add.u32 %r12, %r12, %r7;
mad.lo.u32 %r16, %r12, 576, %r13;
cvt.u64.u32 %rd3, %r16;
add.u64 %rd6, %rd1, %rd3;
add.u64 %rd7, %rd6, 36864;
and.b32 %r12, %r1, 15;
add.u32 %r12, %r12, %r10;
and.b32 %r13, %r1, 16;
and.b32 %r14, %r12, 4;
shl.b32 %r14, %r14, 2;
xor.b32 %r14, %r14, %r13;
mad.lo.u32 %r17, %r12, 32, %r14;
add.u32 %r17, %r17, %r8;
add.u32 %r17, %r17, 6400;
mov.u32 %r18, 0;
mov.u32 %r19, 0;
add.u32 %r20, %r15, 0;
add.u32 %r21, %r20, 2048;
add.u64 %rd3, %rd6, 0;
add.u64 %rd4, %rd7, 0;
cp.async.ca.shared.global [%r20], [%rd3], 16;
cp.async.ca.shared.global [%r21], [%rd4], 16;
cp.async.commit_group;
add.u32 %r20, %r15, 4096;
add.u32 %r21, %r20, 2048;
add.u64 %rd3, %rd6, 32;
add.u64 %rd4, %rd7, 32;
cp.async.ca.shared.global [%r20], [%rd3], 16;
cp.async.ca.shared.global [%r21], [%rd4], 16;
cp.async.commit_group;
add.u32 %r20, %r15, 8192;
add.u32 %r21, %r20, 2048;
add.u64 %rd3, %rd6, 64;
add.u64 %rd4, %rd7, 64;
cp.async.ca.shared.global [%r20], [%rd3], 16;
cp.async.ca.shared.global [%r21], [%rd4], 16;
cp.async.commit_group;
add.u64 %rd6, %rd6, 64;
add.u64 %rd7, %rd7, 64;
mov.u32 %r54, 12288;
mov.u32 %r52, 0;
mov.u32 %r53, 0;

// Retain FP32 accumulators for the complete ordered K reduction.
mov.f32 %c0, 0f00000000; mov.f32 %c1, 0f00000000; mov.f32 %c2, 0f00000000; mov.f32 %c3, 0f00000000;
mov.f32 %c4, 0f00000000; mov.f32 %c5, 0f00000000; mov.f32 %c6, 0f00000000; mov.f32 %c7, 0f00000000;
mov.f32 %c8, 0f00000000; mov.f32 %c9, 0f00000000; mov.f32 %c10, 0f00000000; mov.f32 %c11, 0f00000000;
mov.f32 %c12, 0f00000000; mov.f32 %c13, 0f00000000; mov.f32 %c14, 0f00000000; mov.f32 %c15, 0f00000000;
mov.f32 %c16, 0f00000000; mov.f32 %c17, 0f00000000; mov.f32 %c18, 0f00000000; mov.f32 %c19, 0f00000000;
mov.f32 %c20, 0f00000000; mov.f32 %c21, 0f00000000; mov.f32 %c22, 0f00000000; mov.f32 %c23, 0f00000000;
mov.f32 %c24, 0f00000000; mov.f32 %c25, 0f00000000; mov.f32 %c26, 0f00000000; mov.f32 %c27, 0f00000000;
mov.f32 %c28, 0f00000000; mov.f32 %c29, 0f00000000; mov.f32 %c30, 0f00000000; mov.f32 %c31, 0f00000000;
mov.f32 %c32, 0f00000000; mov.f32 %c33, 0f00000000; mov.f32 %c34, 0f00000000; mov.f32 %c35, 0f00000000;
mov.f32 %c36, 0f00000000; mov.f32 %c37, 0f00000000; mov.f32 %c38, 0f00000000; mov.f32 %c39, 0f00000000;
mov.f32 %c40, 0f00000000; mov.f32 %c41, 0f00000000; mov.f32 %c42, 0f00000000; mov.f32 %c43, 0f00000000;
mov.f32 %c44, 0f00000000; mov.f32 %c45, 0f00000000; mov.f32 %c46, 0f00000000; mov.f32 %c47, 0f00000000;
mov.f32 %c48, 0f00000000; mov.f32 %c49, 0f00000000; mov.f32 %c50, 0f00000000; mov.f32 %c51, 0f00000000;
mov.f32 %c52, 0f00000000; mov.f32 %c53, 0f00000000; mov.f32 %c54, 0f00000000; mov.f32 %c55, 0f00000000;
mov.f32 %c56, 0f00000000; mov.f32 %c57, 0f00000000; mov.f32 %c58, 0f00000000; mov.f32 %c59, 0f00000000;
mov.f32 %c60, 0f00000000; mov.f32 %c61, 0f00000000; mov.f32 %c62, 0f00000000; mov.f32 %c63, 0f00000000;
mov.f32 %c64, 0f00000000; mov.f32 %c65, 0f00000000; mov.f32 %c66, 0f00000000; mov.f32 %c67, 0f00000000;
mov.f32 %c68, 0f00000000; mov.f32 %c69, 0f00000000; mov.f32 %c70, 0f00000000; mov.f32 %c71, 0f00000000;
mov.f32 %c72, 0f00000000; mov.f32 %c73, 0f00000000; mov.f32 %c74, 0f00000000; mov.f32 %c75, 0f00000000;
mov.f32 %c76, 0f00000000; mov.f32 %c77, 0f00000000; mov.f32 %c78, 0f00000000; mov.f32 %c79, 0f00000000;
mov.f32 %c80, 0f00000000; mov.f32 %c81, 0f00000000; mov.f32 %c82, 0f00000000; mov.f32 %c83, 0f00000000;
mov.f32 %c84, 0f00000000; mov.f32 %c85, 0f00000000; mov.f32 %c86, 0f00000000; mov.f32 %c87, 0f00000000;
mov.f32 %c88, 0f00000000; mov.f32 %c89, 0f00000000; mov.f32 %c90, 0f00000000; mov.f32 %c91, 0f00000000;
mov.f32 %c92, 0f00000000; mov.f32 %c93, 0f00000000; mov.f32 %c94, 0f00000000; mov.f32 %c95, 0f00000000;
mov.f32 %c96, 0f00000000; mov.f32 %c97, 0f00000000; mov.f32 %c98, 0f00000000; mov.f32 %c99, 0f00000000;
mov.f32 %c100, 0f00000000; mov.f32 %c101, 0f00000000; mov.f32 %c102, 0f00000000; mov.f32 %c103, 0f00000000;
mov.f32 %c104, 0f00000000; mov.f32 %c105, 0f00000000; mov.f32 %c106, 0f00000000; mov.f32 %c107, 0f00000000;
mov.f32 %c108, 0f00000000; mov.f32 %c109, 0f00000000; mov.f32 %c110, 0f00000000; mov.f32 %c111, 0f00000000;
mov.f32 %c112, 0f00000000; mov.f32 %c113, 0f00000000; mov.f32 %c114, 0f00000000; mov.f32 %c115, 0f00000000;
mov.f32 %c116, 0f00000000; mov.f32 %c117, 0f00000000; mov.f32 %c118, 0f00000000; mov.f32 %c119, 0f00000000;
mov.f32 %c120, 0f00000000; mov.f32 %c121, 0f00000000; mov.f32 %c122, 0f00000000; mov.f32 %c123, 0f00000000;
mov.f32 %c124, 0f00000000; mov.f32 %c125, 0f00000000; mov.f32 %c126, 0f00000000; mov.f32 %c127, 0f00000000;

// Fill the initial sixteen-channel input cache.
mov.u32 %r26, %r0;
RAW_COPY:
div.u32 %r27, %r26, 25;
rem.u32 %r28, %r26, 25;
shl.b32 %r28, %r28, 4;
setp.lt.u32 %p2, %r28, %r50;
selp.u32 %r29, %r48, %r49, %p2;
mad.lo.u32 %r29, %r27, 3136, %r29;
add.u32 %r29, %r29, %r28;
setp.ge.u32 %p3, %r29, 6422528;
add.u32 %r30, %r27, %r52;
setp.ge.u32 %p4, %r30, 64;
or.pred %p3, %p3, %p4;
cvt.u64.u32 %rd3, %r29;
add.u64 %rd3, %rd0, %rd3;
shl.b32 %r31, %r26, 4;
add.u32 %r31, %r31, %r8;
// Zero-fill any unused prefetch beyond the end of the allocation.
cp.async.cg.shared.global [%r31], [%rd3], 16, %p3;
add.u32 %r26, %r26, 128;
setp.lt.u32 %p3, %r26, 400;
@%p3 bra RAW_COPY;
cp.async.commit_group;
cp.async.wait_group 0;
mad.lo.u32 %r56, %r5, 2, %r57;

// Each thread prepares one aligned vector for later circular-cache refills.
div.u32 %r53, %r0, 25;
rem.u32 %r55, %r0, 25;
shl.b32 %r55, %r55, 4;
setp.lt.u32 %p2, %r55, %r50;
selp.u32 %r48, %r48, %r49, %p2;
add.u32 %r48, %r48, %r55;
mov.u32 %r52, 0;
K_LOOP:
// Complete the current stage while later stages remain in flight.
cp.async.wait_group 2;
bar.sync 0;
setp.lt.u32 %p0, %r19, 480;
add.u32 %r21, %r15, %r54;
add.u32 %r22, %r21, 2048;
add.u64 %rd6, %rd6, 32;
add.u64 %rd7, %rd7, 32;
@%p0 cp.async.ca.shared.global [%r21], [%rd6], 16;
@%p0 cp.async.ca.shared.global [%r22], [%rd7], 16;

// Refill only fully consumed channel slots, sixteen channels ahead.
// The block barrier above protects all input slots reused from the preceding step.
div.u32 %r20, %r19, 9;
sub.u32 %r21, %r20, %r52;
setp.lt.u32 %p4, %r53, %r21;
add.u32 %r22, %r52, %r53;
add.u32 %r23, %r22, 16;
setp.lt.u32 %p5, %r23, 64;
and.pred %p4, %p4, %p5;
and.b32 %r22, %r22, 15;
mad.lo.u32 %r22, %r22, 400, %r55;
add.u32 %r22, %r22, %r8;
mad.lo.u32 %r23, %r23, 3136, %r48;
setp.ge.u32 %p3, %r23, 6422528;
cvt.u64.u32 %rd3, %r23;
add.u64 %rd3, %rd0, %rd3;
@%p4 cp.async.cg.shared.global [%r22], [%rd3], 16, %p3;
mov.u32 %r52, %r20;
cp.async.commit_group;

// Decode the eight K offsets needed by each tensor-core B fragment.
ld.shared.u16 %v0, [%r56+0];
ld.shared.u16 %v1, [%r56+2];
ld.shared.u16 %v2, [%r56+4];
ld.shared.u16 %v3, [%r56+6];
ld.shared.u16 %v4, [%r56+32];
ld.shared.u16 %v5, [%r56+34];
ld.shared.u16 %v6, [%r56+36];
ld.shared.u16 %v7, [%r56+38];

// Gather and pack the implicit-im2col operand entirely from shared memory.
add.u32 %r20, %r60, %v0; ld.shared.u8 %r30, [%r20];
add.u32 %r20, %r60, %v1; ld.shared.u8 %r31, [%r20];
add.u32 %r20, %r60, %v2; ld.shared.u8 %r32, [%r20];
add.u32 %r20, %r60, %v3; ld.shared.u8 %r33, [%r20];
prmt.b32 %r34, %r30, %r31, 0x0040; prmt.b32 %r35, %r32, %r33, 0x0040; prmt.b32 %b0, %r34, %r35, 0x5410;
add.u32 %r20, %r60, %v4; ld.shared.u8 %r30, [%r20];
add.u32 %r20, %r60, %v5; ld.shared.u8 %r31, [%r20];
add.u32 %r20, %r60, %v6; ld.shared.u8 %r32, [%r20];
add.u32 %r20, %r60, %v7; ld.shared.u8 %r33, [%r20];
prmt.b32 %r34, %r30, %r31, 0x0040; prmt.b32 %r35, %r32, %r33, 0x0040; prmt.b32 %b1, %r34, %r35, 0x5410;
add.u32 %r20, %r61, %v0; ld.shared.u8 %r30, [%r20];
add.u32 %r20, %r61, %v1; ld.shared.u8 %r31, [%r20];
add.u32 %r20, %r61, %v2; ld.shared.u8 %r32, [%r20];
add.u32 %r20, %r61, %v3; ld.shared.u8 %r33, [%r20];
prmt.b32 %r34, %r30, %r31, 0x0040; prmt.b32 %r35, %r32, %r33, 0x0040; prmt.b32 %b2, %r34, %r35, 0x5410;
add.u32 %r20, %r61, %v4; ld.shared.u8 %r30, [%r20];
add.u32 %r20, %r61, %v5; ld.shared.u8 %r31, [%r20];
add.u32 %r20, %r61, %v6; ld.shared.u8 %r32, [%r20];
add.u32 %r20, %r61, %v7; ld.shared.u8 %r33, [%r20];
prmt.b32 %r34, %r30, %r31, 0x0040; prmt.b32 %r35, %r32, %r33, 0x0040; prmt.b32 %b3, %r34, %r35, 0x5410;
add.u32 %r20, %r62, %v0; ld.shared.u8 %r30, [%r20];
add.u32 %r20, %r62, %v1; ld.shared.u8 %r31, [%r20];
add.u32 %r20, %r62, %v2; ld.shared.u8 %r32, [%r20];
add.u32 %r20, %r62, %v3; ld.shared.u8 %r33, [%r20];
prmt.b32 %r34, %r30, %r31, 0x0040; prmt.b32 %r35, %r32, %r33, 0x0040; prmt.b32 %b4, %r34, %r35, 0x5410;
add.u32 %r20, %r62, %v4; ld.shared.u8 %r30, [%r20];
add.u32 %r20, %r62, %v5; ld.shared.u8 %r31, [%r20];
add.u32 %r20, %r62, %v6; ld.shared.u8 %r32, [%r20];
add.u32 %r20, %r62, %v7; ld.shared.u8 %r33, [%r20];
prmt.b32 %r34, %r30, %r31, 0x0040; prmt.b32 %r35, %r32, %r33, 0x0040; prmt.b32 %b5, %r34, %r35, 0x5410;
add.u32 %r20, %r63, %v0; ld.shared.u8 %r30, [%r20];
add.u32 %r20, %r63, %v1; ld.shared.u8 %r31, [%r20];
add.u32 %r20, %r63, %v2; ld.shared.u8 %r32, [%r20];
add.u32 %r20, %r63, %v3; ld.shared.u8 %r33, [%r20];
prmt.b32 %r34, %r30, %r31, 0x0040; prmt.b32 %r35, %r32, %r33, 0x0040; prmt.b32 %b6, %r34, %r35, 0x5410;
add.u32 %r20, %r63, %v4; ld.shared.u8 %r30, [%r20];
add.u32 %r20, %r63, %v5; ld.shared.u8 %r31, [%r20];
add.u32 %r20, %r63, %v6; ld.shared.u8 %r32, [%r20];
add.u32 %r20, %r63, %v7; ld.shared.u8 %r33, [%r20];
prmt.b32 %r34, %r30, %r31, 0x0040; prmt.b32 %r35, %r32, %r33, 0x0040; prmt.b32 %b7, %r34, %r35, 0x5410;

// Reuse B across eight output-channel subtiles, using native FP8 tensor cores.
add.u32 %r20, %r17, %r18;
add.u32 %r21, %r20, 0;
ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a0, %a1, %a2, %a3}, [%r21];
mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32 {%c0, %c1, %c2, %c3}, {%a0, %a1, %a2, %a3}, {%b0, %b1}, {%c0, %c1, %c2, %c3};
mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32 {%c4, %c5, %c6, %c7}, {%a0, %a1, %a2, %a3}, {%b2, %b3}, {%c4, %c5, %c6, %c7};
mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32 {%c8, %c9, %c10, %c11}, {%a0, %a1, %a2, %a3}, {%b4, %b5}, {%c8, %c9, %c10, %c11};
mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32 {%c12, %c13, %c14, %c15}, {%a0, %a1, %a2, %a3}, {%b6, %b7}, {%c12, %c13, %c14, %c15};
add.u32 %r21, %r20, 512;
ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a0, %a1, %a2, %a3}, [%r21];
mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32 {%c16, %c17, %c18, %c19}, {%a0, %a1, %a2, %a3}, {%b0, %b1}, {%c16, %c17, %c18, %c19};
mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32 {%c20, %c21, %c22, %c23}, {%a0, %a1, %a2, %a3}, {%b2, %b3}, {%c20, %c21, %c22, %c23};
mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32 {%c24, %c25, %c26, %c27}, {%a0, %a1, %a2, %a3}, {%b4, %b5}, {%c24, %c25, %c26, %c27};
mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32 {%c28, %c29, %c30, %c31}, {%a0, %a1, %a2, %a3}, {%b6, %b7}, {%c28, %c29, %c30, %c31};
