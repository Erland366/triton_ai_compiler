  "candidate": {
    "ptx": ".version 8.7\n.target sm_89\n.address_size 64\n\n.extern .shared .align 16 .b8 global_smem[];\n\n.visible .entry kernel(\n    .param .u64 x_ptr,\n    .param .u64 output_ptr,\n    .param .u64 dummy_ptr1,\n    .param .u64 dummy_ptr2\n)\n{\n    .reg .pred %p<2>;\n    .reg .b32 %r<10>;\n    .reg .b64 %rd<4>;\n    .reg .f32 %f<6>;\n\n    // The first warp loads 16 bytes per lane, covering the entire tile.\n    mov.u32 %r0, %tid.x;\n    setp.ge.u32 %p0, %r0, 32;\n    @%p0 bra DONE;\n    ld.param.u64 %rd0, [x_ptr];\n    ld.param.u64 %rd1, [output_ptr];\n    mov.u32 %r1, %ctaid.x;\n    mov.u32 %r2, %ctaid.y;\n    mad.lo.u32 %r3, %r2, 8, %r1;\n    mad.lo.u32 %r3, %r3, 32, %r0;\n    mad.wide.u32 %rd2, %r3, 16, %rd0;\n\n    // Coalesced vector loads supply packed E4M3 tensor-core operands.\n    ld.global.cg.v4.u32 {%r4, %r5, %r6, %r7}, [%rd2];\n    mov.b32 %r8, 0x38383838;\n    mov.f32 %f4, 0f00000000;\n\n    // Prepare the row output address while the input load completes.\n    mad.wide.u32 %rd3, %r2, 4, %rd1;\n    setp.eq.u32 %p1, %r0, 0;\n\n    // FP8 multiplication by one computes sixteen FP32 row sums.\n    mma.sync.aligned.m16n8k32.row.col.f32.e4m3.e4m3.f32 {%f0, %f1, %f2, %f3}, {%r4, %r5, %r6, %r7}, {%r8, %r8}, {%f4, %f4, %f4, %f4};\n\n    // Ignore duplicate columns and reduce the sixteen distinct rows.\n    add.f32 %f0, %f0, %f2;\n    shfl.sync.bfly.b32 %f5, %f0, 16, 31, -1;\n    add.f32 %f0, %f0, %f5;\n    shfl.sync.bfly.b32 %f5, %f0, 8, 31, -1;\n    add.f32 %f0, %f0, %f5;\n    shfl.sync.bfly.b32 %f5, %f0, 4, 31, -1;\n    add.f32 %f0, %f0, %f5;\n\n    // Only lane zero atomically contributes this program's tile sum.\n    @%p1 red.relaxed.gpu.global.add.f32 [%rd3], %f0;\nDONE:\n    ret;\n}\n",
