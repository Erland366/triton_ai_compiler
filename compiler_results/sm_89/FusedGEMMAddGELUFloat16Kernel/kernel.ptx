.version 8.7
.target sm_89
.address_size 64

.visible .entry kernel(
    .param .u64 a_ptr,
    .param .u64 b_ptr,
    .param .u64 d_ptr,
    .param .u64 c_ptr,
    .param .u64 dummy_ptr1,
    .param .u64 dummy_ptr2
)
{
    .shared .align 1024 .b8 smem[49152];
    .reg .b32 %r<40>, %a<32>, %b<32>, %h<2>;
    .reg .b64 %g<12>;
    .reg .f32 %f<128>, %v<4>, %x<4>, %t<4>, %p<4>, %y<4>;
    .reg .b16 %dh<4>;
    .reg .pred %q<6>;

    // Map the launch to the fixed 32 by 16 output-tile grid; reject excess CTAs.
    ld.param.u64 %g0, [a_ptr];
    ld.param.u64 %g1, [b_ptr];
    ld.param.u64 %g2, [d_ptr];
    ld.param.u64 %g3, [c_ptr];
    mov.u32 %r0, %tid.x;
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ctaid.y;
    mov.u32 %r30, %nctaid.x;
    mad.lo.u32 %r1, %r2, %r30, %r1;
    setp.ge.u32 %q5, %r1, 512;
    @%q5 ret;
    shr.u32 %r2, %r1, 5;
    and.b32 %r1, %r1, 31;
    and.b32 %r3, %r0, 31;
    shr.u32 %r4, %r0, 5;
    shr.u32 %r5, %r4, 2;
    shl.b32 %r5, %r5, 6;
    and.b32 %r6, %r4, 3;
    shl.b32 %r6, %r6, 6;
    mov.u32 %r7, smem;
    shl.b32 %r8, %r1, 20;
    cvt.u64.u32 %g4, %r8;
    add.u64 %g0, %g0, %g4;
    shl.b32 %r9, %r2, 9;
    cvt.u64.u32 %g4, %r9;
    add.u64 %g1, %g1, %g4;

    // Assign aligned 16-byte copies and swizzle shared rows to avoid bank conflicts.
    shr.u32 %r10, %r0, 2;
    and.b32 %r11, %r0, 3;
    shl.b32 %r11, %r11, 4;
    shl.b32 %r12, %r10, 13;
    add.u32 %r12, %r12, %r11;
    cvt.u64.u32 %g4, %r12;
    add.u64 %g0, %g0, %g4;
    shl.b32 %r12, %r10, 6;
    add.u32 %r12, %r12, %r11;
    and.b32 %r13, %r10, 6;
    shl.b32 %r13, %r13, 3;
    xor.b32 %r12, %r12, %r13;
    add.u32 %r12, %r12, %r7;
    shr.u32 %r10, %r0, 5;
    and.b32 %r11, %r0, 31;
    shl.b32 %r11, %r11, 4;
    shl.b32 %r13, %r10, 13;
    add.u32 %r13, %r13, %r11;
    cvt.u64.u32 %g4, %r13;
    add.u64 %g1, %g1, %g4;
    shl.b32 %r13, %r10, 9;
    add.u32 %r13, %r13, %r11;
    shl.b32 %r14, %r10, 4;
    xor.b32 %r13, %r13, %r14;
    add.u32 %r13, %r13, 8192;
    add.u32 %r13, %r13, %r7;

    // Build ldmatrix addresses for the eight 64 by 64 warp tiles.
    and.b32 %r10, %r3, 15;
    add.u32 %r14, %r10, %r5;
    shl.b32 %r14, %r14, 6;
    and.b32 %r11, %r3, 16;
    add.u32 %r14, %r14, %r11;
    and.b32 %r15, %r10, 6;
    shl.b32 %r15, %r15, 3;
    xor.b32 %r14, %r14, %r15;
    add.u32 %r14, %r14, %r7;
    shl.b32 %r15, %r10, 9;
    shl.b32 %r16, %r6, 1;
    add.u32 %r15, %r15, %r16;
    add.u32 %r15, %r15, %r11;
    and.b32 %r16, %r10, 7;
    shl.b32 %r16, %r16, 4;
    xor.b32 %r15, %r15, %r16;
    add.u32 %r15, %r15, 8192;
    add.u32 %r15, %r15, %r7;

    // Initialize all 128 FP32 accumulator elements owned by each thread.
    mov.f32 %f0, 0f00000000; mov.f32 %f1, 0f00000000; mov.f32 %f2, 0f00000000; mov.f32 %f3, 0f00000000;
    mov.f32 %f4, 0f00000000; mov.f32 %f5, 0f00000000; mov.f32 %f6, 0f00000000; mov.f32 %f7, 0f00000000;
    mov.f32 %f8, 0f00000000; mov.f32 %f9, 0f00000000; mov.f32 %f10, 0f00000000; mov.f32 %f11, 0f00000000;
    mov.f32 %f12, 0f00000000; mov.f32 %f13, 0f00000000; mov.f32 %f14, 0f00000000; mov.f32 %f15, 0f00000000;
    mov.f32 %f16, 0f00000000; mov.f32 %f17, 0f00000000; mov.f32 %f18, 0f00000000; mov.f32 %f19, 0f00000000;
    mov.f32 %f20, 0f00000000; mov.f32 %f21, 0f00000000; mov.f32 %f22, 0f00000000; mov.f32 %f23, 0f00000000;
    mov.f32 %f24, 0f00000000; mov.f32 %f25, 0f00000000; mov.f32 %f26, 0f00000000; mov.f32 %f27, 0f00000000;
    mov.f32 %f28, 0f00000000; mov.f32 %f29, 0f00000000; mov.f32 %f30, 0f00000000; mov.f32 %f31, 0f00000000;
    mov.f32 %f32, 0f00000000; mov.f32 %f33, 0f00000000; mov.f32 %f34, 0f00000000; mov.f32 %f35, 0f00000000;
    mov.f32 %f36, 0f00000000; mov.f32 %f37, 0f00000000; mov.f32 %f38, 0f00000000; mov.f32 %f39, 0f00000000;
    mov.f32 %f40, 0f00000000; mov.f32 %f41, 0f00000000; mov.f32 %f42, 0f00000000; mov.f32 %f43, 0f00000000;
    mov.f32 %f44, 0f00000000; mov.f32 %f45, 0f00000000; mov.f32 %f46, 0f00000000; mov.f32 %f47, 0f00000000;
    mov.f32 %f48, 0f00000000; mov.f32 %f49, 0f00000000; mov.f32 %f50, 0f00000000; mov.f32 %f51, 0f00000000;
    mov.f32 %f52, 0f00000000; mov.f32 %f53, 0f00000000; mov.f32 %f54, 0f00000000; mov.f32 %f55, 0f00000000;
    mov.f32 %f56, 0f00000000; mov.f32 %f57, 0f00000000; mov.f32 %f58, 0f00000000; mov.f32 %f59, 0f00000000;
    mov.f32 %f60, 0f00000000; mov.f32 %f61, 0f00000000; mov.f32 %f62, 0f00000000; mov.f32 %f63, 0f00000000;
    mov.f32 %f64, 0f00000000; mov.f32 %f65, 0f00000000; mov.f32 %f66, 0f00000000; mov.f32 %f67, 0f00000000;
    mov.f32 %f68, 0f00000000; mov.f32 %f69, 0f00000000; mov.f32 %f70, 0f00000000; mov.f32 %f71, 0f00000000;
    mov.f32 %f72, 0f00000000; mov.f32 %f73, 0f00000000; mov.f32 %f74, 0f00000000; mov.f32 %f75, 0f00000000;
    mov.f32 %f76, 0f00000000; mov.f32 %f77, 0f00000000; mov.f32 %f78, 0f00000000; mov.f32 %f79, 0f00000000;
    mov.f32 %f80, 0f00000000; mov.f32 %f81, 0f00000000; mov.f32 %f82, 0f00000000; mov.f32 %f83, 0f00000000;
    mov.f32 %f84, 0f00000000; mov.f32 %f85, 0f00000000; mov.f32 %f86, 0f00000000; mov.f32 %f87, 0f00000000;
    mov.f32 %f88, 0f00000000; mov.f32 %f89, 0f00000000; mov.f32 %f90, 0f00000000; mov.f32 %f91, 0f00000000;
    mov.f32 %f92, 0f00000000; mov.f32 %f93, 0f00000000; mov.f32 %f94, 0f00000000; mov.f32 %f95, 0f00000000;
    mov.f32 %f96, 0f00000000; mov.f32 %f97, 0f00000000; mov.f32 %f98, 0f00000000; mov.f32 %f99, 0f00000000;
    mov.f32 %f100, 0f00000000; mov.f32 %f101, 0f00000000; mov.f32 %f102, 0f00000000; mov.f32 %f103, 0f00000000;
    mov.f32 %f104, 0f00000000; mov.f32 %f105, 0f00000000; mov.f32 %f106, 0f00000000; mov.f32 %f107, 0f00000000;
    mov.f32 %f108, 0f00000000; mov.f32 %f109, 0f00000000; mov.f32 %f110, 0f00000000; mov.f32 %f111, 0f00000000;
    mov.f32 %f112, 0f00000000; mov.f32 %f113, 0f00000000; mov.f32 %f114, 0f00000000; mov.f32 %f115, 0f00000000;
    mov.f32 %f116, 0f00000000; mov.f32 %f117, 0f00000000; mov.f32 %f118, 0f00000000; mov.f32 %f119, 0f00000000;
    mov.f32 %f120, 0f00000000; mov.f32 %f121, 0f00000000; mov.f32 %f122, 0f00000000; mov.f32 %f123, 0f00000000;
    mov.f32 %f124, 0f00000000; mov.f32 %f125, 0f00000000; mov.f32 %f126, 0f00000000; mov.f32 %f127, 0f00000000;

    // Prime the first asynchronous shared-memory stage.
    cp.async.cg.shared.global [%r12], [%g0], 16;
    cp.async.cg.shared.global [%r12+4096], [%g0+524288], 16;
    cp.async.cg.shared.global [%r13], [%g1], 16;
    cp.async.cg.shared.global [%r13+4096], [%g1+65536], 16;
    cp.async.cg.shared.global [%r13+8192], [%g1+131072], 16;
    cp.async.cg.shared.global [%r13+12288], [%g1+196608], 16;
    cp.async.commit_group;

    // Prime a second tile, keeping its transfer in flight while the first tile starts.
    add.u64 %g0, %g0, 64;
    add.u64 %g1, %g1, 262144;
    add.u32 %r20, %r12, 24576;
    add.u32 %r21, %r13, 24576;
    cp.async.cg.shared.global [%r20], [%g0], 16;
    cp.async.cg.shared.global [%r20+4096], [%g0+524288], 16;
    cp.async.cg.shared.global [%r21], [%g1], 16;
    cp.async.cg.shared.global [%r21+4096], [%g1+65536], 16;
    cp.async.cg.shared.global [%r21+8192], [%g1+131072], 16;
    cp.async.cg.shared.global [%r21+12288], [%g1+196608], 16;
    cp.async.commit_group;
    cp.async.wait_group 1;
    bar.sync 0;
    mov.u32 %r17, 0;
    mov.u32 %r18, 2;
    add.u64 %g0, %g0, 64;
    add.u64 %g1, %g1, 262144;

    // Prime the first register fragment before entering the two-level pipeline.
    mov.u32 %r20, %r14;
    mov.u32 %r21, %r15;
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a0, %a1, %a2, %a3}, [%r20];
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a4, %a5, %a6, %a7}, [%r20+1024];
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a8, %a9, %a10, %a11}, [%r20+2048];
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a12, %a13, %a14, %a15}, [%r20+3072];
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b0, %b1, %b2, %b3}, [%r21];
    xor.b32 %r23, %r21, 32;
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b4, %b5, %b6, %b7}, [%r23];
    xor.b32 %r23, %r21, 64;
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b8, %b9, %b10, %b11}, [%r23];
    xor.b32 %r23, %r21, 96;
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b12, %b13, %b14, %b15}, [%r23];

K_LOOP:
    // Locate the second 16-wide K slice within the current shared tile.
    xor.b32 %r20, %r14, 32;
    add.u32 %r20, %r20, %r17;
    add.u32 %r21, %r15, %r17;
    add.u32 %r21, %r21, 8192;

    // Interleave shared prefetches with tensor-core work on the first K slice.
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a16, %a17, %a18, %a19}, [%r20];
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f0, %f1, %f2, %f3}, {%a0, %a1, %a2, %a3}, {%b0, %b1}, {%f0, %f1, %f2, %f3};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f4, %f5, %f6, %f7}, {%a0, %a1, %a2, %a3}, {%b2, %b3}, {%f4, %f5, %f6, %f7};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f8, %f9, %f10, %f11}, {%a0, %a1, %a2, %a3}, {%b4, %b5}, {%f8, %f9, %f10, %f11};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f12, %f13, %f14, %f15}, {%a0, %a1, %a2, %a3}, {%b6, %b7}, {%f12, %f13, %f14, %f15};
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a20, %a21, %a22, %a23}, [%r20+1024];
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f16, %f17, %f18, %f19}, {%a0, %a1, %a2, %a3}, {%b8, %b9}, {%f16, %f17, %f18, %f19};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f20, %f21, %f22, %f23}, {%a0, %a1, %a2, %a3}, {%b10, %b11}, {%f20, %f21, %f22, %f23};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f24, %f25, %f26, %f27}, {%a0, %a1, %a2, %a3}, {%b12, %b13}, {%f24, %f25, %f26, %f27};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f28, %f29, %f30, %f31}, {%a0, %a1, %a2, %a3}, {%b14, %b15}, {%f28, %f29, %f30, %f31};
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a24, %a25, %a26, %a27}, [%r20+2048];
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f32, %f33, %f34, %f35}, {%a4, %a5, %a6, %a7}, {%b0, %b1}, {%f32, %f33, %f34, %f35};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f36, %f37, %f38, %f39}, {%a4, %a5, %a6, %a7}, {%b2, %b3}, {%f36, %f37, %f38, %f39};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f40, %f41, %f42, %f43}, {%a4, %a5, %a6, %a7}, {%b4, %b5}, {%f40, %f41, %f42, %f43};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f44, %f45, %f46, %f47}, {%a4, %a5, %a6, %a7}, {%b6, %b7}, {%f44, %f45, %f46, %f47};
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a28, %a29, %a30, %a31}, [%r20+3072];
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f48, %f49, %f50, %f51}, {%a4, %a5, %a6, %a7}, {%b8, %b9}, {%f48, %f49, %f50, %f51};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f52, %f53, %f54, %f55}, {%a4, %a5, %a6, %a7}, {%b10, %b11}, {%f52, %f53, %f54, %f55};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f56, %f57, %f58, %f59}, {%a4, %a5, %a6, %a7}, {%b12, %b13}, {%f56, %f57, %f58, %f59};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f60, %f61, %f62, %f63}, {%a4, %a5, %a6, %a7}, {%b14, %b15}, {%f60, %f61, %f62, %f63};
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b16, %b17, %b18, %b19}, [%r21];
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f64, %f65, %f66, %f67}, {%a8, %a9, %a10, %a11}, {%b0, %b1}, {%f64, %f65, %f66, %f67};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f68, %f69, %f70, %f71}, {%a8, %a9, %a10, %a11}, {%b2, %b3}, {%f68, %f69, %f70, %f71};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f72, %f73, %f74, %f75}, {%a8, %a9, %a10, %a11}, {%b4, %b5}, {%f72, %f73, %f74, %f75};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f76, %f77, %f78, %f79}, {%a8, %a9, %a10, %a11}, {%b6, %b7}, {%f76, %f77, %f78, %f79};
    xor.b32 %r23, %r21, 32;
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b20, %b21, %b22, %b23}, [%r23];
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f80, %f81, %f82, %f83}, {%a8, %a9, %a10, %a11}, {%b8, %b9}, {%f80, %f81, %f82, %f83};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f84, %f85, %f86, %f87}, {%a8, %a9, %a10, %a11}, {%b10, %b11}, {%f84, %f85, %f86, %f87};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f88, %f89, %f90, %f91}, {%a8, %a9, %a10, %a11}, {%b12, %b13}, {%f88, %f89, %f90, %f91};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f92, %f93, %f94, %f95}, {%a8, %a9, %a10, %a11}, {%b14, %b15}, {%f92, %f93, %f94, %f95};
    xor.b32 %r23, %r21, 64;
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b24, %b25, %b26, %b27}, [%r23];
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f96, %f97, %f98, %f99}, {%a12, %a13, %a14, %a15}, {%b0, %b1}, {%f96, %f97, %f98, %f99};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f100, %f101, %f102, %f103}, {%a12, %a13, %a14, %a15}, {%b2, %b3}, {%f100, %f101, %f102, %f103};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f104, %f105, %f106, %f107}, {%a12, %a13, %a14, %a15}, {%b4, %b5}, {%f104, %f105, %f106, %f107};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f108, %f109, %f110, %f111}, {%a12, %a13, %a14, %a15}, {%b6, %b7}, {%f108, %f109, %f110, %f111};
    xor.b32 %r23, %r21, 96;
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b28, %b29, %b30, %b31}, [%r23];
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f112, %f113, %f114, %f115}, {%a12, %a13, %a14, %a15}, {%b8, %b9}, {%f112, %f113, %f114, %f115};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f116, %f117, %f118, %f119}, {%a12, %a13, %a14, %a15}, {%b10, %b11}, {%f116, %f117, %f118, %f119};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f120, %f121, %f122, %f123}, {%a12, %a13, %a14, %a15}, {%b12, %b13}, {%f120, %f121, %f122, %f123};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f124, %f125, %f126, %f127}, {%a12, %a13, %a14, %a15}, {%b14, %b15}, {%f124, %f125, %f126, %f127};

    // Current shared operands are in registers, so shared stages can safely rotate.
    cp.async.wait_group 0;
    bar.sync 0;
    xor.b32 %r17, %r17, 24576;

    // Refill the retired stage early, overlapping a full tile of tensor-core work.
    xor.b32 %r19, %r17, 24576;
    add.u32 %r20, %r12, %r19;
    add.u32 %r21, %r13, %r19;
    setp.lt.u32 %q0, %r18, 128;
    @%q0 cp.async.cg.shared.global [%r20], [%g0], 16;
    @%q0 cp.async.cg.shared.global [%r20+4096], [%g0+524288], 16;
    @%q0 cp.async.cg.shared.global [%r21], [%g1], 16;
    @%q0 cp.async.cg.shared.global [%r21+4096], [%g1+65536], 16;
    @%q0 cp.async.cg.shared.global [%r21+8192], [%g1+131072], 16;
    @%q0 cp.async.cg.shared.global [%r21+12288], [%g1+196608], 16;
    cp.async.commit_group;
    add.u64 %g0, %g0, 64;
    add.u64 %g1, %g1, 262144;
    add.u32 %r20, %r14, %r17;
    add.u32 %r21, %r15, %r17;

    // Preload the next tile while completing the second 16-wide tensor-core slice.
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a0, %a1, %a2, %a3}, [%r20];
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f0, %f1, %f2, %f3}, {%a16, %a17, %a18, %a19}, {%b16, %b17}, {%f0, %f1, %f2, %f3};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%f4, %f5, %f6, %f7}, {%a16, %a17, %a18, %a19}, {%b18, %b19}, {%f4, %f5, %f6, %f7};
