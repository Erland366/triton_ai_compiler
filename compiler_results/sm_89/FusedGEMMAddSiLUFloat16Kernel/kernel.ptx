cp.async.wait_group 0;
bar.sync 0;
mov.u32 %stage, %next;
add.u64 %ga, %ga, 128;
add.u64 %gb, %gb, 524288;
add.u32 %it, %it, 1;
setp.lt.u32 %p, %it, 64;
@%p bra K_LOOP;
