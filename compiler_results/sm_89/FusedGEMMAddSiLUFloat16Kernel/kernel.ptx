xor.b32 %es1, %es0, 32;
xor.b32 %es2, %es0, 64;
xor.b32 %es3, %es0, 96;
xor.b32 %es4, %es0, 128;
xor.b32 %es5, %es0, 160;
xor.b32 %es6, %es0, 192;
xor.b32 %es7, %es0, 224;
