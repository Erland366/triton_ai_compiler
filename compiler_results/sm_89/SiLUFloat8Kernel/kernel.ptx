.version 8.7
.target sm_89
.address_size 64

.extern .shared .align 16 .b8 global_smem[];

.visible .entry kernel(
    .param .u64 x_ptr,
    .param .u64 output_ptr,
    .param .u64 dummy_ptr1,
    .param .u64 dummy_ptr2
)
{
    .reg .b32 %r<12>;
    .reg .b64 %rd<5>;
    .reg .b16 %h<12>;
    .reg .f32 %x<8>, %e<8>;

    // Each thread owns eight contiguous elements of the 1024-element tile.
    ld.param.u64 %rd0, [x_ptr];
    ld.param.u64 %rd1, [output_ptr];
    mov.u32 %r0, %ctaid.x;
    mov.u32 %r1, %tid.x;
    shl.b32 %r1, %r1, 3;
    mad.lo.u32 %r2, %r0, 1024, %r1;
    cvt.u64.u32 %rd2, %r2;
    add.u64 %rd0, %rd0, %rd2;
    shl.b64 %rd2, %rd2, 1;
    add.u64 %rd1, %rd1, %rd2;

    // Load eight bytes and decode four packed FP8 pairs exactly.
    ld.global.v2.b32 {%r3,%r4}, [%rd0];
    mov.b32 {%h0,%h1}, %r3;
    mov.b32 {%h2,%h3}, %r4;
    cvt.rn.f16x2.e4m3x2 %r5, %h0;
    cvt.rn.f16x2.e4m3x2 %r6, %h1;
    cvt.rn.f16x2.e4m3x2 %r7, %h2;
    cvt.rn.f16x2.e4m3x2 %r8, %h3;
    mov.b32 {%h4,%h5}, %r5;
    mov.b32 {%h6,%h7}, %r6;
    mov.b32 {%h8,%h9}, %r7;
    mov.b32 {%h10,%h11}, %r8;
    cvt.f32.f16 %x0, %h4;
    cvt.f32.f16 %x1, %h5;
    cvt.f32.f16 %x2, %h6;
    cvt.f32.f16 %x3, %h7;
    cvt.f32.f16 %x4, %h8;
    cvt.f32.f16 %x5, %h9;
    cvt.f32.f16 %x6, %h10;
    cvt.f32.f16 %x7, %h11;

    // Compute exp(-x) using base-two exponentials in FP32.
    mul.f32 %e0, %x0, 0fBFB8AA3B;
    mul.f32 %e1, %x1, 0fBFB8AA3B;
    mul.f32 %e2, %x2, 0fBFB8AA3B;
    mul.f32 %e3, %x3, 0fBFB8AA3B;
    mul.f32 %e4, %x4, 0fBFB8AA3B;
    mul.f32 %e5, %x5, 0fBFB8AA3B;
    mul.f32 %e6, %x6, 0fBFB8AA3B;
    mul.f32 %e7, %x7, 0fBFB8AA3B;
    ex2.approx.f32 %e0, %e0;
    ex2.approx.f32 %e1, %e1;
    ex2.approx.f32 %e2, %e2;
    ex2.approx.f32 %e3, %e3;
    ex2.approx.f32 %e4, %e4;
    ex2.approx.f32 %e5, %e5;
    ex2.approx.f32 %e6, %e6;
    ex2.approx.f32 %e7, %e7;

    // Form the reciprocal denominators for eight independent values.
    add.f32 %e0, %e0, 0f3F800000;
    add.f32 %e1, %e1, 0f3F800000;
    add.f32 %e2, %e2, 0f3F800000;
    add.f32 %e3, %e3, 0f3F800000;
    add.f32 %e4, %e4, 0f3F800000;
    add.f32 %e5, %e5, 0f3F800000;
    add.f32 %e6, %e6, 0f3F800000;
    add.f32 %e7, %e7, 0f3F800000;
    rcp.approx.f32 %e0, %e0;
    rcp.approx.f32 %e1, %e1;
    rcp.approx.f32 %e2, %e2;
    rcp.approx.f32 %e3, %e3;
    rcp.approx.f32 %e4, %e4;
    rcp.approx.f32 %e5, %e5;
    rcp.approx.f32 %e6, %e6;
    rcp.approx.f32 %e7, %e7;

    // Multiply by x to complete x / (1 + exp(-x)).
    mul.f32 %x0, %x0, %e0;
    mul.f32 %x1, %x1, %e1;
    mul.f32 %x2, %x2, %e2;
    mul.f32 %x3, %x3, %e3;
    mul.f32 %x4, %x4, %e4;
    mul.f32 %x5, %x5, %e5;
    mul.f32 %x6, %x6, %e6;
    mul.f32 %x7, %x7, %e7;

    // Round to FP16 and store eight outputs in their original order.
    cvt.rn.f16x2.f32 %r5, %x1, %x0;
    cvt.rn.f16x2.f32 %r6, %x3, %x2;
    cvt.rn.f16x2.f32 %r7, %x5, %x4;
    cvt.rn.f16x2.f32 %r8, %x7, %x6;
    st.global.v4.b32 [%rd1], {%r5,%r6,%r7,%r8};
    ret;
}
