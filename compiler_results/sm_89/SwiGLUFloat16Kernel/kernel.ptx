.version 8.7
.target sm_89
.address_size 64

.extern .shared .align 16 .b8 global_smem[];

.visible .entry kernel(
    .param .u64 gate_ptr,
    .param .u64 value_ptr,
    .param .u64 output_ptr,
    .param .u64 dummy_ptr1,
    .param .u64 dummy_ptr2
)
{
    .reg .b32 %t,%b,%i,%gp<2>,%vp<2>,%op<2>;
    .reg .b64 %g,%v,%o,%off;
    .reg .b16 %gh<4>,%vh<4>,%oh<4>;
    .reg .f32 %gf<4>,%vf<4>,%e<4>,%d<4>,%r<4>;

    // Each thread handles four adjacent elements of the 512-element tile.
    ld.param.u64 %g,[gate_ptr];
    ld.param.u64 %v,[value_ptr];
    ld.param.u64 %o,[output_ptr];
    mov.u32 %t,%tid.x;
    mov.u32 %b,%ctaid.x;
    mad.lo.u32 %i,%b,128,%t;
    mul.wide.u32 %off,%i,8;
    add.u64 %g,%g,%off;
    add.u64 %v,%v,%off;
    add.u64 %o,%o,%off;

    // Load four half values from each input with aligned vector loads.
    ld.global.v2.b32 {%gp0,%gp1},[%g];
    ld.global.v2.b32 {%vp0,%vp1},[%v];
    mov.b32 {%gh0,%gh1},%gp0;
    mov.b32 {%gh2,%gh3},%gp1;
    mov.b32 {%vh0,%vh1},%vp0;
    mov.b32 {%vh2,%vh3},%vp1;

    // Promote both inputs to single precision.
    cvt.f32.f16 %gf0,%gh0;
    cvt.f32.f16 %gf1,%gh1;
    cvt.f32.f16 %gf2,%gh2;
    cvt.f32.f16 %gf3,%gh3;
    cvt.f32.f16 %vf0,%vh0;
    cvt.f32.f16 %vf1,%vh1;
    cvt.f32.f16 %vf2,%vh2;
    cvt.f32.f16 %vf3,%vh3;

    // Evaluate exp(-gate) using multiplication by -log2(e).
    mul.f32 %e0,%gf0,0fBFB8AA3B;
    mul.f32 %e1,%gf1,0fBFB8AA3B;
    mul.f32 %e2,%gf2,0fBFB8AA3B;
    mul.f32 %e3,%gf3,0fBFB8AA3B;
    ex2.approx.f32 %e0,%e0;
    ex2.approx.f32 %e1,%e1;
    ex2.approx.f32 %e2,%e2;
    ex2.approx.f32 %e3,%e3;

    // Form the four sigmoid denominators.
    add.f32 %d0,%e0,0f3F800000;
    add.f32 %d1,%e1,0f3F800000;
    add.f32 %d2,%e2,0f3F800000;
    add.f32 %d3,%e3,0f3F800000;

    // Divide the gate by the denominator, then multiply by value.
    rcp.approx.f32 %r0,%d0;
    rcp.approx.f32 %r1,%d1;
    rcp.approx.f32 %r2,%d2;
    rcp.approx.f32 %r3,%d3;
    mul.f32 %r0,%gf0,%r0;
    mul.f32 %r1,%gf1,%r1;
    mul.f32 %r2,%gf2,%r2;
    mul.f32 %r3,%gf3,%r3;
    mul.f32 %r0,%r0,%vf0;
    mul.f32 %r1,%r1,%vf1;
    mul.f32 %r2,%r2,%vf2;
    mul.f32 %r3,%r3,%vf3;

    // Round to half precision and pack adjacent outputs.
    cvt.rn.f16.f32 %oh0,%r0;
    cvt.rn.f16.f32 %oh1,%r1;
    cvt.rn.f16.f32 %oh2,%r2;
    cvt.rn.f16.f32 %oh3,%r3;
    mov.b32 %op0,{%oh0,%oh1};
    mov.b32 %op1,{%oh2,%oh3};

    // All 512 elements are valid; no boundary mask is needed.
    st.global.v2.b32 [%o],{%op0,%op1};
    ret;
}
