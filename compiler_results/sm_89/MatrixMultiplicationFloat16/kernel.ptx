.version 8.7
.target sm_89
.address_size 64

.visible .entry kernel(
    .param .u64 a_ptr,
    .param .u64 b_ptr,
    .param .u64 c_ptr,
    .param .u64 dummy_ptr1,
    .param .u64 dummy_ptr2
)
.reqntid 256, 1, 1
{
    .reg .pred %p, %q, %load;
    .reg .b32 %r<40>, %a<32>, %b<32>, %h<4>;
    .reg .b64 %A, %B, %C, %ga, %gb, %t, %dst;
    .reg .f32 %c<128>;
    .shared .align 128 .b8 smem[49152];

    // Assign eight warps to a 4 by 2 grid of 64 by 64 output tiles.
    ld.param.u64 %A, [a_ptr];
    ld.param.u64 %B, [b_ptr];
    ld.param.u64 %C, [c_ptr];
    mov.u32 %r0, %tid.x;
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ctaid.y;

    // Exit surplus CTAs uniformly before accessing the exact-sized matrices.
    setp.ge.u32 %p, %r1, 16;
    setp.ge.u32 %q, %r2, 32;
    or.pred %p, %p, %q;
    @%p bra EXIT;
    and.b32 %r3, %r0, 31;
    shr.u32 %r4, %r0, 5;
    shr.u32 %r5, %r4, 1;
    and.b32 %r6, %r4, 1;

    // Fold the 256-row, 128-column CTA offsets and 8192-byte row strides.
    shl.b32 %r7, %r1, 21;
    cvt.u64.u32 %t, %r7;
    add.u64 %A, %A, %t;
    add.u64 %C, %C, %t;
    shl.b32 %r7, %r2, 8;
    cvt.u64.u32 %t, %r7;
    add.u64 %B, %B, %t;
    add.u64 %C, %C, %t;

    // Map each thread to four aligned A vectors per K=32 input stage.
    shr.u32 %r7, %r0, 2;
    and.b32 %r8, %r0, 3;
    shl.b32 %r8, %r8, 4;
    mad.lo.u32 %r9, %r7, 8192, %r8;
    cvt.u64.u32 %t, %r9;
    add.u64 %ga, %A, %t;
    and.b32 %r9, %r7, 7;
    shl.b32 %r9, %r9, 4;
    shl.b32 %r10, %r0, 4;
    xor.b32 %r10, %r10, %r9;

    // Map each thread to two aligned B vectors and swizzle shared banks.
    shr.u32 %r7, %r0, 4;
    and.b32 %r8, %r0, 15;
    shl.b32 %r8, %r8, 4;
    mad.lo.u32 %r9, %r7, 8192, %r8;
    cvt.u64.u32 %t, %r9;
    add.u64 %gb, %B, %t;
    and.b32 %r9, %r7, 7;
    shl.b32 %r9, %r9, 4;
    shl.b32 %r11, %r0, 4;
    xor.b32 %r11, %r11, %r9;
    add.u32 %r11, %r11, 16384;
    mov.u32 %r12, smem;
    add.u32 %r10, %r10, %r12;
    add.u32 %r11, %r11, %r12;

    // Form A ldmatrix addresses in the same swizzled shared layout.
    and.b32 %r7, %r3, 15;
    mad.lo.u32 %r8, %r5, 64, %r7;
    shl.b32 %r8, %r8, 6;
    and.b32 %r9, %r3, 16;
    add.u32 %r8, %r8, %r9;
    and.b32 %r9, %r3, 7;
    shl.b32 %r9, %r9, 4;
    xor.b32 %r13, %r8, %r9;

    // B is row-major in memory; transposed ldmatrix supplies MMA column fragments.
    shl.b32 %r8, %r7, 8;
    shl.b32 %r7, %r6, 7;
    add.u32 %r8, %r8, %r7;
    and.b32 %r7, %r3, 16;
    add.u32 %r8, %r8, %r7;
    xor.b32 %r14, %r8, %r9;
    add.u32 %r14, %r14, 16384;
    add.u32 %r13, %r13, %r12;
    add.u32 %r14, %r14, %r12;

    // Initialize all 128 FP32 accumulators owned by each thread.
    mov.f32 %c0, 0f00000000; mov.f32 %c1, 0f00000000; mov.f32 %c2, 0f00000000; mov.f32 %c3, 0f00000000;
    mov.f32 %c4, 0f00000000; mov.f32 %c5, 0f00000000; mov.f32 %c6, 0f00000000; mov.f32 %c7, 0f00000000;
    mov.f32 %c8, 0f00000000; mov.f32 %c9, 0f00000000; mov.f32 %c10, 0f00000000; mov.f32 %c11, 0f00000000;
    mov.f32 %c12, 0f00000000; mov.f32 %c13, 0f00000000; mov.f32 %c14, 0f00000000; mov.f32 %c15, 0f00000000;
    mov.f32 %c16, 0f00000000; mov.f32 %c17, 0f00000000; mov.f32 %c18, 0f00000000; mov.f32 %c19, 0f00000000;
    mov.f32 %c20, 0f00000000; mov.f32 %c21, 0f00000000; mov.f32 %c22, 0f00000000; mov.f32 %c23, 0f00000000;
    mov.f32 %c24, 0f00000000; mov.f32 %c25, 0f00000000; mov.f32 %c26, 0f00000000; mov.f32 %c27, 0f00000000;
    mov.f32 %c28, 0f00000000; mov.f32 %c29, 0f00000000; mov.f32 %c30, 0f00000000; mov.f32 %c31, 0f00000000;
    mov.f32 %c32, 0f00000000; mov.f32 %c33, 0f00000000; mov.f32 %c34, 0f00000000; mov.f32 %c35, 0f00000000;
    mov.f32 %c36, 0f00000000; mov.f32 %c37, 0f00000000; mov.f32 %c38, 0f00000000; mov.f32 %c39, 0f00000000;
    mov.f32 %c40, 0f00000000; mov.f32 %c41, 0f00000000; mov.f32 %c42, 0f00000000; mov.f32 %c43, 0f00000000;
    mov.f32 %c44, 0f00000000; mov.f32 %c45, 0f00000000; mov.f32 %c46, 0f00000000; mov.f32 %c47, 0f00000000;
    mov.f32 %c48, 0f00000000; mov.f32 %c49, 0f00000000; mov.f32 %c50, 0f00000000; mov.f32 %c51, 0f00000000;
    mov.f32 %c52, 0f00000000; mov.f32 %c53, 0f00000000; mov.f32 %c54, 0f00000000; mov.f32 %c55, 0f00000000;
    mov.f32 %c56, 0f00000000; mov.f32 %c57, 0f00000000; mov.f32 %c58, 0f00000000; mov.f32 %c59, 0f00000000;
    mov.f32 %c60, 0f00000000; mov.f32 %c61, 0f00000000; mov.f32 %c62, 0f00000000; mov.f32 %c63, 0f00000000;
    mov.f32 %c64, 0f00000000; mov.f32 %c65, 0f00000000; mov.f32 %c66, 0f00000000; mov.f32 %c67, 0f00000000;
    mov.f32 %c68, 0f00000000; mov.f32 %c69, 0f00000000; mov.f32 %c70, 0f00000000; mov.f32 %c71, 0f00000000;
    mov.f32 %c72, 0f00000000; mov.f32 %c73, 0f00000000; mov.f32 %c74, 0f00000000; mov.f32 %c75, 0f00000000;
    mov.f32 %c76, 0f00000000; mov.f32 %c77, 0f00000000; mov.f32 %c78, 0f00000000; mov.f32 %c79, 0f00000000;
    mov.f32 %c80, 0f00000000; mov.f32 %c81, 0f00000000; mov.f32 %c82, 0f00000000; mov.f32 %c83, 0f00000000;
    mov.f32 %c84, 0f00000000; mov.f32 %c85, 0f00000000; mov.f32 %c86, 0f00000000; mov.f32 %c87, 0f00000000;
    mov.f32 %c88, 0f00000000; mov.f32 %c89, 0f00000000; mov.f32 %c90, 0f00000000; mov.f32 %c91, 0f00000000;
    mov.f32 %c92, 0f00000000; mov.f32 %c93, 0f00000000; mov.f32 %c94, 0f00000000; mov.f32 %c95, 0f00000000;
    mov.f32 %c96, 0f00000000; mov.f32 %c97, 0f00000000; mov.f32 %c98, 0f00000000; mov.f32 %c99, 0f00000000;
    mov.f32 %c100, 0f00000000; mov.f32 %c101, 0f00000000; mov.f32 %c102, 0f00000000; mov.f32 %c103, 0f00000000;
    mov.f32 %c104, 0f00000000; mov.f32 %c105, 0f00000000; mov.f32 %c106, 0f00000000; mov.f32 %c107, 0f00000000;
    mov.f32 %c108, 0f00000000; mov.f32 %c109, 0f00000000; mov.f32 %c110, 0f00000000; mov.f32 %c111, 0f00000000;
    mov.f32 %c112, 0f00000000; mov.f32 %c113, 0f00000000; mov.f32 %c114, 0f00000000; mov.f32 %c115, 0f00000000;
    mov.f32 %c116, 0f00000000; mov.f32 %c117, 0f00000000; mov.f32 %c118, 0f00000000; mov.f32 %c119, 0f00000000;
    mov.f32 %c120, 0f00000000; mov.f32 %c121, 0f00000000; mov.f32 %c122, 0f00000000; mov.f32 %c123, 0f00000000;
    mov.f32 %c124, 0f00000000; mov.f32 %c125, 0f00000000; mov.f32 %c126, 0f00000000; mov.f32 %c127, 0f00000000;

    // Prime stage zero with K positions 0 through 31.
    mov.u32 %r18, 0;
    add.u32 %r20, %r10, 0; add.u32 %r20, %r20, %r18; add.u64 %t, %ga, 0;
    cp.async.cg.shared.global [%r20], [%t], 16;
    add.u32 %r20, %r10, 4096; add.u32 %r20, %r20, %r18; add.u64 %t, %ga, 524288;
    cp.async.cg.shared.global [%r20], [%t], 16;
    add.u32 %r20, %r10, 8192; add.u32 %r20, %r20, %r18; add.u64 %t, %ga, 1048576;
    cp.async.cg.shared.global [%r20], [%t], 16;
    add.u32 %r20, %r10, 12288; add.u32 %r20, %r20, %r18; add.u64 %t, %ga, 1572864;
    cp.async.cg.shared.global [%r20], [%t], 16;
    add.u32 %r20, %r11, 0; add.u32 %r20, %r20, %r18; add.u64 %t, %gb, 0;
    cp.async.cg.shared.global [%r20], [%t], 16;
    add.u32 %r20, %r11, 4096; add.u32 %r20, %r20, %r18; add.u64 %t, %gb, 131072;
    cp.async.cg.shared.global [%r20], [%t], 16;
    cp.async.commit_group;

    // Prime stage one; two K=32 stages implement each original K=64 tile.
    mov.u32 %r18, 24576;
    add.u64 %ga, %ga, 64;
    add.u64 %gb, %gb, 262144;
    add.u32 %r20, %r10, 0; add.u32 %r20, %r20, %r18; add.u64 %t, %ga, 0;
    cp.async.cg.shared.global [%r20], [%t], 16;
    add.u32 %r20, %r10, 4096; add.u32 %r20, %r20, %r18; add.u64 %t, %ga, 524288;
    cp.async.cg.shared.global [%r20], [%t], 16;
    add.u32 %r20, %r10, 8192; add.u32 %r20, %r20, %r18; add.u64 %t, %ga, 1048576;
    cp.async.cg.shared.global [%r20], [%t], 16;
    add.u32 %r20, %r10, 12288; add.u32 %r20, %r20, %r18; add.u64 %t, %ga, 1572864;
    cp.async.cg.shared.global [%r20], [%t], 16;
    add.u32 %r20, %r11, 0; add.u32 %r20, %r20, %r18; add.u64 %t, %gb, 0;
    cp.async.cg.shared.global [%r20], [%t], 16;
    add.u32 %r20, %r11, 4096; add.u32 %r20, %r20, %r18; add.u64 %t, %gb, 131072;
    cp.async.cg.shared.global [%r20], [%t], 16;
    cp.async.commit_group;

    // Make the first stage visible while the second copy group remains in flight.
    cp.async.wait_group 1;
    bar.sync 0;
    mov.u32 %r16, 0;
    mov.u32 %r17, 0;
    mov.u32 %r21, %r13;
    mov.u32 %r22, %r14;

    // Prime the first K=16 register fragments.
    add.u32 %r23, %r21, 0;
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a0,%a1,%a2,%a3}, [%r23];
    add.u32 %r23, %r21, 1024;
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a4,%a5,%a6,%a7}, [%r23];
    add.u32 %r23, %r21, 2048;
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a8,%a9,%a10,%a11}, [%r23];
    add.u32 %r23, %r21, 3072;
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a12,%a13,%a14,%a15}, [%r23];
    xor.b32 %r23, %r22, 0;
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b0,%b1,%b2,%b3}, [%r23];
    xor.b32 %r23, %r22, 32;
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b4,%b5,%b6,%b7}, [%r23];
    xor.b32 %r23, %r22, 64;
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b8,%b9,%b10,%b11}, [%r23];
    xor.b32 %r23, %r22, 96;
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b12,%b13,%b14,%b15}, [%r23];

K_LOOP:
    // Variant A: 4 independent MMAs followed by 1 next-fragment ldmatrix.x4 load.
    add.u32 %r21, %r13, %r17;
    xor.b32 %r21, %r21, 32;
    add.u32 %r22, %r14, %r17;
    add.u32 %r22, %r22, 4096;

    // Accumulate the first K=16 slice across the full 64 by 64 warp tile.
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c0,%c1,%c2,%c3}, {%a0,%a1,%a2,%a3}, {%b0,%b1}, {%c0,%c1,%c2,%c3};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c4,%c5,%c6,%c7}, {%a0,%a1,%a2,%a3}, {%b2,%b3}, {%c4,%c5,%c6,%c7};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c8,%c9,%c10,%c11}, {%a0,%a1,%a2,%a3}, {%b4,%b5}, {%c8,%c9,%c10,%c11};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c12,%c13,%c14,%c15}, {%a0,%a1,%a2,%a3}, {%b6,%b7}, {%c12,%c13,%c14,%c15};
    add.u32 %r23, %r21, 0;
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a16,%a17,%a18,%a19}, [%r23];
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c16,%c17,%c18,%c19}, {%a0,%a1,%a2,%a3}, {%b8,%b9}, {%c16,%c17,%c18,%c19};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c20,%c21,%c22,%c23}, {%a0,%a1,%a2,%a3}, {%b10,%b11}, {%c20,%c21,%c22,%c23};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c24,%c25,%c26,%c27}, {%a0,%a1,%a2,%a3}, {%b12,%b13}, {%c24,%c25,%c26,%c27};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c28,%c29,%c30,%c31}, {%a0,%a1,%a2,%a3}, {%b14,%b15}, {%c28,%c29,%c30,%c31};
    add.u32 %r23, %r21, 1024;
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a20,%a21,%a22,%a23}, [%r23];
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c32,%c33,%c34,%c35}, {%a4,%a5,%a6,%a7}, {%b0,%b1}, {%c32,%c33,%c34,%c35};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c36,%c37,%c38,%c39}, {%a4,%a5,%a6,%a7}, {%b2,%b3}, {%c36,%c37,%c38,%c39};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c40,%c41,%c42,%c43}, {%a4,%a5,%a6,%a7}, {%b4,%b5}, {%c40,%c41,%c42,%c43};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c44,%c45,%c46,%c47}, {%a4,%a5,%a6,%a7}, {%b6,%b7}, {%c44,%c45,%c46,%c47};
    add.u32 %r23, %r21, 2048;
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a24,%a25,%a26,%a27}, [%r23];
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c48,%c49,%c50,%c51}, {%a4,%a5,%a6,%a7}, {%b8,%b9}, {%c48,%c49,%c50,%c51};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c52,%c53,%c54,%c55}, {%a4,%a5,%a6,%a7}, {%b10,%b11}, {%c52,%c53,%c54,%c55};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c56,%c57,%c58,%c59}, {%a4,%a5,%a6,%a7}, {%b12,%b13}, {%c56,%c57,%c58,%c59};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c60,%c61,%c62,%c63}, {%a4,%a5,%a6,%a7}, {%b14,%b15}, {%c60,%c61,%c62,%c63};
    add.u32 %r23, %r21, 3072;
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a28,%a29,%a30,%a31}, [%r23];
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c64,%c65,%c66,%c67}, {%a8,%a9,%a10,%a11}, {%b0,%b1}, {%c64,%c65,%c66,%c67};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c68,%c69,%c70,%c71}, {%a8,%a9,%a10,%a11}, {%b2,%b3}, {%c68,%c69,%c70,%c71};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c72,%c73,%c74,%c75}, {%a8,%a9,%a10,%a11}, {%b4,%b5}, {%c72,%c73,%c74,%c75};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c76,%c77,%c78,%c79}, {%a8,%a9,%a10,%a11}, {%b6,%b7}, {%c76,%c77,%c78,%c79};
    xor.b32 %r23, %r22, 0;
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b16,%b17,%b18,%b19}, [%r23];
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c80,%c81,%c82,%c83}, {%a8,%a9,%a10,%a11}, {%b8,%b9}, {%c80,%c81,%c82,%c83};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c84,%c85,%c86,%c87}, {%a8,%a9,%a10,%a11}, {%b10,%b11}, {%c84,%c85,%c86,%c87};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c88,%c89,%c90,%c91}, {%a8,%a9,%a10,%a11}, {%b12,%b13}, {%c88,%c89,%c90,%c91};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c92,%c93,%c94,%c95}, {%a8,%a9,%a10,%a11}, {%b14,%b15}, {%c92,%c93,%c94,%c95};
    xor.b32 %r23, %r22, 32;
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b20,%b21,%b22,%b23}, [%r23];
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c96,%c97,%c98,%c99}, {%a12,%a13,%a14,%a15}, {%b0,%b1}, {%c96,%c97,%c98,%c99};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c100,%c101,%c102,%c103}, {%a12,%a13,%a14,%a15}, {%b2,%b3}, {%c100,%c101,%c102,%c103};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c104,%c105,%c106,%c107}, {%a12,%a13,%a14,%a15}, {%b4,%b5}, {%c104,%c105,%c106,%c107};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c108,%c109,%c110,%c111}, {%a12,%a13,%a14,%a15}, {%b6,%b7}, {%c108,%c109,%c110,%c111};
    xor.b32 %r23, %r22, 64;
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b24,%b25,%b26,%b27}, [%r23];
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c112,%c113,%c114,%c115}, {%a12,%a13,%a14,%a15}, {%b8,%b9}, {%c112,%c113,%c114,%c115};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c116,%c117,%c118,%c119}, {%a12,%a13,%a14,%a15}, {%b10,%b11}, {%c116,%c117,%c118,%c119};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c120,%c121,%c122,%c123}, {%a12,%a13,%a14,%a15}, {%b12,%b13}, {%c120,%c121,%c122,%c123};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c124,%c125,%c126,%c127}, {%a12,%a13,%a14,%a15}, {%b14,%b15}, {%c124,%c125,%c126,%c127};
    xor.b32 %r23, %r22, 96;
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b28,%b29,%b30,%b31}, [%r23];

    // Wait for the next stage; every current shared operand is now in registers.
    cp.async.wait_group 0;
    bar.sync 0;
    xor.b32 %r18, %r17, 24576;
    add.u32 %r21, %r13, %r18;
    add.u32 %r22, %r14, %r18;
    setp.lt.u32 %p, %r16, 127;

    // Next-stage first-fragment loads are interleaved below with uniform %p.

    // Refill released storage two stages ahead, suppressing reads beyond K=4096.
    mov.u32 %r18, %r17;
    add.u64 %ga, %ga, 64;
    add.u64 %gb, %gb, 262144;
    setp.lt.u32 %load, %r16, 126;
    add.u32 %r20, %r10, 0; add.u32 %r20, %r20, %r18; add.u64 %t, %ga, 0;
    @%load cp.async.cg.shared.global [%r20], [%t], 16;
    add.u32 %r20, %r10, 4096; add.u32 %r20, %r20, %r18; add.u64 %t, %ga, 524288;
    @%load cp.async.cg.shared.global [%r20], [%t], 16;
    add.u32 %r20, %r10, 8192; add.u32 %r20, %r20, %r18; add.u64 %t, %ga, 1048576;
