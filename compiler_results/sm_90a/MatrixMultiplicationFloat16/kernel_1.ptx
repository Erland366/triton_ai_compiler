// Tried optimization: Sharing the prefill copy block with the two-group steady loop gave P50 0.2569-0.2572 ms; separate blocks gave 0.2561-0.2563 ms.
// Tried optimization: Issuing WGMMA before the released-slot refill regressed P50 to 0.2797-0.2799 ms with the same two-group pipeline.
.version 8.7
.target sm_90a
.address_size 64

.extern .shared .align 16 .b8 global_smem[];

.visible .entry kernel(
    .param .u64 a_ptr,
    .param .u64 b_ptr,
    .param .u64 c_ptr,
    .param .u64 dummy_ptr1,
    .param .u64 dummy_ptr2
)
.reqntid 256, 1, 1
{
 .reg .pred %p, %acc;
 .reg .b32 %r<32>, %pack0, %pack1, %pack2, %pack3;
 .reg .b64 %a, %b, %c, %ga, %gb, %co, %co1, %tmp, %da, %db;
 .reg .f32 %d<128>;

 // Locate the output tile and its two 64-row warpgroups.
 ld.param.u64 %a, [a_ptr];
 ld.param.u64 %b, [b_ptr];
 ld.param.u64 %c, [c_ptr];
 mov.u32 %r0, %tid.x;
 mov.u32 %r1, %ctaid.x;
 mov.u32 %r2, %ctaid.y;

 // Permute the complete grid in eight-row groups for better L2 reuse.
 and.b32 %r4, %r1, 7;
 shr.u32 %r5, %r2, 2;
 mad.lo.u32 %r4, %r5, 8, %r4;
 shr.u32 %r5, %r1, 3;
 and.b32 %r2, %r2, 3;
 mad.lo.u32 %r2, %r2, 4, %r5;
 mov.u32 %r1, %r4;
 mov.u32 %r3, global_smem;
 shl.b32 %r4, %r1, 20;
 cvt.u64.u32 %tmp, %r4;
 add.u64 %a, %a, %tmp;
 shl.b32 %r4, %r2, 9;
 cvt.u64.u32 %tmp, %r4;
 add.u64 %b, %b, %tmp;

 // Assign four A vectors per thread and XOR-swizzle their shared addresses.
 shr.u32 %r4, %r0, 3;
 and.b32 %r5, %r0, 7;
 shl.b32 %r6, %r4, 13;
 mad.lo.u32 %r6, %r5, 16, %r6;
 cvt.u64.u32 %tmp, %r6;
 add.u64 %ga, %a, %tmp;
 and.b32 %r6, %r4, 7;
 xor.b32 %r6, %r6, %r5;
 shl.b32 %r6, %r6, 4;
 mad.lo.u32 %r7, %r4, 128, %r6;

 // B uses four 64-column panels and eight vectors per thread.
 shr.u32 %r4, %r0, 5;
 and.b32 %r5, %r0, 31;
 shl.b32 %r6, %r4, 13;
 mad.lo.u32 %r6, %r5, 16, %r6;
 cvt.u64.u32 %tmp, %r6;
 add.u64 %gb, %b, %tmp;
 shr.u32 %r6, %r5, 3;
 shl.b32 %r6, %r6, 13;
 mad.lo.u32 %r6, %r4, 128, %r6;
 and.b32 %r5, %r5, 7;
 xor.b32 %r5, %r5, %r4;
 mad.lo.u32 %r8, %r5, 16, %r6;
 add.u32 %r8, %r8, 16384;
 shr.u32 %r9, %r0, 7;
 shl.b32 %r9, %r9, 13;

 // Three 49152-byte stages occupy exactly the 147456-byte dynamic allocation.
 mov.u32 %r10, 0;
 mov.u32 %r11, 0;
 mov.u32 %r12, 0;
 mov.u32 %r16, 0;
 setp.ne.u32 %acc, %r0, %r0;
 wgmma.fence.sync.aligned;
PREFILL:
 // Initial copies fill all three slots without waiting for tensor-core groups.
 add.u32 %r13, %r3, %r11;
 add.u32 %r14, %r13, %r7;
 add.u32 %r15, %r13, %r8;
 cp.async.cg.shared.global [%r14+0], [%ga+0], 16;
 cp.async.cg.shared.global [%r14+4096], [%ga+262144], 16;
 cp.async.cg.shared.global [%r14+8192], [%ga+524288], 16;
 cp.async.cg.shared.global [%r14+12288], [%ga+786432], 16;
 cp.async.cg.shared.global [%r15+0], [%gb+0], 16;
 cp.async.cg.shared.global [%r15+1024], [%gb+65536], 16;
 cp.async.cg.shared.global [%r15+2048], [%gb+131072], 16;
 cp.async.cg.shared.global [%r15+3072], [%gb+196608], 16;
 cp.async.cg.shared.global [%r15+4096], [%gb+262144], 16;
 cp.async.cg.shared.global [%r15+5120], [%gb+327680], 16;
 cp.async.cg.shared.global [%r15+6144], [%gb+393216], 16;
 cp.async.cg.shared.global [%r15+7168], [%gb+458752], 16;
 add.u64 %ga, %ga, 128;
 add.u64 %gb, %gb, 524288;
 cp.async.commit_group;
 add.u32 %r11, %r11, 49152;
 setp.eq.u32 %p, %r11, 147456;
 @%p mov.u32 %r11, 0;
 add.u32 %r10, %r10, 1;
 setp.lt.u32 %p, %r10, 3;
 @%p bra PREFILL;

 // Only tile 0 must be ready for the first group; two copies may remain.
 cp.async.wait_group 2;
 bar.sync 0;
 fence.proxy.async.shared::cta;
 bra ISSUE;

PUBLISH_TILE1:
 // Publish tile 1 while group 0 and the tile-2 copy can still be pending.
 cp.async.wait_group 1;
 bar.sync 0;
 fence.proxy.async.shared::cta;
 bra ISSUE;

LOOP:
 setp.eq.u32 %p, %r16, 1;
 @%p bra PUBLISH_TILE1;
 // Tile t has the only outstanding copy group. Retire group t-2, not t-1.
 cp.async.wait_group 0;
 wgmma.wait_group.sync.aligned 1;
 bar.sync 0;
 fence.proxy.async.shared::cta;
 // Copy t+1 into the released (t-2)%3 slot, except after the last input tile.
 setp.eq.u32 %p, %r16, 63;
 @%p bra ISSUE;
 add.u32 %r13, %r3, %r11;
 add.u32 %r14, %r13, %r7;
 add.u32 %r15, %r13, %r8;
 cp.async.cg.shared.global [%r14+0], [%ga+0], 16;
 cp.async.cg.shared.global [%r14+4096], [%ga+262144], 16;
 cp.async.cg.shared.global [%r14+8192], [%ga+524288], 16;
 cp.async.cg.shared.global [%r14+12288], [%ga+786432], 16;
 cp.async.cg.shared.global [%r15+0], [%gb+0], 16;
 cp.async.cg.shared.global [%r15+1024], [%gb+65536], 16;
 cp.async.cg.shared.global [%r15+2048], [%gb+131072], 16;
 cp.async.cg.shared.global [%r15+3072], [%gb+196608], 16;
 cp.async.cg.shared.global [%r15+4096], [%gb+262144], 16;
 cp.async.cg.shared.global [%r15+5120], [%gb+327680], 16;
 cp.async.cg.shared.global [%r15+6144], [%gb+393216], 16;
 cp.async.cg.shared.global [%r15+7168], [%gb+458752], 16;
 add.u64 %ga, %ga, 128;
 add.u64 %gb, %gb, 524288;
 cp.async.commit_group;
 add.u32 %r11, %r11, 49152;
 setp.eq.u32 %p, %r11, 147456;
 @%p mov.u32 %r11, 0;

ISSUE:
 // Describe K-major A and N-major B with 128-byte swizzling.
 add.u32 %r13, %r3, %r12;
 add.u32 %r14, %r13, %r9;
 shr.u32 %r14, %r14, 4;
 cvt.u64.u32 %da, %r14;
 or.b64 %da, %da, 0x4000004000010000;
 add.u32 %r15, %r13, 16384;
 shr.u32 %r15, %r15, 4;
 cvt.u64.u32 %db, %r15;
 or.b64 %db, %db, 0x4000004002000000;

 // Four tensor-core instructions accumulate the 64-element K tile in order.
 // The first instruction of the first tile initializes the FP32 accumulators.
 wgmma.mma_async.sync.aligned.m64n256k16.f32.f16.f16 {%d0, %d1, %d2, %d3, %d4, %d5, %d6, %d7, %d8, %d9, %d10, %d11, %d12, %d13, %d14, %d15, %d16, %d17, %d18, %d19, %d20, %d21, %d22, %d23, %d24, %d25, %d26, %d27, %d28, %d29, %d30, %d31, %d32, %d33, %d34, %d35, %d36, %d37, %d38, %d39, %d40, %d41, %d42, %d43, %d44, %d45, %d46, %d47, %d48, %d49, %d50, %d51, %d52, %d53, %d54, %d55, %d56, %d57, %d58, %d59, %d60, %d61, %d62, %d63, %d64, %d65, %d66, %d67, %d68, %d69, %d70, %d71, %d72, %d73, %d74, %d75, %d76, %d77, %d78, %d79, %d80, %d81, %d82, %d83, %d84, %d85, %d86, %d87, %d88, %d89, %d90, %d91, %d92, %d93, %d94, %d95, %d96, %d97, %d98, %d99, %d100, %d101, %d102, %d103, %d104, %d105, %d106, %d107, %d108, %d109, %d110, %d111, %d112, %d113, %d114, %d115, %d116, %d117, %d118, %d119, %d120, %d121, %d122, %d123, %d124, %d125, %d126, %d127}, %da, %db, %acc, 1, 1, 0, 1;
 setp.eq.u32 %acc, %r0, %r0;
 add.u64 %da, %da, 2;
 add.u64 %db, %db, 128;
 wgmma.mma_async.sync.aligned.m64n256k16.f32.f16.f16 {%d0, %d1, %d2, %d3, %d4, %d5, %d6, %d7, %d8, %d9, %d10, %d11, %d12, %d13, %d14, %d15, %d16, %d17, %d18, %d19, %d20, %d21, %d22, %d23, %d24, %d25, %d26, %d27, %d28, %d29, %d30, %d31, %d32, %d33, %d34, %d35, %d36, %d37, %d38, %d39, %d40, %d41, %d42, %d43, %d44, %d45, %d46, %d47, %d48, %d49, %d50, %d51, %d52, %d53, %d54, %d55, %d56, %d57, %d58, %d59, %d60, %d61, %d62, %d63, %d64, %d65, %d66, %d67, %d68, %d69, %d70, %d71, %d72, %d73, %d74, %d75, %d76, %d77, %d78, %d79, %d80, %d81, %d82, %d83, %d84, %d85, %d86, %d87, %d88, %d89, %d90, %d91, %d92, %d93, %d94, %d95, %d96, %d97, %d98, %d99, %d100, %d101, %d102, %d103, %d104, %d105, %d106, %d107, %d108, %d109, %d110, %d111, %d112, %d113, %d114, %d115, %d116, %d117, %d118, %d119, %d120, %d121, %d122, %d123, %d124, %d125, %d126, %d127}, %da, %db, 1, 1, 1, 0, 1;
 add.u64 %da, %da, 2;
 add.u64 %db, %db, 128;
 wgmma.mma_async.sync.aligned.m64n256k16.f32.f16.f16 {%d0, %d1, %d2, %d3, %d4, %d5, %d6, %d7, %d8, %d9, %d10, %d11, %d12, %d13, %d14, %d15, %d16, %d17, %d18, %d19, %d20, %d21, %d22, %d23, %d24, %d25, %d26, %d27, %d28, %d29, %d30, %d31, %d32, %d33, %d34, %d35, %d36, %d37, %d38, %d39, %d40, %d41, %d42, %d43, %d44, %d45, %d46, %d47, %d48, %d49, %d50, %d51, %d52, %d53, %d54, %d55, %d56, %d57, %d58, %d59, %d60, %d61, %d62, %d63, %d64, %d65, %d66, %d67, %d68, %d69, %d70, %d71, %d72, %d73, %d74, %d75, %d76, %d77, %d78, %d79, %d80, %d81, %d82, %d83, %d84, %d85, %d86, %d87, %d88, %d89, %d90, %d91, %d92, %d93, %d94, %d95, %d96, %d97, %d98, %d99, %d100, %d101, %d102, %d103, %d104, %d105, %d106, %d107, %d108, %d109, %d110, %d111, %d112, %d113, %d114, %d115, %d116, %d117, %d118, %d119, %d120, %d121, %d122, %d123, %d124, %d125, %d126, %d127}, %da, %db, 1, 1, 1, 0, 1;
 add.u64 %da, %da, 2;
 add.u64 %db, %db, 128;
 wgmma.mma_async.sync.aligned.m64n256k16.f32.f16.f16 {%d0, %d1, %d2, %d3, %d4, %d5, %d6, %d7, %d8, %d9, %d10, %d11, %d12, %d13, %d14, %d15, %d16, %d17, %d18, %d19, %d20, %d21, %d22, %d23, %d24, %d25, %d26, %d27, %d28, %d29, %d30, %d31, %d32, %d33, %d34, %d35, %d36, %d37, %d38, %d39, %d40, %d41, %d42, %d43, %d44, %d45, %d46, %d47, %d48, %d49, %d50, %d51, %d52, %d53, %d54, %d55, %d56, %d57, %d58, %d59, %d60, %d61, %d62, %d63, %d64, %d65, %d66, %d67, %d68, %d69, %d70, %d71, %d72, %d73, %d74, %d75, %d76, %d77, %d78, %d79, %d80, %d81, %d82, %d83, %d84, %d85, %d86, %d87, %d88, %d89, %d90, %d91, %d92, %d93, %d94, %d95, %d96, %d97, %d98, %d99, %d100, %d101, %d102, %d103, %d104, %d105, %d106, %d107, %d108, %d109, %d110, %d111, %d112, %d113, %d114, %d115, %d116, %d117, %d118, %d119, %d120, %d121, %d122, %d123, %d124, %d125, %d126, %d127}, %da, %db, 1, 1, 1, 0, 1;
 wgmma.commit_group.sync.aligned;

 // Keep at most groups t-1 and t outstanding; preserve increasing-K updates.
 add.u32 %r12, %r12, 49152;
 setp.eq.u32 %p, %r12, 147456;
 @%p mov.u32 %r12, 0;
 add.u32 %r16, %r16, 1;
 setp.lt.u32 %p, %r16, 64;
 @%p bra LOOP;
 // Both groups must finish before reading accumulators or reusing shared memory.
 wgmma.wait_group.sync.aligned 0;

 // Reuse bytes [0,65536) for a bank-conflict-free output layout conversion.
 bar.sync 0;
 shr.u32 %r4, %r0, 5;
 shl.b32 %r4, %r4, 4;
 and.b32 %r5, %r0, 15;
 add.u32 %r4, %r4, %r5;
 and.b32 %r5, %r0, 16;
 shl.b32 %r6, %r4, 9;
 add.u32 %r6, %r6, %r5;
 and.b32 %r4, %r4, 7;
 shl.b32 %r4, %r4, 4;
 xor.b32 %r6, %r6, %r4;

 // Round once to FP16 and store four 8 by 8 fragments per warp at a time.
 cvt.rn.f16x2.f32 %pack0, %d1, %d0;
 cvt.rn.f16x2.f32 %pack1, %d3, %d2;
 cvt.rn.f16x2.f32 %pack2, %d5, %d4;
 cvt.rn.f16x2.f32 %pack3, %d7, %d6;
 xor.b32 %r7, %r6, 0;
 add.u32 %r7, %r7, %r3;
 stmatrix.sync.aligned.m8n8.x4.shared.b16 [%r7], {%pack0, %pack1, %pack2, %pack3};
 cvt.rn.f16x2.f32 %pack0, %d9, %d8;
 cvt.rn.f16x2.f32 %pack1, %d11, %d10;
 cvt.rn.f16x2.f32 %pack2, %d13, %d12;
 cvt.rn.f16x2.f32 %pack3, %d15, %d14;
 xor.b32 %r7, %r6, 32;
 add.u32 %r7, %r7, %r3;
 stmatrix.sync.aligned.m8n8.x4.shared.b16 [%r7], {%pack0, %pack1, %pack2, %pack3};
 cvt.rn.f16x2.f32 %pack0, %d17, %d16;
 cvt.rn.f16x2.f32 %pack1, %d19, %d18;
 cvt.rn.f16x2.f32 %pack2, %d21, %d20;
 cvt.rn.f16x2.f32 %pack3, %d23, %d22;
 xor.b32 %r7, %r6, 64;
 add.u32 %r7, %r7, %r3;
 stmatrix.sync.aligned.m8n8.x4.shared.b16 [%r7], {%pack0, %pack1, %pack2, %pack3};
 cvt.rn.f16x2.f32 %pack0, %d25, %d24;
 cvt.rn.f16x2.f32 %pack1, %d27, %d26;
 cvt.rn.f16x2.f32 %pack2, %d29, %d28;
 cvt.rn.f16x2.f32 %pack3, %d31, %d30;
 xor.b32 %r7, %r6, 96;
 add.u32 %r7, %r7, %r3;
 stmatrix.sync.aligned.m8n8.x4.shared.b16 [%r7], {%pack0, %pack1, %pack2, %pack3};
 cvt.rn.f16x2.f32 %pack0, %d33, %d32;
 cvt.rn.f16x2.f32 %pack1, %d35, %d34;
 cvt.rn.f16x2.f32 %pack2, %d37, %d36;
 cvt.rn.f16x2.f32 %pack3, %d39, %d38;
 xor.b32 %r7, %r6, 128;
 add.u32 %r7, %r7, %r3;
 stmatrix.sync.aligned.m8n8.x4.shared.b16 [%r7], {%pack0, %pack1, %pack2, %pack3};
 cvt.rn.f16x2.f32 %pack0, %d41, %d40;
 cvt.rn.f16x2.f32 %pack1, %d43, %d42;
 cvt.rn.f16x2.f32 %pack2, %d45, %d44;
 cvt.rn.f16x2.f32 %pack3, %d47, %d46;
 xor.b32 %r7, %r6, 160;
 add.u32 %r7, %r7, %r3;
 stmatrix.sync.aligned.m8n8.x4.shared.b16 [%r7], {%pack0, %pack1, %pack2, %pack3};
 cvt.rn.f16x2.f32 %pack0, %d49, %d48;
 cvt.rn.f16x2.f32 %pack1, %d51, %d50;
 cvt.rn.f16x2.f32 %pack2, %d53, %d52;
 cvt.rn.f16x2.f32 %pack3, %d55, %d54;
 xor.b32 %r7, %r6, 192;
 add.u32 %r7, %r7, %r3;
 stmatrix.sync.aligned.m8n8.x4.shared.b16 [%r7], {%pack0, %pack1, %pack2, %pack3};
 cvt.rn.f16x2.f32 %pack0, %d57, %d56;
 cvt.rn.f16x2.f32 %pack1, %d59, %d58;
 cvt.rn.f16x2.f32 %pack2, %d61, %d60;
 cvt.rn.f16x2.f32 %pack3, %d63, %d62;
 xor.b32 %r7, %r6, 224;
 add.u32 %r7, %r7, %r3;
 stmatrix.sync.aligned.m8n8.x4.shared.b16 [%r7], {%pack0, %pack1, %pack2, %pack3};
 cvt.rn.f16x2.f32 %pack0, %d65, %d64;
 cvt.rn.f16x2.f32 %pack1, %d67, %d66;
 cvt.rn.f16x2.f32 %pack2, %d69, %d68;
 cvt.rn.f16x2.f32 %pack3, %d71, %d70;
 xor.b32 %r7, %r6, 256;
 add.u32 %r7, %r7, %r3;
 stmatrix.sync.aligned.m8n8.x4.shared.b16 [%r7], {%pack0, %pack1, %pack2, %pack3};
 cvt.rn.f16x2.f32 %pack0, %d73, %d72;
 cvt.rn.f16x2.f32 %pack1, %d75, %d74;
 cvt.rn.f16x2.f32 %pack2, %d77, %d76;
 cvt.rn.f16x2.f32 %pack3, %d79, %d78;
 xor.b32 %r7, %r6, 288;
 add.u32 %r7, %r7, %r3;
 stmatrix.sync.aligned.m8n8.x4.shared.b16 [%r7], {%pack0, %pack1, %pack2, %pack3};
 cvt.rn.f16x2.f32 %pack0, %d81, %d80;
 cvt.rn.f16x2.f32 %pack1, %d83, %d82;
 cvt.rn.f16x2.f32 %pack2, %d85, %d84;
 cvt.rn.f16x2.f32 %pack3, %d87, %d86;
 xor.b32 %r7, %r6, 320;
 add.u32 %r7, %r7, %r3;
 stmatrix.sync.aligned.m8n8.x4.shared.b16 [%r7], {%pack0, %pack1, %pack2, %pack3};
 cvt.rn.f16x2.f32 %pack0, %d89, %d88;
 cvt.rn.f16x2.f32 %pack1, %d91, %d90;
 cvt.rn.f16x2.f32 %pack2, %d93, %d92;
 cvt.rn.f16x2.f32 %pack3, %d95, %d94;
 xor.b32 %r7, %r6, 352;
 add.u32 %r7, %r7, %r3;
 stmatrix.sync.aligned.m8n8.x4.shared.b16 [%r7], {%pack0, %pack1, %pack2, %pack3};
 cvt.rn.f16x2.f32 %pack0, %d97, %d96;
 cvt.rn.f16x2.f32 %pack1, %d99, %d98;
 cvt.rn.f16x2.f32 %pack2, %d101, %d100;
 cvt.rn.f16x2.f32 %pack3, %d103, %d102;
 xor.b32 %r7, %r6, 384;
 add.u32 %r7, %r7, %r3;
 stmatrix.sync.aligned.m8n8.x4.shared.b16 [%r7], {%pack0, %pack1, %pack2, %pack3};
 cvt.rn.f16x2.f32 %pack0, %d105, %d104;
 cvt.rn.f16x2.f32 %pack1, %d107, %d106;
 cvt.rn.f16x2.f32 %pack2, %d109, %d108;
 cvt.rn.f16x2.f32 %pack3, %d111, %d110;
 xor.b32 %r7, %r6, 416;
 add.u32 %r7, %r7, %r3;
 stmatrix.sync.aligned.m8n8.x4.shared.b16 [%r7], {%pack0, %pack1, %pack2, %pack3};
 cvt.rn.f16x2.f32 %pack0, %d113, %d112;
 cvt.rn.f16x2.f32 %pack1, %d115, %d114;
 cvt.rn.f16x2.f32 %pack2, %d117, %d116;
 cvt.rn.f16x2.f32 %pack3, %d119, %d118;
