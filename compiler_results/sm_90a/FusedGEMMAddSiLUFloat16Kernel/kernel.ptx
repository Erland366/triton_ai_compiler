    mov.u32 %pn,%ctaid.y;
    mad.lo.u32 %x,%pn,32,%pm;
    shr.u32 %pm,%x,8;
    shl.b32 %pm,%pm,4;
    and.b32 %y,%x,15;
    add.u32 %pm,%pm,%y;
    shr.u32 %pn,%x,4;
    and.b32 %pn,%pn,15;
    mov.u32 %sm,global_smem;
    shr.u32 %wg,%t,7;
    shl.b32 %wg,%wg,13;

    // Form coalesced 16-byte A vectors and their swizzled shared offsets.
    shl.b32 %x,%pm,20;
    shr.u32 %y,%t,3;
    mad.lo.u32 %x,%y,8192,%x;
    and.b32 %z,%t,7;
    mad.lo.u32 %x,%z,16,%x;
    cvt.u64.u32 %off,%x;
    add.u64 %a,%a,%off;
    shl.b32 %as,%t,4;
    and.b32 %y,%y,7;
    shl.b32 %y,%y,4;
    xor.b32 %as,%as,%y;
    add.u32 %as,%as,%sm;
    shr.u32 %y,%t,5;
    and.b32 %z,%t,31;
    shl.b32 %x,%pn,9;
    mad.lo.u32 %x,%y,8192,%x;
    mad.lo.u32 %x,%z,16,%x;
