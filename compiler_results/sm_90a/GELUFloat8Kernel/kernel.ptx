.version 8.7
.target sm_90a
.address_size 64

.extern .shared .align 16 .b8 global_smem[];

// Half GELU values indexed by the FP8 encoding.
.global .align 16 .u16 gelu[256] = {0,5122,6147,6663,7174,7434,7694,7956,8205,8336,8468,8600,8733,8866,8999,9133,9242,9376,9512,9648,9785,9923,10062,10202,10291,10433,10576,10720,10867,11015,11164,11290,11366,11521,11679,11840,12004,12172,12315,12402,12490,12671,12858,13051,13249,13382,13487,13594,13704,13931,14167,14374,14500,14629,14762,14897,15035,15316,15481,15625,15769,15913,16056,16198,16337,16498,16632,16764,16894,17023,17152,17280,17408,17536,17664,17792,17920,18048,18176,18304,18432,18560,18688,18816,18944,19072,19200,19328,19456,19584,19712,19840,19968,20096,20224,20352,20480,20608,20736,20864,20992,21120,21248,21376,21504,21632,21760,21888,22016,22144,22272,22400,22528,22656,22784,22912,23040,23168,23296,23424,23552,23680,23808,23936,24064,24192,24320,32256,32768,37885,38906,39417,39923,40182,40434,40684,40934,41072,41196,41320,41443,41566,41689,41811,41933,42080,42200,42320,42439,42557,42674,42790,42906,43071,43184,43296,43405,43513,43620,43725,43828,44030,44129,44224,44316,44404,44490,44572,44652,44802,44940,45061,45119,45171,45218,45259,45296,45354,45394,45417,45424,45418,45400,45370,45332,45233,45114,44913,44650,44395,44157,43852,43475,42763,41971,41010,39974,38830,37548,36207,34855,33024,32793,32771,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32768,32256};

.visible .entry kernel(
    .param .u64 x_ptr,
    .param .u64 output_ptr,
    .param .u64 dummy_ptr1,
    .param .u64 dummy_ptr2
)
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<16>;
    .reg .b16 %h<8>;

    // Each thread handles eight adjacent elements of the full 1024-element tile.
    ld.param.u64 %rd0, [x_ptr];
    ld.param.u64 %rd1, [output_ptr];
    mov.u32 %r0, %tid.x;
    mov.u32 %r1, %ctaid.x;
    shl.b32 %r2, %r0, 3;
    mad.lo.u32 %r2, %r1, 1024, %r2;
    cvt.u64.u32 %rd2, %r2;
    add.u64 %rd0, %rd0, %rd2;
    shl.b64 %rd2, %rd2, 1;
    add.u64 %rd1, %rd1, %rd2;
    mov.u64 %rd3, gelu;

    // Load eight FP8 values together and extract their byte encodings.
    ld.global.v2.u32 {%r8, %r9}, [%rd0];
    bfe.u32 %r10, %r8, 0, 8;
    bfe.u32 %r11, %r8, 8, 8;
    bfe.u32 %r12, %r8, 16, 8;
    bfe.u32 %r13, %r8, 24, 8;
    bfe.u32 %r14, %r9, 0, 8;
    bfe.u32 %r15, %r9, 8, 8;
    bfe.u32 %r16, %r9, 16, 8;
    bfe.u32 %r17, %r9, 24, 8;

    // Form independent addresses in the complete FP8-to-half GELU table.
    mul.wide.u32 %rd4, %r10, 2;
    mul.wide.u32 %rd5, %r11, 2;
    mul.wide.u32 %rd6, %r12, 2;
    mul.wide.u32 %rd7, %r13, 2;
    mul.wide.u32 %rd8, %r14, 2;
    mul.wide.u32 %rd9, %r15, 2;
    mul.wide.u32 %rd10, %r16, 2;
    mul.wide.u32 %rd11, %r17, 2;
    add.u64 %rd4, %rd3, %rd4;
    add.u64 %rd5, %rd3, %rd5;
    add.u64 %rd6, %rd3, %rd6;
    add.u64 %rd7, %rd3, %rd7;
    add.u64 %rd8, %rd3, %rd8;
    add.u64 %rd9, %rd3, %rd9;
    add.u64 %rd10, %rd3, %rd10;
    add.u64 %rd11, %rd3, %rd11;

    // Gather rounded half results through the read-only cache.
    ld.global.nc.u16 %h0, [%rd4];
    ld.global.nc.u16 %h1, [%rd5];
    ld.global.nc.u16 %h2, [%rd6];
    ld.global.nc.u16 %h3, [%rd7];
    ld.global.nc.u16 %h4, [%rd8];
    ld.global.nc.u16 %h5, [%rd9];
    ld.global.nc.u16 %h6, [%rd10];
    ld.global.nc.u16 %h7, [%rd11];

    // Pack eight half values into one aligned 16-byte output store.
    mov.b32 %r18, {%h0, %h1};
    mov.b32 %r19, {%h2, %h3};
    mov.b32 %r20, {%h4, %h5};
    mov.b32 %r21, {%h6, %h7};
    st.global.v4.u32 [%rd1], {%r18, %r19, %r20, %r21};
    ret;
}
