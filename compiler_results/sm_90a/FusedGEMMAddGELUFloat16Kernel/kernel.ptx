.version 8.7
.target sm_90a
.address_size 64

.extern .shared .align 16 .b8 global_smem[];

.visible .entry kernel(
    .param .u64 a_ptr,
    .param .u64 b_ptr,
    .param .u64 d_ptr,
    .param .u64 c_ptr,
    .param .u64 dummy_ptr1,
    .param .u64 dummy_ptr2
