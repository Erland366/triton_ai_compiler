and.b32 %r1,%th,31;
shl.b32 %r2,%r0,13;
shl.b32 %r3,%r1,4;
add.u32 %r2,%r2,%r3;
cvt.u64.u32 %tmp,%r2;
add.u64 %gb,%B,%tmp;
shr.u32 %r2,%r1,3;
shl.b32 %bs,%r2,13;
shl.b32 %r3,%r0,7;
