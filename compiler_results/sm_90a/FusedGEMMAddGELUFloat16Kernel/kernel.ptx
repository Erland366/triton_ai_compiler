.reqntid 256,1,1
{
.reg .u32 %th,%bm,%bn,%wg,%warp,%lane,%r<24>;
.reg .u32 %as,%bs,%loadstage,%it,%prefill,%sa,%sb,%sm,%ep,%idx,%row,%col;
.reg .u64 %A,%B,%D,%C,%ga,%gb,%tmp,%ad,%bd,%gd,%gc;
.reg .pred %q,%load,%useacc;
.reg .f32 %acc<128>,%v<16>,%z<16>,%t<16>,%p<16>,%e<16>;
.reg .b16 %h<16>;
.reg .b32 %pack<8>;

// Two warpgroups compute a full 128-by-256 output tile.
ld.param.u64 %A,[a_ptr];
ld.param.u64 %B,[b_ptr];
ld.param.u64 %D,[d_ptr];
ld.param.u64 %C,[c_ptr];
mov.u32 %th,%tid.x;
mov.u32 %bm,%ctaid.x;
mov.u32 %bn,%ctaid.y;

// Bijectively group eight row tiles to improve L2 reuse.
mad.lo.u32 %r0,%bn,32,%bm;
and.b32 %bm,%r0,7;
shr.u32 %r1,%r0,7;
mad.lo.u32 %bm,%r1,8,%bm;
shr.u32 %bn,%r0,3;
and.b32 %bn,%bn,15;
shr.u32 %wg,%th,7;
shr.u32 %warp,%th,5;
and.b32 %lane,%th,31;
mov.u32 %sm,global_smem;
shl.b32 %r0,%bm,20;
cvt.u64.u32 %tmp,%r0;
add.u64 %A,%A,%tmp;
shl.b32 %r0,%bn,9;
cvt.u64.u32 %tmp,%r0;
add.u64 %B,%B,%tmp;

// Compute aligned copy addresses for the 128-byte-swizzled A tile.
shr.u32 %r0,%th,3;
and.b32 %r1,%th,7;
shl.b32 %r1,%r1,4;
shl.b32 %r2,%r0,13;
add.u32 %r2,%r2,%r1;
cvt.u64.u32 %tmp,%r2;
add.u64 %ga,%A,%tmp;
shl.b32 %as,%r0,7;
add.u32 %as,%as,%r1;
and.b32 %r2,%r0,7;
shl.b32 %r2,%r2,4;
xor.b32 %as,%as,%r2;
add.u32 %as,%as,%sm;

// Store B in four swizzled 64-by-64 panels.
