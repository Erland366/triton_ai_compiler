.version 8.7
.target sm_90a
.address_size 64

.extern .shared .align 16 .b8 global_smem[];

.visible .entry kernel(
    .param .u64 x_ptr,
    .param .u64 weight_ptr,
    .param .u64 output_ptr,
    .param .u64 dummy_ptr1,
    .param .u64 dummy_ptr2
)
{
 .reg .pred %p, %use, %s0, %s1;
 .reg .b32 %r<32>, %v<20>, %ib<4>, %sel0, %sel1;
 .reg .b64 %X, %W, %O, %off<4>, %g<4>, %wg, %desc<6>, %tmp;
 .reg .f32 %a<128>;

 // Each CTA computes 128 channels by 128 consecutive batch-spatial positions.
 ld.param.u64 %X, [x_ptr];
 ld.param.u64 %W, [weight_ptr];
 ld.param.u64 %O, [output_ptr];
 mov.u32 %r0, %tid.x;
 mov.u32 %r1, %ctaid.x;
 shl.b32 %r1, %r1, 7;
 mov.u32 %r2, %ctaid.y;
 shl.b32 %r2, %r2, 7;
 mov.u32 %r3, global_smem;

 // Precompute four input pixel pairs, including output-row and batch crossings.
 and.b32 %r4, %r0, 15;
 shl.b32 %r4, %r4, 1;
 add.u32 %r5, %r1, %r4;
 div.u32 %r6, %r5, 2916;
 rem.u32 %r7, %r5, 2916;
 div.u32 %r8, %r7, 54;
 mad.lo.u32 %r9, %r8, 2, %r7;
 mad.lo.u32 %ib0, %r6, 200704, %r9;
 add.u32 %r5, %r5, 32;
 div.u32 %r6, %r5, 2916;
 rem.u32 %r7, %r5, 2916;
 div.u32 %r8, %r7, 54;
 mad.lo.u32 %r9, %r8, 2, %r7;
 mad.lo.u32 %ib1, %r6, 200704, %r9;
 add.u32 %r5, %r5, 32;
 div.u32 %r6, %r5, 2916;
 rem.u32 %r7, %r5, 2916;
 div.u32 %r8, %r7, 54;
 mad.lo.u32 %r9, %r8, 2, %r7;
 mad.lo.u32 %ib2, %r6, 200704, %r9;
 add.u32 %r5, %r5, 32;
 div.u32 %r6, %r5, 2916;
 rem.u32 %r7, %r5, 2916;
 div.u32 %r8, %r7, 54;
 mad.lo.u32 %r9, %r8, 2, %r7;
 mad.lo.u32 %ib3, %r6, 200704, %r9;

 // Map aligned weight segments to K-major, 64-byte swizzled shared rows.
 shr.u32 %r6, %r0, 2;
 add.u32 %r7, %r6, %r2;
 and.b32 %r8, %r0, 3;
 shl.b32 %r8, %r8, 4;
 mad.lo.u32 %r9, %r7, 576, %r8;
 cvt.u64.u32 %wg, %r9;
 add.u64 %wg, %W, %wg;
 mad.lo.u32 %r10, %r6, 64, %r8;
 shr.u32 %r11, %r10, 3;
 and.b32 %r11, %r11, 48;
 xor.b32 %r10, %r10, %r11;
 add.u32 %r10, %r10, %r3;

 // Each 16 KiB stage contains 8 KiB of weights and 8 KiB of gathered inputs.
 shr.u32 %r12, %r0, 4;
 shl.b32 %r12, %r12, 2;
 mad.lo.u32 %r13, %r4, 64, %r12;
 shr.u32 %r11, %r13, 3;
 and.b32 %r11, %r11, 48;
 xor.b32 %r13, %r13, %r11;
 add.u32 %r13, %r13, 8192;
 add.u32 %r13, %r13, %r3;
 shr.u32 %r11, %r3, 4;
 cvt.u64.u32 %tmp, %r11;
 mov.u64 %desc0, 0x8000002000010000;
 add.u64 %desc0, %desc0, %tmp;
 add.u64 %desc1, %desc0, 256;
 add.u64 %desc2, %desc0, 512;
 mov.u32 %r14, 0;
 mov.u32 %r15, 0;
 wgmma.fence.sync.aligned;

K_LOOP:
 // Asynchronous weight copies overlap input gathering and the preceding MMA group.
 add.u32 %r16, %r10, %r15;
 cp.async.cg.shared.global [%r16], [%wg], 16;
 add.u32 %r17, %r16, 2048;
 add.u64 %g0, %wg, 18432;
 cp.async.cg.shared.global [%r17], [%g0], 16;
 add.u32 %r17, %r16, 4096;
 add.u64 %g0, %wg, 36864;
 cp.async.cg.shared.global [%r17], [%g0], 16;
 add.u32 %r17, %r16, 6144;
 add.u64 %g0, %wg, 55296;
 cp.async.cg.shared.global [%r17], [%g0], 16;
 cp.async.commit_group;
 add.u32 %r16, %r13, %r15;
 add.u32 %r22, %r14, %r12;
 mov.u32 %r23, 0;

INPUT_HALF:
 // Four consecutive k values span two kernel rows; select their column pattern.
 div.u32 %r18, %r22, 3;
 mad.lo.u32 %r19, %r18, -3, %r22;
 setp.eq.u32 %s0, %r19, 0;
 setp.eq.u32 %s1, %r19, 1;
 selp.b32 %sel0, 0x5421, 0x6542, %s1;
 selp.b32 %sel0, 0x4210, %sel0, %s0;
