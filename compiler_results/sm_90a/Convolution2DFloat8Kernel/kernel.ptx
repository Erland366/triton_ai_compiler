 add.u64 %off0, %X, %off0;
 add.u32 %r18, %r18, 1;
 div.u32 %r19, %r18, 3;
 mul.lo.u32 %r20, %r18, 56;
 mad.lo.u32 %r21, %r19, 2968, %r20;
 cvt.u64.u32 %off1, %r21;
 add.u64 %off1, %X, %off1;

 // Load aligned four-byte windows using halfwords; pixel pairs never cross a row.
 cvt.u64.u32 %g0, %ib0;
 add.u64 %g1, %g0, %off1;
 add.u64 %g0, %g0, %off0;
 ld.global.u16 %v0, [%g0];
 ld.global.u16 %v1, [%g0+2];
 ld.global.u16 %v2, [%g1];
 ld.global.u16 %v3, [%g1+2];
 cvt.u64.u32 %g0, %ib1;
 add.u64 %g1, %g0, %off1;
 add.u64 %g0, %g0, %off0;
 ld.global.u16 %v4, [%g0];
 ld.global.u16 %v5, [%g0+2];
 ld.global.u16 %v6, [%g1];
 ld.global.u16 %v7, [%g1+2];
 cvt.u64.u32 %g0, %ib2;
 add.u64 %g1, %g0, %off1;
 add.u64 %g0, %g0, %off0;
 ld.global.u16 %v8, [%g0];
 ld.global.u16 %v9, [%g0+2];
 ld.global.u16 %v10, [%g1];
 ld.global.u16 %v11, [%g1+2];
 cvt.u64.u32 %g0, %ib3;
 add.u64 %g1, %g0, %off1;
 add.u64 %g0, %g0, %off0;
 ld.global.u16 %v12, [%g0];
 ld.global.u16 %v13, [%g0+2];
 ld.global.u16 %v14, [%g1];
 ld.global.u16 %v15, [%g1+2];

 // Pack the exact four FP8 k values for each pixel into the shared operand.
