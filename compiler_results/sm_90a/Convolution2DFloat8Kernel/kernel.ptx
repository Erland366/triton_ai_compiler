 cvt.rn.f16x2.f32 %v0, %a73, %a72;
 cvt.rn.f16x2.f32 %v1, %a75, %a74;
 cvt.rn.f16x2.f32 %v2, %a77, %a76;
 cvt.rn.f16x2.f32 %v3, %a79, %a78;
 add.u32 %r5, %r5, 16384;
 stmatrix.sync.aligned.m8n8.x4.shared.b16 [%r5], {%v0,%v1,%v2,%v3};
 xor.b32 %r5, %r4, 64;
 cvt.rn.f16x2.f32 %v0, %a17, %a16;
 cvt.rn.f16x2.f32 %v1, %a19, %a18;
