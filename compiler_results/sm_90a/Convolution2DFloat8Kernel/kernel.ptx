 prmt.b32 %v17, %v2, %v3, 0x5410;
 prmt.b32 %v18, %v16, %v17, %sel0;
 prmt.b32 %v19, %v16, %v17, %sel1;
 st.shared.b32 [%r16], %v18;
 st.shared.b32 [%r16+64], %v19;
 prmt.b32 %v16, %v4, %v5, 0x5410;
 prmt.b32 %v17, %v6, %v7, 0x5410;
 prmt.b32 %v18, %v16, %v17, %sel0;
 prmt.b32 %v19, %v16, %v17, %sel1;
 st.shared.b32 [%r16+2048], %v18;
 st.shared.b32 [%r16+2112], %v19;
 prmt.b32 %v16, %v8, %v9, 0x5410;
 prmt.b32 %v17, %v10, %v11, 0x5410;
 prmt.b32 %v18, %v16, %v17, %sel0;
 prmt.b32 %v19, %v16, %v17, %sel1;
 st.shared.b32 [%r16+4096], %v18;
 st.shared.b32 [%r16+4160], %v19;
 prmt.b32 %v16, %v12, %v13, 0x5410;
 prmt.b32 %v17, %v14, %v15, 0x5410;
 prmt.b32 %v18, %v16, %v17, %sel0;
 prmt.b32 %v19, %v16, %v17, %sel1;
 st.shared.b32 [%r16+6144], %v18;
 st.shared.b32 [%r16+6208], %v19;

 // Populate both k32 slices of the k64 stage.
 add.u32 %r22, %r22, 32;
 xor.b32 %r16, %r16, 32;
 add.u32 %r23, %r23, 1;
 setp.lt.u32 %p, %r23, 2;
 @%p bra INPUT_HALF;
 cp.async.wait_group 0;

 // Publish shared writes and finish the preceding asynchronous tensor-core group.
 fence.proxy.async.shared::cta;
 bar.sync 0;
 wgmma.wait_group.sync.aligned 0;
 setp.ne.u32 %use, %r14, 0;

 // Accumulate both 64-channel halves, initializing accumulators on the first stage.
 wgmma.mma_async.sync.aligned.m64n128k32.f32.e4m3.e4m3 {%a0,%a1,%a2,%a3,%a4,%a5,%a6,%a7,%a8,%a9,%a10,%a11,%a12,%a13,%a14,%a15,%a16,%a17,%a18,%a19,%a20,%a21,%a22,%a23,%a24,%a25,%a26,%a27,%a28,%a29,%a30,%a31,%a32,%a33,%a34,%a35,%a36,%a37,%a38,%a39,%a40,%a41,%a42,%a43,%a44,%a45,%a46,%a47,%a48,%a49,%a50,%a51,%a52,%a53,%a54,%a55,%a56,%a57,%a58,%a59,%a60,%a61,%a62,%a63}, %desc0, %desc2, %use, 1, 1;
 wgmma.mma_async.sync.aligned.m64n128k32.f32.e4m3.e4m3 {%a64,%a65,%a66,%a67,%a68,%a69,%a70,%a71,%a72,%a73,%a74,%a75,%a76,%a77,%a78,%a79,%a80,%a81,%a82,%a83,%a84,%a85,%a86,%a87,%a88,%a89,%a90,%a91,%a92,%a93,%a94,%a95,%a96,%a97,%a98,%a99,%a100,%a101,%a102,%a103,%a104,%a105,%a106,%a107,%a108,%a109,%a110,%a111,%a112,%a113,%a114,%a115,%a116,%a117,%a118,%a119,%a120,%a121,%a122,%a123,%a124,%a125,%a126,%a127}, %desc1, %desc2, %use, 1, 1;
 add.u64 %desc3, %desc0, 2;
 add.u64 %desc4, %desc1, 2;
 add.u64 %desc5, %desc2, 2;
 wgmma.mma_async.sync.aligned.m64n128k32.f32.e4m3.e4m3 {%a0,%a1,%a2,%a3,%a4,%a5,%a6,%a7,%a8,%a9,%a10,%a11,%a12,%a13,%a14,%a15,%a16,%a17,%a18,%a19,%a20,%a21,%a22,%a23,%a24,%a25,%a26,%a27,%a28,%a29,%a30,%a31,%a32,%a33,%a34,%a35,%a36,%a37,%a38,%a39,%a40,%a41,%a42,%a43,%a44,%a45,%a46,%a47,%a48,%a49,%a50,%a51,%a52,%a53,%a54,%a55,%a56,%a57,%a58,%a59,%a60,%a61,%a62,%a63}, %desc3, %desc5, 1, 1, 1;
 wgmma.mma_async.sync.aligned.m64n128k32.f32.e4m3.e4m3 {%a64,%a65,%a66,%a67,%a68,%a69,%a70,%a71,%a72,%a73,%a74,%a75,%a76,%a77,%a78,%a79,%a80,%a81,%a82,%a83,%a84,%a85,%a86,%a87,%a88,%a89,%a90,%a91,%a92,%a93,%a94,%a95,%a96,%a97,%a98,%a99,%a100,%a101,%a102,%a103,%a104,%a105,%a106,%a107,%a108,%a109,%a110,%a111,%a112,%a113,%a114,%a115,%a116,%a117,%a118,%a119,%a120,%a121,%a122,%a123,%a124,%a125,%a126,%a127}, %desc4, %desc5, 1, 1, 1;
 wgmma.commit_group.sync.aligned;

 // Alternate the two stages; nine iterations cover all 576 reduction elements.
 add.u32 %r14, %r14, 64;
 add.u64 %wg, %wg, 64;
 xor.b32 %r15, %r15, 16384;
 xor.b64 %desc0, %desc0, 1024;
 xor.b64 %desc1, %desc1, 1024;
 xor.b64 %desc2, %desc2, 1024;
 setp.lt.u32 %p, %r14, 576;
 @%p bra K_LOOP;
 wgmma.wait_group.sync.aligned 0;

 // Reuse the 32 KiB staging area for a swizzled FP16 epilogue.
 bar.sync 0;
 shr.u32 %r4, %r0, 5;
 shl.b32 %r4, %r4, 4;
 and.b32 %r5, %r0, 15;
 add.u32 %r4, %r4, %r5;
 and.b32 %r6, %r0, 16;
 mad.lo.u32 %r4, %r4, 256, %r6;
 and.b32 %r5, %r0, 7;
 shl.b32 %r5, %r5, 4;
 xor.b32 %r4, %r4, %r5;
 add.u32 %r4, %r4, %r3;

 // Convert accumulator fragments and scatter them with warp-level matrix stores.
 xor.b32 %r5, %r4, 0;
 cvt.rn.f16x2.f32 %v0, %a1, %a0;
 cvt.rn.f16x2.f32 %v1, %a3, %a2;
 cvt.rn.f16x2.f32 %v2, %a5, %a4;
 cvt.rn.f16x2.f32 %v3, %a7, %a6;
 stmatrix.sync.aligned.m8n8.x4.shared.b16 [%r5], {%v0,%v1,%v2,%v3};
 cvt.rn.f16x2.f32 %v0, %a65, %a64;
 cvt.rn.f16x2.f32 %v1, %a67, %a66;
 cvt.rn.f16x2.f32 %v2, %a69, %a68;
 cvt.rn.f16x2.f32 %v3, %a71, %a70;
 add.u32 %r5, %r5, 16384;
 stmatrix.sync.aligned.m8n8.x4.shared.b16 [%r5], {%v0,%v1,%v2,%v3};
 xor.b32 %r5, %r4, 32;
 cvt.rn.f16x2.f32 %v0, %a9, %a8;
 cvt.rn.f16x2.f32 %v1, %a11, %a10;
