.version 8.7
.target sm_90a
.address_size 64

.extern .shared .align 16 .b8 global_smem[];

.visible .entry kernel(
    .param .u64 x_ptr,
    .param .u64 output_ptr,
    .param .u64 dummy_ptr1,
    .param .u64 dummy_ptr2
)
{
    .reg .b32 %t, %b, %i, %a, %c, %o0, %o1;
    .reg .b64 %x, %y, %off, %xp, %yp;
    .reg .b16 %h<4>;
    .reg .f32 %f<4>;

    // Cover 1024 elements per CTA, four consecutive halves per thread.
    ld.param.u64 %x, [x_ptr];
    ld.param.u64 %y, [output_ptr];
    mov.u32 %t, %tid.x;
    mov.u32 %b, %ctaid.x;
    shl.b32 %i, %b, 10;
    mad.lo.u32 %i, %t, 4, %i;
    mul.wide.u32 %off, %i, 2;
    add.u64 %xp, %x, %off;
    add.u64 %yp, %y, %off;

    // Load four aligned halves; the full tile is valid without masking.
    ld.global.v2.b32 {%a, %c}, [%xp];
    mov.b32 {%h0, %h1}, %a;
    mov.b32 {%h2, %h3}, %c;
    cvt.f32.f16 %f0, %h0;
    cvt.f32.f16 %f1, %h1;
    cvt.f32.f16 %f2, %h2;
    cvt.f32.f16 %f3, %h3;

    // Scale by negative log2(e) and evaluate exp(-x) in float32.
    mul.f32 %f0, %f0, 0fBFB8AA3B;
    mul.f32 %f1, %f1, 0fBFB8AA3B;
    mul.f32 %f2, %f2, 0fBFB8AA3B;
    mul.f32 %f3, %f3, 0fBFB8AA3B;
    ex2.approx.f32 %f0, %f0;
    ex2.approx.f32 %f1, %f1;
    ex2.approx.f32 %f2, %f2;
    ex2.approx.f32 %f3, %f3;

    // Compute sigmoid as the reciprocal of one plus the exponential.
    add.f32 %f0, %f0, 0f3F800000;
    add.f32 %f1, %f1, 0f3F800000;
    add.f32 %f2, %f2, 0f3F800000;
    add.f32 %f3, %f3, 0f3F800000;
    rcp.approx.f32 %f0, %f0;
    rcp.approx.f32 %f1, %f1;
    rcp.approx.f32 %f2, %f2;
    rcp.approx.f32 %f3, %f3;

    // Round and pack pairs; the first source occupies the upper half.
    cvt.rn.f16x2.f32 %o0, %f1, %f0;
    cvt.rn.f16x2.f32 %o1, %f3, %f2;
    st.global.v2.b32 [%yp], {%o0, %o1};
    ret;
}
