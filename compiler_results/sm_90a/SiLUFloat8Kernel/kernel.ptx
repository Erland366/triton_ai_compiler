.version 8.7
.target sm_90a
.address_size 64

.extern .shared .align 16 .b8 global_smem[];

.visible .entry kernel(
    .param .u64 x_ptr,
    .param .u64 output_ptr,
    .param .u64 dummy_ptr1,
    .param .u64 dummy_ptr2
)
{
    .reg .b32 %r<12>;
    .reg .b64 %a<4>;
    .reg .b16 %h<12>;
    .reg .f32 %f<8>, %e<8>;

    // Each thread owns eight contiguous elements of the 1024-element tile.
    ld.param.u64 %a0, [x_ptr];
    ld.param.u64 %a1, [output_ptr];
    mov.u32 %r0, %ctaid.x;
    mov.u32 %r1, %tid.x;
    shl.b32 %r0, %r0, 10;
    mad.lo.u32 %r0, %r1, 8, %r0;
    mul.wide.u32 %a2, %r0, 1;
    mul.wide.u32 %a3, %r0, 2;
    add.u64 %a0, %a0, %a2;
    add.u64 %a1, %a1, %a3;

    // Vector load eight FP8 values and decode four pairs to FP16.
    ld.global.v2.b32 {%r2, %r3}, [%a0];
    mov.b32 {%h0, %h1}, %r2;
    mov.b32 {%h2, %h3}, %r3;
    cvt.rn.f16x2.e4m3x2 %r4, %h0;
    cvt.rn.f16x2.e4m3x2 %r5, %h1;
    cvt.rn.f16x2.e4m3x2 %r6, %h2;
    cvt.rn.f16x2.e4m3x2 %r7, %h3;
    mov.b32 {%h4, %h5}, %r4;
    mov.b32 {%h6, %h7}, %r5;
    mov.b32 {%h8, %h9}, %r6;
    mov.b32 {%h10, %h11}, %r7;

    // Promote to FP32 for the sigmoid calculation.
    cvt.f32.f16 %f0, %h4;
    cvt.f32.f16 %f1, %h5;
    cvt.f32.f16 %f2, %h6;
    cvt.f32.f16 %f3, %h7;
    cvt.f32.f16 %f4, %h8;
    cvt.f32.f16 %f5, %h9;
    cvt.f32.f16 %f6, %h10;
    cvt.f32.f16 %f7, %h11;

    // Compute exp(-x) with the base-two exponential unit.
    mul.f32 %e0, %f0, 0fBFB8AA3B;
    mul.f32 %e1, %f1, 0fBFB8AA3B;
    mul.f32 %e2, %f2, 0fBFB8AA3B;
    mul.f32 %e3, %f3, 0fBFB8AA3B;
    mul.f32 %e4, %f4, 0fBFB8AA3B;
    mul.f32 %e5, %f5, 0fBFB8AA3B;
    mul.f32 %e6, %f6, 0fBFB8AA3B;
    mul.f32 %e7, %f7, 0fBFB8AA3B;
    ex2.approx.f32 %e0, %e0;
    ex2.approx.f32 %e1, %e1;
    ex2.approx.f32 %e2, %e2;
    ex2.approx.f32 %e3, %e3;
    ex2.approx.f32 %e4, %e4;
    ex2.approx.f32 %e5, %e5;
    ex2.approx.f32 %e6, %e6;
    ex2.approx.f32 %e7, %e7;

    // Form the reciprocal sigmoid denominators.
    add.f32 %e0, %e0, 0f3F800000;
    add.f32 %e1, %e1, 0f3F800000;
    add.f32 %e2, %e2, 0f3F800000;
    add.f32 %e3, %e3, 0f3F800000;
    add.f32 %e4, %e4, 0f3F800000;
    add.f32 %e5, %e5, 0f3F800000;
    add.f32 %e6, %e6, 0f3F800000;
    add.f32 %e7, %e7, 0f3F800000;
    rcp.approx.f32 %e0, %e0;
    rcp.approx.f32 %e1, %e1;
    rcp.approx.f32 %e2, %e2;
    rcp.approx.f32 %e3, %e3;
    rcp.approx.f32 %e4, %e4;
    rcp.approx.f32 %e5, %e5;
    rcp.approx.f32 %e6, %e6;
    rcp.approx.f32 %e7, %e7;

    // Multiply by x and round each pair to FP16.
    mul.f32 %f0, %f0, %e0;
    mul.f32 %f1, %f1, %e1;
    mul.f32 %f2, %f2, %e2;
    mul.f32 %f3, %f3, %e3;
    mul.f32 %f4, %f4, %e4;
    mul.f32 %f5, %f5, %e5;
    mul.f32 %f6, %f6, %e6;
    mul.f32 %f7, %f7, %e7;
    cvt.rn.f16x2.f32 %r8, %f1, %f0;
    cvt.rn.f16x2.f32 %r9, %f3, %f2;
    cvt.rn.f16x2.f32 %r10, %f5, %f4;
    cvt.rn.f16x2.f32 %r11, %f7, %f6;

    // Store all eight outputs in one aligned vector operation.
    st.global.v4.b32 [%a1], {%r8, %r9, %r10, %r11};
    ret;
}
