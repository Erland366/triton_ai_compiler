.version 8.7
.target sm_90a
.address_size 64
.extern .shared .align 16 .b8 global_smem[];
.visible .entry kernel(
.param .u64 x_ptr,
.param .u64 output_ptr,
.param .u64 dummy_ptr1,
.param .u64 dummy_ptr2
){
.reg .b64 %xp,%op,%off,%xa,%oa;
.reg .b32 %lane,%pid,%idx,%v0,%v1;
.reg .b16 %h<4>;
.reg .f32 %x<4>,%a<4>,%t<4>,%p<4>,%e<4>,%s<4>,%y<4>;
.reg .pred %neg<4>;
// Each of 128 threads handles four consecutive halves in its 512-element CTA tile.
ld.param.u64 %xp,[x_ptr];
ld.param.u64 %op,[output_ptr];
mov.u32 %lane,%tid.x;
mov.u32 %pid,%ctaid.x;
shl.b32 %idx,%lane,2;
mad.lo.u32 %idx,%pid,512,%idx;
mul.wide.u32 %off,%idx,2;
add.u64 %xa,%xp,%off;
add.u64 %oa,%op,%off;
// Load eight aligned bytes and unpack four half values.
ld.global.v2.b32 {%v0,%v1},[%xa];
mov.b32 {%h0,%h1},%v0;
mov.b32 {%h2,%h3},%v1;
cvt.f32.f16 %x0,%h0;
cvt.f32.f16 %x1,%h1;
cvt.f32.f16 %x2,%h2;
cvt.f32.f16 %x3,%h3;
// Evaluate the erf approximation for the first value.
mul.f32 %s0,%x0,0.7071067811865476;
abs.f32 %a0,%s0;
fma.rn.f32 %t0,%a0,0.3275911,1.0;
rcp.approx.f32 %t0,%t0;
fma.rn.f32 %p0,%t0,1.061405429,-1.453152027;
fma.rn.f32 %p0,%p0,%t0,1.421413741;
fma.rn.f32 %p0,%p0,%t0,-0.284496736;
fma.rn.f32 %p0,%p0,%t0,0.254829592;
mul.f32 %p0,%p0,%t0;
mul.f32 %e0,%a0,%a0;
mul.f32 %e0,%e0,-1.4426950408889634;
ex2.approx.f32 %e0,%e0;
fma.rn.f32 %e0,%p0,%e0,-1.0;
setp.lt.f32 %neg0,%x0,0.0;
neg.f32 %s0,%e0;
selp.f32 %e0,%e0,%s0,%neg0;
add.f32 %e0,%e0,1.0;
mul.f32 %y0,%x0,0.5;
mul.f32 %y0,%y0,%e0;
cvt.rn.f16.f32 %h0,%y0;
// Evaluate the same float32 GELU for the second value.
mul.f32 %s1,%x1,0.7071067811865476;
abs.f32 %a1,%s1;
fma.rn.f32 %t1,%a1,0.3275911,1.0;
rcp.approx.f32 %t1,%t1;
fma.rn.f32 %p1,%t1,1.061405429,-1.453152027;
fma.rn.f32 %p1,%p1,%t1,1.421413741;
fma.rn.f32 %p1,%p1,%t1,-0.284496736;
fma.rn.f32 %p1,%p1,%t1,0.254829592;
mul.f32 %p1,%p1,%t1;
mul.f32 %e1,%a1,%a1;
mul.f32 %e1,%e1,-1.4426950408889634;
ex2.approx.f32 %e1,%e1;
fma.rn.f32 %e1,%p1,%e1,-1.0;
setp.lt.f32 %neg1,%x1,0.0;
neg.f32 %s1,%e1;
selp.f32 %e1,%e1,%s1,%neg1;
add.f32 %e1,%e1,1.0;
mul.f32 %y1,%x1,0.5;
mul.f32 %y1,%y1,%e1;
cvt.rn.f16.f32 %h1,%y1;
// Evaluate the same float32 GELU for the third value.
mul.f32 %s2,%x2,0.7071067811865476;
abs.f32 %a2,%s2;
fma.rn.f32 %t2,%a2,0.3275911,1.0;
rcp.approx.f32 %t2,%t2;
fma.rn.f32 %p2,%t2,1.061405429,-1.453152027;
fma.rn.f32 %p2,%p2,%t2,1.421413741;
fma.rn.f32 %p2,%p2,%t2,-0.284496736;
fma.rn.f32 %p2,%p2,%t2,0.254829592;
mul.f32 %p2,%p2,%t2;
mul.f32 %e2,%a2,%a2;
mul.f32 %e2,%e2,-1.4426950408889634;
ex2.approx.f32 %e2,%e2;
fma.rn.f32 %e2,%p2,%e2,-1.0;
setp.lt.f32 %neg2,%x2,0.0;
neg.f32 %s2,%e2;
selp.f32 %e2,%e2,%s2,%neg2;
add.f32 %e2,%e2,1.0;
mul.f32 %y2,%x2,0.5;
mul.f32 %y2,%y2,%e2;
cvt.rn.f16.f32 %h2,%y2;
// Evaluate the same float32 GELU for the fourth value.
mul.f32 %s3,%x3,0.7071067811865476;
abs.f32 %a3,%s3;
fma.rn.f32 %t3,%a3,0.3275911,1.0;
rcp.approx.f32 %t3,%t3;
fma.rn.f32 %p3,%t3,1.061405429,-1.453152027;
fma.rn.f32 %p3,%p3,%t3,1.421413741;
fma.rn.f32 %p3,%p3,%t3,-0.284496736;
fma.rn.f32 %p3,%p3,%t3,0.254829592;
mul.f32 %p3,%p3,%t3;
mul.f32 %e3,%a3,%a3;
mul.f32 %e3,%e3,-1.4426950408889634;
ex2.approx.f32 %e3,%e3;
fma.rn.f32 %e3,%p3,%e3,-1.0;
setp.lt.f32 %neg3,%x3,0.0;
neg.f32 %s3,%e3;
selp.f32 %e3,%e3,%s3,%neg3;
add.f32 %e3,%e3,1.0;
mul.f32 %y3,%x3,0.5;
mul.f32 %y3,%y3,%e3;
cvt.rn.f16.f32 %h3,%y3;
// Pack and store the complete tile without masks, matching the source kernel.
mov.b32 %v0,{%h0,%h1};
mov.b32 %v1,{%h2,%h3};
st.global.v2.b32 [%oa],{%v0,%v1};
ret;
}