.version 8.7
.target sm_90a
.address_size 64
.extern .shared .align 16 .b8 global_smem[];
.visible .entry kernel(.param .u64 x_ptr,.param .u64 output_ptr,.param .u64 dummy_ptr1,.param .u64 dummy_ptr2)
{
.reg .u64 %x,%y,%a,%b,%off;
.reg .u32 %t,%c,%i;
.reg .b32 %v<8>,%o<8>;
.reg .b16 %h<16>;
.reg .f32 %f<16>,%e<16>;
// Each lane owns eight adjacent halves in each of two 1024-element stripes.
ld.param.u64 %x,[x_ptr];
ld.param.u64 %y,[output_ptr];
mov.u32 %t,%tid.x;
mov.u32 %c,%ctaid.x;
shl.b32 %i,%c,12;
mad.lo.u32 %i,%t,16,%i;
cvt.u64.u32 %off,%i;
add.u64 %a,%x,%off;
add.u64 %b,%y,%off;
// Load both aligned vectors; the fixed tile requires no masks.
ld.global.v4.b32 {%v0,%v1,%v2,%v3},[%a];
ld.global.v4.b32 {%v4,%v5,%v6,%v7},[%a+2048];
// Unpack the half values and convert to float32.
mov.b32 {%h0,%h1},%v0;
mov.b32 {%h2,%h3},%v1;
mov.b32 {%h4,%h5},%v2;
mov.b32 {%h6,%h7},%v3;
mov.b32 {%h8,%h9},%v4;
mov.b32 {%h10,%h11},%v5;
mov.b32 {%h12,%h13},%v6;
mov.b32 {%h14,%h15},%v7;
cvt.f32.f16 %f0,%h0;
cvt.f32.f16 %f1,%h1;
cvt.f32.f16 %f2,%h2;
cvt.f32.f16 %f3,%h3;
cvt.f32.f16 %f4,%h4;
cvt.f32.f16 %f5,%h5;
cvt.f32.f16 %f6,%h6;
cvt.f32.f16 %f7,%h7;
cvt.f32.f16 %f8,%h8;
cvt.f32.f16 %f9,%h9;
cvt.f32.f16 %f10,%h10;
cvt.f32.f16 %f11,%h11;
cvt.f32.f16 %f12,%h12;
cvt.f32.f16 %f13,%h13;
cvt.f32.f16 %f14,%h14;
cvt.f32.f16 %f15,%h15;
// Scale by -log2(e) to evaluate exp(-x) with the base-two exponential.
mul.f32 %e0,%f0,0fBFB8AA3B;
mul.f32 %e1,%f1,0fBFB8AA3B;
mul.f32 %e2,%f2,0fBFB8AA3B;
mul.f32 %e3,%f3,0fBFB8AA3B;
mul.f32 %e4,%f4,0fBFB8AA3B;
mul.f32 %e5,%f5,0fBFB8AA3B;
mul.f32 %e6,%f6,0fBFB8AA3B;
mul.f32 %e7,%f7,0fBFB8AA3B;
mul.f32 %e8,%f8,0fBFB8AA3B;
mul.f32 %e9,%f9,0fBFB8AA3B;
mul.f32 %e10,%f10,0fBFB8AA3B;
mul.f32 %e11,%f11,0fBFB8AA3B;
mul.f32 %e12,%f12,0fBFB8AA3B;
mul.f32 %e13,%f13,0fBFB8AA3B;
mul.f32 %e14,%f14,0fBFB8AA3B;
mul.f32 %e15,%f15,0fBFB8AA3B;
ex2.approx.f32 %e0,%e0;
ex2.approx.f32 %e1,%e1;
ex2.approx.f32 %e2,%e2;
ex2.approx.f32 %e3,%e3;
ex2.approx.f32 %e4,%e4;
ex2.approx.f32 %e5,%e5;
ex2.approx.f32 %e6,%e6;
ex2.approx.f32 %e7,%e7;
ex2.approx.f32 %e8,%e8;
ex2.approx.f32 %e9,%e9;
ex2.approx.f32 %e10,%e10;
ex2.approx.f32 %e11,%e11;
ex2.approx.f32 %e12,%e12;
ex2.approx.f32 %e13,%e13;
ex2.approx.f32 %e14,%e14;
ex2.approx.f32 %e15,%e15;
// Form 1 + exp(-x) in float32.
add.f32 %e0,%e0,0f3F800000;
add.f32 %e1,%e1,0f3F800000;
add.f32 %e2,%e2,0f3F800000;
add.f32 %e3,%e3,0f3F800000;
add.f32 %e4,%e4,0f3F800000;
add.f32 %e5,%e5,0f3F800000;
add.f32 %e6,%e6,0f3F800000;
add.f32 %e7,%e7,0f3F800000;
add.f32 %e8,%e8,0f3F800000;
add.f32 %e9,%e9,0f3F800000;
add.f32 %e10,%e10,0f3F800000;
add.f32 %e11,%e11,0f3F800000;
add.f32 %e12,%e12,0f3F800000;
add.f32 %e13,%e13,0f3F800000;
add.f32 %e14,%e14,0f3F800000;
add.f32 %e15,%e15,0f3F800000;
// Take reciprocal denominators for the float32 division.
rcp.approx.f32 %e0,%e0;
rcp.approx.f32 %e1,%e1;
rcp.approx.f32 %e2,%e2;
rcp.approx.f32 %e3,%e3;
rcp.approx.f32 %e4,%e4;
rcp.approx.f32 %e5,%e5;
rcp.approx.f32 %e6,%e6;
rcp.approx.f32 %e7,%e7;
rcp.approx.f32 %e8,%e8;
rcp.approx.f32 %e9,%e9;
rcp.approx.f32 %e10,%e10;
rcp.approx.f32 %e11,%e11;
rcp.approx.f32 %e12,%e12;
rcp.approx.f32 %e13,%e13;
rcp.approx.f32 %e14,%e14;
rcp.approx.f32 %e15,%e15;
// Multiply by the original values to obtain SiLU.
mul.f32 %f0,%f0,%e0;
mul.f32 %f1,%f1,%e1;
mul.f32 %f2,%f2,%e2;
mul.f32 %f3,%f3,%e3;
mul.f32 %f4,%f4,%e4;
mul.f32 %f5,%f5,%e5;
mul.f32 %f6,%f6,%e6;
mul.f32 %f7,%f7,%e7;
mul.f32 %f8,%f8,%e8;
mul.f32 %f9,%f9,%e9;
mul.f32 %f10,%f10,%e10;
mul.f32 %f11,%f11,%e11;
mul.f32 %f12,%f12,%e12;
mul.f32 %f13,%f13,%e13;
mul.f32 %f14,%f14,%e14;
mul.f32 %f15,%f15,%e15;
// Round to half precision and pack adjacent values for vector stores.
cvt.rn.f16x2.f32 %o0,%f1,%f0;
cvt.rn.f16x2.f32 %o1,%f3,%f2;
cvt.rn.f16x2.f32 %o2,%f5,%f4;
cvt.rn.f16x2.f32 %o3,%f7,%f6;
cvt.rn.f16x2.f32 %o4,%f9,%f8;
cvt.rn.f16x2.f32 %o5,%f11,%f10;
cvt.rn.f16x2.f32 %o6,%f13,%f12;
cvt.rn.f16x2.f32 %o7,%f15,%f14;
// Store both stripes, covering exactly 2048 elements per CTA.
st.global.v4.b32 [%b],{%o0,%o1,%o2,%o3};
st.global.v4.b32 [%b+2048],{%o4,%o5,%o6,%o7};
ret;
}