.version 8.7
.target sm_90a
.address_size 64

.extern .shared .align 16 .b8 global_smem[];

.visible .entry kernel(
    .param .u64 a_ptr,
    .param .u64 b_ptr,
    .param .u64 d_ptr,
    .param .u64 c_ptr,
    .param .u64 dummy_ptr1,
    .param .u64 dummy_ptr2
)
.reqntid 128, 1, 1
{
    .reg .pred %p, %pa, %pn;
    .reg .b32 %r<40>, %b<24>;
    .reg .b64 %g<12>, %da<4>, %db, %desc;
    .reg .f32 %acc<128>, %f<24>;
    .reg .b16 %h<12>;

    // Each CTA computes its complete 256 by 64 output tile.
    mov.u32 %r0, %tid.x;
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ctaid.y;
    mov.u32 %r3, global_smem;
    ld.param.u64 %g0, [a_ptr];
    ld.param.u64 %g1, [b_ptr];
    ld.param.u64 %g2, [d_ptr];
    ld.param.u64 %g3, [c_ptr];
    shl.b32 %r4, %r1, 20;
    shl.b32 %r5, %r2, 6;
    add.u32 %r6, %r4, %r5;
    cvt.u64.u32 %g4, %r4;
    add.u64 %g0, %g0, %g4;
    cvt.u64.u32 %g4, %r5;
    add.u64 %g1, %g1, %g4;
    cvt.u64.u32 %g4, %r6;
    add.u64 %g2, %g2, %g4;
    shl.b64 %g4, %g4, 1;
    add.u64 %g3, %g3, %g4;

    // A uses 128-byte swizzled K-major rows and coalesced 16-byte copies.
    shr.u32 %r7, %r0, 3;
    and.b32 %r8, %r0, 7;
    shl.b32 %r8, %r8, 4;
    shl.b32 %r9, %r7, 12;
    add.u32 %r9, %r9, %r8;
    cvt.u64.u32 %g4, %r9;
    add.u64 %g0, %g0, %g4;
    and.b32 %r9, %r7, 7;
    shl.b32 %r9, %r9, 4;
    xor.b32 %r9, %r9, %r8;
    shl.b32 %r10, %r7, 7;
    add.u32 %r10, %r10, %r9;
    add.u32 %r10, %r10, %r3;

    // Raw B copies use 64-byte swizzling; ldmatrix transposes pairs of bytes.
    shr.u32 %r11, %r0, 2;
    shl.b32 %r11, %r11, 12;
    and.b32 %r12, %r0, 3;
    shl.b32 %r12, %r12, 4;
    add.u32 %r11, %r11, %r12;
    cvt.u64.u32 %g4, %r11;
    add.u64 %g1, %g1, %g4;
    shl.b32 %r11, %r0, 4;
    shr.u32 %r12, %r0, 3;
    and.b32 %r12, %r12, 3;
    shl.b32 %r12, %r12, 4;
    xor.b32 %r14, %r11, %r12;
    add.u32 %r14, %r14, 40960;
    add.u32 %r14, %r14, %r3;

    // Each warp transposes a 32 by 16 portion of B per matrix-load group.
    and.b32 %r11, %r0, 31;
    shr.u32 %r12, %r0, 5;
    shl.b32 %r12, %r12, 4;
    shl.b32 %r13, %r11, 6;
    add.u32 %r13, %r13, %r12;
    and.b32 %r15, %r11, 6;
    shl.b32 %r15, %r15, 3;
    xor.b32 %r15, %r13, %r15;
    add.u32 %r15, %r15, 40960;
    add.u32 %r15, %r15, %r3;
    shr.u32 %r13, %r11, 2;
    shl.b32 %r13, %r13, 1;
    add.u32 %r13, %r13, %r12;
    and.b32 %r12, %r11, 1;
    add.u32 %r13, %r13, %r12;
    setp.ne.u32 %pn, %r12, 0;
    selp.b32 %r17, 0x3175, 0x6420, %pn;
    and.b32 %r12, %r11, 2;
    shl.b32 %r12, %r12, 1;
    and.b32 %r16, %r13, 7;
    shl.b32 %r16, %r16, 4;
    xor.b32 %r16, %r16, %r12;
    shl.b32 %r13, %r13, 7;
    add.u32 %r16, %r16, %r13;
    add.u32 %r16, %r16, 32768;
    add.u32 %r16, %r16, %r3;

    // Two 49152-byte stages fit in the fixed dynamic shared-memory allocation.
    shr.u32 %r18, %r3, 4;
    cvt.u64.u32 %desc, %r18;
    or.b64 %desc, %desc, 0x4000004000010000;
    mov.u32 %r19, 0;
    mov.u32 %r25, 0;
    wgmma.fence.sync.aligned;

    // Prime A and two consecutive raw B tiles.
    cp.async.cg.shared.global [%r10+0], [%g0+0], 16;
    cp.async.cg.shared.global [%r10+2048], [%g0+65536], 16;
    cp.async.cg.shared.global [%r10+4096], [%g0+131072], 16;
    cp.async.cg.shared.global [%r10+6144], [%g0+196608], 16;
    cp.async.cg.shared.global [%r10+8192], [%g0+262144], 16;
    cp.async.cg.shared.global [%r10+10240], [%g0+327680], 16;
    cp.async.cg.shared.global [%r10+12288], [%g0+393216], 16;
    cp.async.cg.shared.global [%r10+14336], [%g0+458752], 16;
    cp.async.cg.shared.global [%r10+16384], [%g0+524288], 16;
    cp.async.cg.shared.global [%r10+18432], [%g0+589824], 16;
    cp.async.cg.shared.global [%r10+20480], [%g0+655360], 16;
    cp.async.cg.shared.global [%r10+22528], [%g0+720896], 16;
    cp.async.cg.shared.global [%r10+24576], [%g0+786432], 16;
    cp.async.cg.shared.global [%r10+26624], [%g0+851968], 16;
    cp.async.cg.shared.global [%r10+28672], [%g0+917504], 16;
    cp.async.cg.shared.global [%r10+30720], [%g0+983040], 16;
    cp.async.cg.shared.global [%r14+0], [%g1+0], 16;
    cp.async.cg.shared.global [%r14+2048], [%g1+131072], 16;
    cp.async.cg.shared.global [%r14+4096], [%g1+262144], 16;
    cp.async.cg.shared.global [%r14+6144], [%g1+393216], 16;
    cp.async.cg.shared.global [%r14+49152], [%g1+524288], 16;
    cp.async.cg.shared.global [%r14+51200], [%g1+655360], 16;
    cp.async.cg.shared.global [%r14+53248], [%g1+786432], 16;
    cp.async.cg.shared.global [%r14+55296], [%g1+917504], 16;
    cp.async.commit_group;
    cp.async.wait_group 0;
    bar.sync 0;
    add.u64 %g1, %g1, 1048576;

PREPARE_B:
    // Select the prefetched raw B tile and its transposed destination.
    add.u32 %r29, %r15, %r25;
    add.u32 %r30, %r16, %r25;

    // Load the complete raw B tile before shuffling its byte pairs.
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b0, %b1, %b2, %b3}, [%r29+0];
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b4, %b5, %b6, %b7}, [%r29+2048];
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b8, %b9, %b10, %b11}, [%r29+4096];
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b12, %b13, %b14, %b15}, [%r29+6144];
    shfl.sync.bfly.b32 %b16, %b0, 1, 31, 0xffffffff;
    prmt.b32 %b0, %b0, %b16, %r17;
    xor.b32 %r21, %r30, 0;
    st.shared.b32 [%r21], %b0;
    shfl.sync.bfly.b32 %b16, %b1, 1, 31, 0xffffffff;
    prmt.b32 %b1, %b1, %b16, %r17;
    xor.b32 %r21, %r30, 8;
    st.shared.b32 [%r21], %b1;
    shfl.sync.bfly.b32 %b16, %b2, 1, 31, 0xffffffff;
    prmt.b32 %b2, %b2, %b16, %r17;
    xor.b32 %r21, %r30, 16;
    st.shared.b32 [%r21], %b2;
    shfl.sync.bfly.b32 %b16, %b3, 1, 31, 0xffffffff;
    prmt.b32 %b3, %b3, %b16, %r17;
    xor.b32 %r21, %r30, 24;
    st.shared.b32 [%r21], %b3;
    shfl.sync.bfly.b32 %b16, %b4, 1, 31, 0xffffffff;
    prmt.b32 %b4, %b4, %b16, %r17;
    xor.b32 %r21, %r30, 32;
    st.shared.b32 [%r21], %b4;
    shfl.sync.bfly.b32 %b16, %b5, 1, 31, 0xffffffff;
    prmt.b32 %b5, %b5, %b16, %r17;
    xor.b32 %r21, %r30, 40;
    st.shared.b32 [%r21], %b5;
    shfl.sync.bfly.b32 %b16, %b6, 1, 31, 0xffffffff;
    prmt.b32 %b6, %b6, %b16, %r17;
    xor.b32 %r21, %r30, 48;
    st.shared.b32 [%r21], %b6;
    shfl.sync.bfly.b32 %b16, %b7, 1, 31, 0xffffffff;
    prmt.b32 %b7, %b7, %b16, %r17;
    xor.b32 %r21, %r30, 56;
    st.shared.b32 [%r21], %b7;
    shfl.sync.bfly.b32 %b16, %b8, 1, 31, 0xffffffff;
    prmt.b32 %b8, %b8, %b16, %r17;
    xor.b32 %r21, %r30, 64;
    st.shared.b32 [%r21], %b8;
    shfl.sync.bfly.b32 %b16, %b9, 1, 31, 0xffffffff;
    prmt.b32 %b9, %b9, %b16, %r17;
    xor.b32 %r21, %r30, 72;
    st.shared.b32 [%r21], %b9;
    shfl.sync.bfly.b32 %b16, %b10, 1, 31, 0xffffffff;
    prmt.b32 %b10, %b10, %b16, %r17;
    xor.b32 %r21, %r30, 80;
    st.shared.b32 [%r21], %b10;
    shfl.sync.bfly.b32 %b16, %b11, 1, 31, 0xffffffff;
    prmt.b32 %b11, %b11, %b16, %r17;
    xor.b32 %r21, %r30, 88;
    st.shared.b32 [%r21], %b11;
    shfl.sync.bfly.b32 %b16, %b12, 1, 31, 0xffffffff;
    prmt.b32 %b12, %b12, %b16, %r17;
    xor.b32 %r21, %r30, 96;
    st.shared.b32 [%r21], %b12;
    shfl.sync.bfly.b32 %b16, %b13, 1, 31, 0xffffffff;
    prmt.b32 %b13, %b13, %b16, %r17;
    xor.b32 %r21, %r30, 104;
    st.shared.b32 [%r21], %b13;
    shfl.sync.bfly.b32 %b16, %b14, 1, 31, 0xffffffff;
    prmt.b32 %b14, %b14, %b16, %r17;
    xor.b32 %r21, %r30, 112;
    st.shared.b32 [%r21], %b14;
    shfl.sync.bfly.b32 %b16, %b15, 1, 31, 0xffffffff;
    prmt.b32 %b15, %b15, %b16, %r17;
    xor.b32 %r21, %r30, 120;
    st.shared.b32 [%r21], %b15;

    // A transfers overlap this transpose and the preceding tensor-core work.
    cp.async.wait_group 0;
    fence.proxy.async.shared::cta;
    wgmma.wait_group.sync.aligned 0;
    bar.sync 0;

    // Compute C transpose as B transpose times A transpose using m64n256.
    shr.u32 %r18, %r25, 4;
    cvt.u64.u32 %g4, %r18;
    add.u64 %db, %desc, %g4;
    add.u64 %da0, %db, 2048;
    setp.ne.u32 %pa, %r19, 0;
    wgmma.mma_async.sync.aligned.m64n256k32.f32.e4m3.e4m3 {%acc0, %acc1, %acc2, %acc3, %acc4, %acc5, %acc6, %acc7, %acc8, %acc9, %acc10, %acc11, %acc12, %acc13, %acc14, %acc15, %acc16, %acc17, %acc18, %acc19, %acc20, %acc21, %acc22, %acc23, %acc24, %acc25, %acc26, %acc27, %acc28, %acc29, %acc30, %acc31, %acc32, %acc33, %acc34, %acc35, %acc36, %acc37, %acc38, %acc39, %acc40, %acc41, %acc42, %acc43, %acc44, %acc45, %acc46, %acc47, %acc48, %acc49, %acc50, %acc51, %acc52, %acc53, %acc54, %acc55, %acc56, %acc57, %acc58, %acc59, %acc60, %acc61, %acc62, %acc63, %acc64, %acc65, %acc66, %acc67, %acc68, %acc69, %acc70, %acc71, %acc72, %acc73, %acc74, %acc75, %acc76, %acc77, %acc78, %acc79, %acc80, %acc81, %acc82, %acc83, %acc84, %acc85, %acc86, %acc87, %acc88, %acc89, %acc90, %acc91, %acc92, %acc93, %acc94, %acc95, %acc96, %acc97, %acc98, %acc99, %acc100, %acc101, %acc102, %acc103, %acc104, %acc105, %acc106, %acc107, %acc108, %acc109, %acc110, %acc111, %acc112, %acc113, %acc114, %acc115, %acc116, %acc117, %acc118, %acc119, %acc120, %acc121, %acc122, %acc123, %acc124, %acc125, %acc126, %acc127}, %da0, %db, %pa, 1, 1;
    add.u64 %da0, %da0, 2;
    add.u64 %db, %db, 2;
    wgmma.mma_async.sync.aligned.m64n256k32.f32.e4m3.e4m3 {%acc0, %acc1, %acc2, %acc3, %acc4, %acc5, %acc6, %acc7, %acc8, %acc9, %acc10, %acc11, %acc12, %acc13, %acc14, %acc15, %acc16, %acc17, %acc18, %acc19, %acc20, %acc21, %acc22, %acc23, %acc24, %acc25, %acc26, %acc27, %acc28, %acc29, %acc30, %acc31, %acc32, %acc33, %acc34, %acc35, %acc36, %acc37, %acc38, %acc39, %acc40, %acc41, %acc42, %acc43, %acc44, %acc45, %acc46, %acc47, %acc48, %acc49, %acc50, %acc51, %acc52, %acc53, %acc54, %acc55, %acc56, %acc57, %acc58, %acc59, %acc60, %acc61, %acc62, %acc63, %acc64, %acc65, %acc66, %acc67, %acc68, %acc69, %acc70, %acc71, %acc72, %acc73, %acc74, %acc75, %acc76, %acc77, %acc78, %acc79, %acc80, %acc81, %acc82, %acc83, %acc84, %acc85, %acc86, %acc87, %acc88, %acc89, %acc90, %acc91, %acc92, %acc93, %acc94, %acc95, %acc96, %acc97, %acc98, %acc99, %acc100, %acc101, %acc102, %acc103, %acc104, %acc105, %acc106, %acc107, %acc108, %acc109, %acc110, %acc111, %acc112, %acc113, %acc114, %acc115, %acc116, %acc117, %acc118, %acc119, %acc120, %acc121, %acc122, %acc123, %acc124, %acc125, %acc126, %acc127}, %da0, %db, 1, 1, 1;
    add.u64 %da0, %da0, 2;
    add.u64 %db, %db, 2;
    wgmma.mma_async.sync.aligned.m64n256k32.f32.e4m3.e4m3 {%acc0, %acc1, %acc2, %acc3, %acc4, %acc5, %acc6, %acc7, %acc8, %acc9, %acc10, %acc11, %acc12, %acc13, %acc14, %acc15, %acc16, %acc17, %acc18, %acc19, %acc20, %acc21, %acc22, %acc23, %acc24, %acc25, %acc26, %acc27, %acc28, %acc29, %acc30, %acc31, %acc32, %acc33, %acc34, %acc35, %acc36, %acc37, %acc38, %acc39, %acc40, %acc41, %acc42, %acc43, %acc44, %acc45, %acc46, %acc47, %acc48, %acc49, %acc50, %acc51, %acc52, %acc53, %acc54, %acc55, %acc56, %acc57, %acc58, %acc59, %acc60, %acc61, %acc62, %acc63, %acc64, %acc65, %acc66, %acc67, %acc68, %acc69, %acc70, %acc71, %acc72, %acc73, %acc74, %acc75, %acc76, %acc77, %acc78, %acc79, %acc80, %acc81, %acc82, %acc83, %acc84, %acc85, %acc86, %acc87, %acc88, %acc89, %acc90, %acc91, %acc92, %acc93, %acc94, %acc95, %acc96, %acc97, %acc98, %acc99, %acc100, %acc101, %acc102, %acc103, %acc104, %acc105, %acc106, %acc107, %acc108, %acc109, %acc110, %acc111, %acc112, %acc113, %acc114, %acc115, %acc116, %acc117, %acc118, %acc119, %acc120, %acc121, %acc122, %acc123, %acc124, %acc125, %acc126, %acc127}, %da0, %db, 1, 1, 1;
    add.u64 %da0, %da0, 2;
    add.u64 %db, %db, 2;
    wgmma.mma_async.sync.aligned.m64n256k32.f32.e4m3.e4m3 {%acc0, %acc1, %acc2, %acc3, %acc4, %acc5, %acc6, %acc7, %acc8, %acc9, %acc10, %acc11, %acc12, %acc13, %acc14, %acc15, %acc16, %acc17, %acc18, %acc19, %acc20, %acc21, %acc22, %acc23, %acc24, %acc25, %acc26, %acc27, %acc28, %acc29, %acc30, %acc31, %acc32, %acc33, %acc34, %acc35, %acc36, %acc37, %acc38, %acc39, %acc40, %acc41, %acc42, %acc43, %acc44, %acc45, %acc46, %acc47, %acc48, %acc49, %acc50, %acc51, %acc52, %acc53, %acc54, %acc55, %acc56, %acc57, %acc58, %acc59, %acc60, %acc61, %acc62, %acc63, %acc64, %acc65, %acc66, %acc67, %acc68, %acc69, %acc70, %acc71, %acc72, %acc73, %acc74, %acc75, %acc76, %acc77, %acc78, %acc79, %acc80, %acc81, %acc82, %acc83, %acc84, %acc85, %acc86, %acc87, %acc88, %acc89, %acc90, %acc91, %acc92, %acc93, %acc94, %acc95, %acc96, %acc97, %acc98, %acc99, %acc100, %acc101, %acc102, %acc103, %acc104, %acc105, %acc106, %acc107, %acc108, %acc109, %acc110, %acc111, %acc112, %acc113, %acc114, %acc115, %acc116, %acc117, %acc118, %acc119, %acc120, %acc121, %acc122, %acc123, %acc124, %acc125, %acc126, %acc127}, %da0, %db, 1, 1, 1;
    wgmma.commit_group.sync.aligned;

    // Prefetch A one tile ahead and raw B two tiles ahead.
    setp.eq.u32 %p, %r19, 3968;
    @%p bra REDUCTION_DONE;
    sub.u32 %r26, 49152, %r25;
    add.u32 %r27, %r10, %r26;
    add.u32 %r28, %r14, %r25;
    add.u64 %g0, %g0, 128;
    cp.async.cg.shared.global [%r27+0], [%g0+0], 16;
    cp.async.cg.shared.global [%r27+2048], [%g0+65536], 16;
    cp.async.cg.shared.global [%r27+4096], [%g0+131072], 16;
    cp.async.cg.shared.global [%r27+6144], [%g0+196608], 16;
    cp.async.cg.shared.global [%r27+8192], [%g0+262144], 16;
    cp.async.cg.shared.global [%r27+10240], [%g0+327680], 16;
    cp.async.cg.shared.global [%r27+12288], [%g0+393216], 16;
    cp.async.cg.shared.global [%r27+14336], [%g0+458752], 16;
    cp.async.cg.shared.global [%r27+16384], [%g0+524288], 16;
    cp.async.cg.shared.global [%r27+18432], [%g0+589824], 16;
    cp.async.cg.shared.global [%r27+20480], [%g0+655360], 16;
    cp.async.cg.shared.global [%r27+22528], [%g0+720896], 16;
    cp.async.cg.shared.global [%r27+24576], [%g0+786432], 16;
    cp.async.cg.shared.global [%r27+26624], [%g0+851968], 16;
    cp.async.cg.shared.global [%r27+28672], [%g0+917504], 16;
    cp.async.cg.shared.global [%r27+30720], [%g0+983040], 16;
    setp.lt.u32 %p, %r19, 3840;
    @%p cp.async.cg.shared.global [%r28+0], [%g1+0], 16;
    @%p cp.async.cg.shared.global [%r28+2048], [%g1+131072], 16;
    @%p cp.async.cg.shared.global [%r28+4096], [%g1+262144], 16;
    @%p cp.async.cg.shared.global [%r28+6144], [%g1+393216], 16;
    cp.async.commit_group;
    add.u64 %g1, %g1, 524288;
    mov.u32 %r25, %r26;
    add.u32 %r19, %r19, 128;
    bra PREPARE_B;

REDUCTION_DONE:
    // Complete all tensor-core reads before reusing shared memory.
    wgmma.wait_group.sync.aligned 0;
    bar.sync 0;

    // Store transposed accumulator fragments in a swizzled row-major workspace.
    shr.u32 %r7, %r0, 5;
    shl.b32 %r7, %r7, 4;
    and.b32 %r8, %r0, 31;
    shr.u32 %r8, %r8, 2;
    add.u32 %r7, %r7, %r8;
    and.b32 %r8, %r0, 3;
    shl.b32 %r9, %r8, 3;
    xor.b32 %r7, %r7, %r9;
    shl.b32 %r8, %r8, 9;
    shl.b32 %r7, %r7, 2;
    add.u32 %r10, %r7, %r8;
    add.u32 %r10, %r10, %r3;
    xor.b32 %r11, %r10, 32;
    st.shared.f32 [%r10+0], %acc0;
    st.shared.f32 [%r10+256], %acc1;
    st.shared.f32 [%r11+0], %acc2;
    st.shared.f32 [%r11+256], %acc3;
    st.shared.f32 [%r10+2048], %acc4;
    st.shared.f32 [%r10+2304], %acc5;
    st.shared.f32 [%r11+2048], %acc6;
    st.shared.f32 [%r11+2304], %acc7;
    st.shared.f32 [%r10+4096], %acc8;
    st.shared.f32 [%r10+4352], %acc9;
    st.shared.f32 [%r11+4096], %acc10;
    st.shared.f32 [%r11+4352], %acc11;
    st.shared.f32 [%r10+6144], %acc12;
    st.shared.f32 [%r10+6400], %acc13;
