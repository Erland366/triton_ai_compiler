.version 8.7
.target sm_100a
.address_size 64

.extern .shared .align 16 .b8 global_smem[];

.visible .entry kernel(
    .param .u64 a_ptr,
    .param .u64 x_ptr,
    .param .u64 y_ptr,
    .param .u64 dummy_ptr1,
    .param .u64 dummy_ptr2
)
{
    .reg .pred %p<5>;
    .reg .b32 %r<32>, %s<8>, %q<8>, %a<32>, %b<16>;
    .reg .b64 %rd<8>;
    .reg .f32 %c<16>, %f<2>;
    .reg .b16 %h<2>;

    // The CTA owns 32 rows; each copy warp loads one contiguous row slice.
    ld.param.u64 %rd0, [a_ptr];
    ld.param.u64 %rd1, [x_ptr];
    ld.param.u64 %rd2, [y_ptr];
    mov.u32 %r0, %tid.x;
    mov.u32 %r1, %ctaid.x;
    shr.u32 %r2, %r0, 5;
    and.b32 %r3, %r0, 31;
    mad.lo.u32 %r4, %r1, 32, %r2;
    mul.wide.u32 %rd3, %r4, 8192;
    mul.wide.u32 %rd4, %r3, 16;
    add.u64 %rd0, %rd0, %rd3;
    add.u64 %rd6, %rd0, %rd4;
    mul.wide.u32 %rd4, %r0, 4;
    add.u64 %rd7, %rd1, %rd4;
    mov.u32 %r5, global_smem;
    xor.b32 %r6, %r3, %r2;
    shl.b32 %r6, %r6, 4;
    mad.lo.u32 %r6, %r2, 512, %r6;

    // Reorder vector pairs in shared memory for four-wide B fragment loads.
    and.b32 %r7, %r0, 112;
    shl.b32 %r7, %r7, 2;
    and.b32 %r8, %r0, 3;
    shl.b32 %r8, %r8, 4;
    add.u32 %r7, %r7, %r8;
    and.b32 %r8, %r0, 12;
    add.u32 %r7, %r7, %r8;
    add.u32 %r7, %r7, 16384;

    // Two warp pairs split both M and K within each 32 by 256 tile.
    and.b32 %r8, %r2, 1;
    shl.b32 %r8, %r8, 4;
    and.b32 %r9, %r3, 15;
    add.u32 %r9, %r9, %r8;
    shl.b32 %r10, %r9, 9;
    and.b32 %r11, %r9, 7;
    shl.b32 %r11, %r11, 4;
    shr.u32 %r12, %r2, 1;
    shl.b32 %r12, %r12, 8;
    shr.u32 %r13, %r3, 4;
    shl.b32 %r13, %r13, 4;
    add.u32 %r13, %r13, %r12;
    xor.b32 %r13, %r13, %r11;
    add.u32 %r13, %r13, %r10;
    and.b32 %r14, %r3, 3;
    shl.b32 %r15, %r14, 4;
    add.u32 %r15, %r15, %r12;
    add.u32 %r15, %r15, 16384;

    // Four independent FP32 accumulation chains hide tensor-core latency.
    mov.f32 %c0, 0f00000000;
    mov.f32 %c1, 0f00000000;
    mov.f32 %c2, 0f00000000;
    mov.f32 %c3, 0f00000000;
    mov.f32 %c4, 0f00000000;
    mov.f32 %c5, 0f00000000;
    mov.f32 %c6, 0f00000000;
    mov.f32 %c7, 0f00000000;
    mov.f32 %c8, 0f00000000;
    mov.f32 %c9, 0f00000000;
    mov.f32 %c10, 0f00000000;
    mov.f32 %c11, 0f00000000;
    mov.f32 %c12, 0f00000000;
    mov.f32 %c13, 0f00000000;
    mov.f32 %c14, 0f00000000;
    mov.f32 %c15, 0f00000000;
    mov.u32 %r16, 0;
    mov.u32 %r17, 0;
    and.b32 %r24, %r1, 15;

PREFETCH:
    // Rotate K-tile order by CTA while visiting each input column exactly once.
    setp.lt.u32 %p0, %r16, 16;
    @!%p0 bra COMMIT;
    add.u32 %r25, %r16, %r24;
    and.b32 %r25, %r25, 15;
    mul.wide.u32 %rd4, %r25, 512;
    add.u64 %rd0, %rd6, %rd4;
    add.u64 %rd1, %rd7, %rd4;

    // Eight 16896-byte stages exactly fill the 135168-byte dynamic allocation.
    and.b32 %r18, %r16, 7;
    mad.lo.u32 %r18, %r18, 16896, %r5;
    add.u32 %s0, %r6, %r18;
    xor.b32 %r19, %r6, 64;
    add.u32 %r19, %r19, 2048;
    add.u32 %s1, %r19, %r18;
    add.u32 %s2, %s0, 4096;
    add.u32 %s3, %s1, 4096;
    add.u32 %s4, %s0, 8192;
    add.u32 %s5, %s1, 8192;
    add.u32 %s6, %s0, 12288;
    add.u32 %s7, %s1, 12288;

    // Copy swizzled A rows and the packed vector using explicit addresses.
    cp.async.cg.shared.global [%s0], [%rd0], 16;
    add.u64 %rd5, %rd0, 32768;
    cp.async.cg.shared.global [%s1], [%rd5], 16;
    add.u64 %rd5, %rd0, 65536;
    cp.async.cg.shared.global [%s2], [%rd5], 16;
    add.u64 %rd5, %rd0, 98304;
    cp.async.cg.shared.global [%s3], [%rd5], 16;
    add.u64 %rd5, %rd0, 131072;
    cp.async.cg.shared.global [%s4], [%rd5], 16;
    add.u64 %rd5, %rd0, 163840;
    cp.async.cg.shared.global [%s5], [%rd5], 16;
    add.u64 %rd5, %rd0, 196608;
    cp.async.cg.shared.global [%s6], [%rd5], 16;
    add.u64 %rd5, %rd0, 229376;
    cp.async.cg.shared.global [%s7], [%rd5], 16;
    add.u32 %r19, %r7, %r18;
    cp.async.ca.shared.global [%r19], [%rd1], 4;

COMMIT:
    // Empty tail groups safely drain the same eight-stage pipeline.
    cp.async.commit_group;
    add.u32 %r16, %r16, 1;
    setp.lt.u32 %p0, %r16, 8;
    @%p0 bra PREFETCH;
    cp.async.wait_group 7;
    bar.sync 0;

    // Assemble explicit shared addresses for eight consecutive A fragments.
    and.b32 %r18, %r17, 7;
    mad.lo.u32 %r18, %r18, 16896, %r5;
    add.u32 %q0, %r13, %r18;
    xor.b32 %r19, %r13, 32;
    add.u32 %q1, %r19, %r18;
    xor.b32 %r19, %r13, 64;
    add.u32 %q2, %r19, %r18;
    xor.b32 %r19, %r13, 96;
    add.u32 %q3, %r19, %r18;
    add.u32 %q4, %q0, 128;
    add.u32 %q5, %q1, 128;
    add.u32 %q6, %q2, 128;
    add.u32 %q7, %q3, 128;
    add.u32 %r20, %r15, %r18;

    // Read the bank-swizzled matrix and the register-packed vector fragments.
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a0,%a1,%a2,%a3}, [%q0];
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a4,%a5,%a6,%a7}, [%q1];
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a8,%a9,%a10,%a11}, [%q2];
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a12,%a13,%a14,%a15}, [%q3];
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a16,%a17,%a18,%a19}, [%q4];
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a20,%a21,%a22,%a23}, [%q5];
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a24,%a25,%a26,%a27}, [%q6];
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%a28,%a29,%a30,%a31}, [%q7];
    ld.shared.v4.b32 {%b0,%b1,%b2,%b3}, [%r20];
    ld.shared.v4.b32 {%b4,%b5,%b6,%b7}, [%r20+64];
    ld.shared.v4.b32 {%b8,%b9,%b10,%b11}, [%r20+128];
    ld.shared.v4.b32 {%b12,%b13,%b14,%b15}, [%r20+192];

    // Accumulate every 16-column fragment in the warp's 128-column slice.
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c0,%c1,%c2,%c3}, {%a0,%a1,%a2,%a3}, {%b0,%b1}, {%c0,%c1,%c2,%c3};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c4,%c5,%c6,%c7}, {%a4,%a5,%a6,%a7}, {%b2,%b3}, {%c4,%c5,%c6,%c7};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c8,%c9,%c10,%c11}, {%a8,%a9,%a10,%a11}, {%b4,%b5}, {%c8,%c9,%c10,%c11};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c12,%c13,%c14,%c15}, {%a12,%a13,%a14,%a15}, {%b6,%b7}, {%c12,%c13,%c14,%c15};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c0,%c1,%c2,%c3}, {%a16,%a17,%a18,%a19}, {%b8,%b9}, {%c0,%c1,%c2,%c3};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c4,%c5,%c6,%c7}, {%a20,%a21,%a22,%a23}, {%b10,%b11}, {%c4,%c5,%c6,%c7};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c8,%c9,%c10,%c11}, {%a24,%a25,%a26,%a27}, {%b12,%b13}, {%c8,%c9,%c10,%c11};
    mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%c12,%c13,%c14,%c15}, {%a28,%a29,%a30,%a31}, {%b14,%b15}, {%c12,%c13,%c14,%c15};

    // No stage is overwritten until all warp readers are finished.
    bar.sync 0;
    add.u32 %r17, %r17, 1;
    setp.lt.u32 %p0, %r17, 16;
    @%p0 bra PREFETCH;
    cp.async.wait_group 0;

    // Merge the four chains, then exchange the two warp K partitions.
    add.f32 %c0, %c0, %c4;
    add.f32 %c8, %c8, %c12;
    add.f32 %c0, %c0, %c8;
    add.f32 %c2, %c2, %c6;
    add.f32 %c10, %c10, %c14;
    add.f32 %c2, %c2, %c10;
    shr.u32 %r21, %r3, 2;
    shl.b32 %r22, %r2, 6;
    mad.lo.u32 %r22, %r21, 4, %r22;
    add.u32 %r22, %r22, %r5;
    setp.eq.u32 %p1, %r14, 0;
    @%p1 st.shared.f32 [%r22], %c0;
    @%p1 st.shared.f32 [%r22+32], %c2;
    bar.sync 0;
    setp.lt.u32 %p2, %r2, 2;
    and.pred %p3, %p1, %p2;
    @!%p3 bra DONE;
    ld.shared.f32 %f0, [%r22+128];
    ld.shared.f32 %f1, [%r22+160];
    add.f32 %f0, %c0, %f0;
    add.f32 %f1, %c2, %f1;

    // One selected lane stores each row's rounded half-precision result.
    cvt.rn.f16.f32 %h0, %f0;
    cvt.rn.f16.f32 %h1, %f1;
    mad.lo.u32 %r23, %r1, 32, %r8;
    add.u32 %r23, %r23, %r21;
    mul.wide.u32 %rd6, %r23, 2;
    add.u64 %rd6, %rd6, %rd2;
    st.global.b16 [%rd6], %h0;
    st.global.b16 [%rd6+16], %h1;
DONE:
    ret;
}
