.version 8.7
.target sm_100a
.address_size 64

.extern .shared .align 16 .b8 global_smem[];

.visible .entry kernel(
    .param .u64 Q_ptr,
    .param .u64 K_ptr,
    .param .u64 V_ptr,
    .param .u64 Bias_ptr,
    .param .u64 Out_ptr,
    .param .u64 Lse_ptr,
    .param .u64 TMP_ptr,
    .param .u64 dummy_ptr1,
    .param .u64 dummy_ptr2
)
.reqntid 128
.maxnreg 80
{
.reg .pred %pred;
.reg .b32 %r<32>, %q<4>, %b<4>, %p<8>;
.reg .b64 %rd<16>, %pair, %sc<2>, %ss;
.reg .f32 %s<16>, %o<32>, %m<2>, %l<2>, %mx<2>, %z<2>, %t<8>, %norm<2>;

// Each warp owns sixteen query rows; four lanes cooperate per row.
mov.u32 %r0, %tid.x;
mov.u32 %r1, %ctaid.x;
mov.u32 %r2, %ctaid.y;
and.b32 %r3, %r0, 31;
shr.u32 %r4, %r0, 5;
shr.u32 %r5, %r3, 2;
and.b32 %r6, %r3, 3;
mad.lo.u32 %r7, %r4, 16, %r5;
mov.u32 %r8, global_smem;
ld.param.u64 %rd0, [Q_ptr];
ld.param.u64 %rd1, [K_ptr];
ld.param.u64 %rd2, [V_ptr];
ld.param.u64 %rd3, [Out_ptr];
ld.param.u64 %rd4, [Lse_ptr];
mul.wide.u32 %rd5, %r2, 16384;
add.u64 %rd0, %rd0, %rd5;
add.u64 %rd1, %rd1, %rd5;
add.u64 %rd2, %rd2, %rd5;
add.u64 %rd3, %rd3, %rd5;
mul.wide.u32 %rd10, %r1, 8192;
add.u64 %rd10, %rd3, %rd10;
mul.wide.u32 %rd6, %r1, 8192;
add.u64 %rd0, %rd0, %rd6;

// Shared layout: Q at 0, two K slots at 8192, all V at 16384.
// All accesses stay below byte 32768; the fixed dimensions need no masks.
shl.b32 %r10, %r0, 4;
and.b32 %r11, %r0, 56;
shl.b32 %r11, %r11, 1;
xor.b32 %r12, %r10, %r11;
add.u32 %r12, %r12, %r8;
add.u32 %r13, %r12, 16384;
add.u32 %r26, %r12, 8192;
cvt.u64.u32 %rd6, %r10;
add.u64 %rd7, %rd1, %rd6;
add.u64 %rd8, %rd2, %rd6;
add.u64 %rd12, %rd0, %rd6;
cp.async.cg.shared.global [%r12], [%rd12], 16;
cp.async.cg.shared.global [%r26], [%rd7], 16;
cp.async.cg.shared.global [%r12+2048], [%rd12+2048], 16;
cp.async.cg.shared.global [%r26+2048], [%rd7+2048], 16;
cp.async.cg.shared.global [%r12+4096], [%rd12+4096], 16;
cp.async.cg.shared.global [%r26+4096], [%rd7+4096], 16;
cp.async.cg.shared.global [%r12+6144], [%rd12+6144], 16;
cp.async.cg.shared.global [%r26+6144], [%rd7+6144], 16;
cp.async.cg.shared.global [%r13], [%rd8], 16;
cp.async.cg.shared.global [%r13+2048], [%rd8+2048], 16;
cp.async.cg.shared.global [%r13+4096], [%rd8+4096], 16;
cp.async.cg.shared.global [%r13+6144], [%rd8+6144], 16;
cp.async.cg.shared.global [%r13+8192], [%rd8+8192], 16;
cp.async.cg.shared.global [%r13+10240], [%rd8+10240], 16;
cp.async.cg.shared.global [%r13+12288], [%rd8+12288], 16;
cp.async.cg.shared.global [%r13+14336], [%rd8+14336], 16;
cp.async.commit_group;

// Form bank-swizzled matrix-load addresses for Q, K, and V.
and.b32 %r14, %r3, 7;
and.b32 %r15, %r3, 16;
shr.u32 %r15, %r15, 1;
add.u32 %r15, %r15, %r14;
shl.b32 %r15, %r15, 7;
and.b32 %r16, %r3, 8;
shl.b32 %r16, %r16, 1;
or.b32 %r15, %r15, %r16;
shl.b32 %r14, %r14, 4;
xor.b32 %r15, %r15, %r14;
and.b32 %r16, %r3, 15;
shl.b32 %r16, %r16, 7;
and.b32 %r17, %r3, 16;
or.b32 %r16, %r16, %r17;
xor.b32 %r16, %r16, %r14;
shl.b32 %r27, %r4, 11;
add.u32 %r27, %r27, %r8;

// Initialize online statistics and FP32 output accumulators.
mov.u32 %r18, 0;
mov.f32 %m0, 0fFF800000; mov.f32 %m1, 0fFF800000;
mov.f32 %l0, 0fFF800000; mov.f32 %l1, 0fFF800000;
mov.f32 %o0, 0f00000000; mov.f32 %o1, 0f00000000;
mov.f32 %o2, 0f00000000; mov.f32 %o3, 0f00000000;
mov.f32 %o4, 0f00000000; mov.f32 %o5, 0f00000000;
mov.f32 %o6, 0f00000000; mov.f32 %o7, 0f00000000;
mov.f32 %o8, 0f00000000; mov.f32 %o9, 0f00000000;
mov.f32 %o10, 0f00000000; mov.f32 %o11, 0f00000000;
mov.f32 %o12, 0f00000000; mov.f32 %o13, 0f00000000;
mov.f32 %o14, 0f00000000; mov.f32 %o15, 0f00000000;
mov.f32 %o16, 0f00000000; mov.f32 %o17, 0f00000000;
mov.f32 %o18, 0f00000000; mov.f32 %o19, 0f00000000;
mov.f32 %o20, 0f00000000; mov.f32 %o21, 0f00000000;
mov.f32 %o22, 0f00000000; mov.f32 %o23, 0f00000000;
mov.f32 %o24, 0f00000000; mov.f32 %o25, 0f00000000;
mov.f32 %o26, 0f00000000; mov.f32 %o27, 0f00000000;
mov.f32 %o28, 0f00000000; mov.f32 %o29, 0f00000000;
mov.f32 %o30, 0f00000000; mov.f32 %o31, 0f00000000;

TILE:
// Wait for staged data before reading the K ring buffer.
cp.async.wait_group 0;
bar.sync 0;
and.b32 %r19, %r18, 4096;
add.u32 %r19, %r19, 8192;
add.u32 %r19, %r19, %r8;

// Compute Q K-transpose; Q fragments are live only during this product.
mov.f32 %s0, 0f00000000; mov.f32 %s1, 0f00000000;
mov.f32 %s2, 0f00000000; mov.f32 %s3, 0f00000000;
mov.f32 %s4, 0f00000000; mov.f32 %s5, 0f00000000;
mov.f32 %s6, 0f00000000; mov.f32 %s7, 0f00000000;
mov.f32 %s8, 0f00000000; mov.f32 %s9, 0f00000000;
mov.f32 %s10, 0f00000000; mov.f32 %s11, 0f00000000;
mov.f32 %s12, 0f00000000; mov.f32 %s13, 0f00000000;
mov.f32 %s14, 0f00000000; mov.f32 %s15, 0f00000000;
add.u32 %r20, %r16, %r27;
ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%q0,%q1,%q2,%q3}, [%r20];
add.u32 %r20, %r15, %r19;
ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%b0,%b1,%b2,%b3}, [%r20];
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%s0,%s1,%s2,%s3}, {%q0,%q1,%q2,%q3}, {%b0,%b1}, {%s0,%s1,%s2,%s3};
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%s4,%s5,%s6,%s7}, {%q0,%q1,%q2,%q3}, {%b2,%b3}, {%s4,%s5,%s6,%s7};
add.u32 %r20, %r20, 2048;
ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%b0,%b1,%b2,%b3}, [%r20];
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%s8,%s9,%s10,%s11}, {%q0,%q1,%q2,%q3}, {%b0,%b1}, {%s8,%s9,%s10,%s11};
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%s12,%s13,%s14,%s15}, {%q0,%q1,%q2,%q3}, {%b2,%b3}, {%s12,%s13,%s14,%s15};
xor.b32 %r20, %r16, 32;
add.u32 %r20, %r20, %r27;
ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%q0,%q1,%q2,%q3}, [%r20];
xor.b32 %r20, %r15, 32;
add.u32 %r20, %r20, %r19;
ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%b0,%b1,%b2,%b3}, [%r20];
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%s0,%s1,%s2,%s3}, {%q0,%q1,%q2,%q3}, {%b0,%b1}, {%s0,%s1,%s2,%s3};
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%s4,%s5,%s6,%s7}, {%q0,%q1,%q2,%q3}, {%b2,%b3}, {%s4,%s5,%s6,%s7};
add.u32 %r20, %r20, 2048;
ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%b0,%b1,%b2,%b3}, [%r20];
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%s8,%s9,%s10,%s11}, {%q0,%q1,%q2,%q3}, {%b0,%b1}, {%s8,%s9,%s10,%s11};
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%s12,%s13,%s14,%s15}, {%q0,%q1,%q2,%q3}, {%b2,%b3}, {%s12,%s13,%s14,%s15};
xor.b32 %r20, %r16, 64;
add.u32 %r20, %r20, %r27;
ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%q0,%q1,%q2,%q3}, [%r20];
xor.b32 %r20, %r15, 64;
add.u32 %r20, %r20, %r19;
ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%b0,%b1,%b2,%b3}, [%r20];
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%s0,%s1,%s2,%s3}, {%q0,%q1,%q2,%q3}, {%b0,%b1}, {%s0,%s1,%s2,%s3};
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%s4,%s5,%s6,%s7}, {%q0,%q1,%q2,%q3}, {%b2,%b3}, {%s4,%s5,%s6,%s7};
add.u32 %r20, %r20, 2048;
ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%b0,%b1,%b2,%b3}, [%r20];
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%s8,%s9,%s10,%s11}, {%q0,%q1,%q2,%q3}, {%b0,%b1}, {%s8,%s9,%s10,%s11};
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%s12,%s13,%s14,%s15}, {%q0,%q1,%q2,%q3}, {%b2,%b3}, {%s12,%s13,%s14,%s15};
xor.b32 %r20, %r16, 96;
add.u32 %r20, %r20, %r27;
ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%q0,%q1,%q2,%q3}, [%r20];
xor.b32 %r20, %r15, 96;
add.u32 %r20, %r20, %r19;
ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%b0,%b1,%b2,%b3}, [%r20];
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%s0,%s1,%s2,%s3}, {%q0,%q1,%q2,%q3}, {%b0,%b1}, {%s0,%s1,%s2,%s3};
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%s4,%s5,%s6,%s7}, {%q0,%q1,%q2,%q3}, {%b2,%b3}, {%s4,%s5,%s6,%s7};
add.u32 %r20, %r20, 2048;
ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%b0,%b1,%b2,%b3}, [%r20];
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%s8,%s9,%s10,%s11}, {%q0,%q1,%q2,%q3}, {%b0,%b1}, {%s8,%s9,%s10,%s11};
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%s12,%s13,%s14,%s15}, {%q0,%q1,%q2,%q3}, {%b2,%b3}, {%s12,%s13,%s14,%s15};

// Refill the consumed K slot while softmax and P V execute.
bar.sync 0;
setp.lt.u32 %pred, %r18, 8192;
and.b32 %r26, %r18, 4096;
add.u32 %r26, %r26, 8192;
add.u32 %r26, %r26, %r12;
add.u32 %r28, %r18, 8192;
cvt.u64.u32 %rd12, %r28;
add.u64 %rd12, %rd12, %rd7;
@%pred cp.async.cg.shared.global [%r26], [%rd12], 16;
@%pred cp.async.cg.shared.global [%r26+2048], [%rd12+2048], 16;
cp.async.commit_group;

// Balanced row maxima; running maxima and LSE use base-two units.
max.f32 %t0, %s0, %s1; max.f32 %t1, %s4, %s5;
max.f32 %t2, %s8, %s9; max.f32 %t3, %s12, %s13;
max.f32 %t0, %t0, %t1; max.f32 %t2, %t2, %t3;
max.f32 %mx0, %t0, %t2;
shfl.sync.bfly.b32 %t0, %mx0, 2, 31, -1; max.f32 %mx0, %mx0, %t0;
shfl.sync.bfly.b32 %t0, %mx0, 1, 31, -1; max.f32 %mx0, %mx0, %t0;
mul.f32 %mx0, %mx0, 0f3E38AA3B;
max.f32 %mx0, %mx0, %l0;
neg.f32 %z0, %mx0;
max.f32 %t0, %s2, %s3; max.f32 %t1, %s6, %s7;
max.f32 %t2, %s10, %s11; max.f32 %t3, %s14, %s15;
max.f32 %t0, %t0, %t1; max.f32 %t2, %t2, %t3;
max.f32 %mx1, %t0, %t2;
shfl.sync.bfly.b32 %t0, %mx1, 2, 31, -1; max.f32 %mx1, %mx1, %t0;
shfl.sync.bfly.b32 %t0, %mx1, 1, 31, -1; max.f32 %mx1, %mx1, %t0;
mul.f32 %mx1, %mx1, 0f3E38AA3B;
max.f32 %mx1, %mx1, %l1;
neg.f32 %z1, %mx1;

// Packed FP32 affine transforms followed by approximate exponentials.
mov.b64 %sc0, {%z0,%z0}; mov.b64 %sc1, {%z1,%z1};
mov.b64 %ss, 0x3E38AA3B3E38AA3B;
mov.b64 %pair, {%s0,%s1}; fma.rn.f32x2 %pair, %pair, %ss, %sc0; mov.b64 {%s0,%s1}, %pair;
ex2.approx.f32 %s0, %s0; ex2.approx.f32 %s1, %s1;
mov.b64 %pair, {%s2,%s3}; fma.rn.f32x2 %pair, %pair, %ss, %sc1; mov.b64 {%s2,%s3}, %pair;
ex2.approx.f32 %s2, %s2; ex2.approx.f32 %s3, %s3;
mov.b64 %pair, {%s4,%s5}; fma.rn.f32x2 %pair, %pair, %ss, %sc0; mov.b64 {%s4,%s5}, %pair;
ex2.approx.f32 %s4, %s4; ex2.approx.f32 %s5, %s5;
mov.b64 %pair, {%s6,%s7}; fma.rn.f32x2 %pair, %pair, %ss, %sc1; mov.b64 {%s6,%s7}, %pair;
ex2.approx.f32 %s6, %s6; ex2.approx.f32 %s7, %s7;
mov.b64 %pair, {%s8,%s9}; fma.rn.f32x2 %pair, %pair, %ss, %sc0; mov.b64 {%s8,%s9}, %pair;
ex2.approx.f32 %s8, %s8; ex2.approx.f32 %s9, %s9;
mov.b64 %pair, {%s10,%s11}; fma.rn.f32x2 %pair, %pair, %ss, %sc1; mov.b64 {%s10,%s11}, %pair;
ex2.approx.f32 %s10, %s10; ex2.approx.f32 %s11, %s11;
mov.b64 %pair, {%s12,%s13}; fma.rn.f32x2 %pair, %pair, %ss, %sc0; mov.b64 {%s12,%s13}, %pair;
ex2.approx.f32 %s12, %s12; ex2.approx.f32 %s13, %s13;
mov.b64 %pair, {%s14,%s15}; fma.rn.f32x2 %pair, %pair, %ss, %sc1; mov.b64 {%s14,%s15}, %pair;
ex2.approx.f32 %s14, %s14; ex2.approx.f32 %s15, %s15;

// Rescale the accumulated output to the current row maximum.
sub.f32 %t0, %m0, %mx0; ex2.approx.f32 %t0, %t0; mov.f32 %m0, %mx0;
sub.f32 %t1, %m1, %mx1; ex2.approx.f32 %t1, %t1; mov.f32 %m1, %mx1;
mov.b64 %sc0, {%t0,%t0}; mov.b64 %sc1, {%t1,%t1};
mov.b64 %pair, {%o0,%o1}; mul.f32x2 %pair, %pair, %sc0; mov.b64 {%o0,%o1}, %pair;
mov.b64 %pair, {%o2,%o3}; mul.f32x2 %pair, %pair, %sc1; mov.b64 {%o2,%o3}, %pair;
mov.b64 %pair, {%o4,%o5}; mul.f32x2 %pair, %pair, %sc0; mov.b64 {%o4,%o5}, %pair;
mov.b64 %pair, {%o6,%o7}; mul.f32x2 %pair, %pair, %sc1; mov.b64 {%o6,%o7}, %pair;
mov.b64 %pair, {%o8,%o9}; mul.f32x2 %pair, %pair, %sc0; mov.b64 {%o8,%o9}, %pair;
mov.b64 %pair, {%o10,%o11}; mul.f32x2 %pair, %pair, %sc1; mov.b64 {%o10,%o11}, %pair;
mov.b64 %pair, {%o12,%o13}; mul.f32x2 %pair, %pair, %sc0; mov.b64 {%o12,%o13}, %pair;
mov.b64 %pair, {%o14,%o15}; mul.f32x2 %pair, %pair, %sc1; mov.b64 {%o14,%o15}, %pair;
mov.b64 %pair, {%o16,%o17}; mul.f32x2 %pair, %pair, %sc0; mov.b64 {%o16,%o17}, %pair;
mov.b64 %pair, {%o18,%o19}; mul.f32x2 %pair, %pair, %sc1; mov.b64 {%o18,%o19}, %pair;
mov.b64 %pair, {%o20,%o21}; mul.f32x2 %pair, %pair, %sc0; mov.b64 {%o20,%o21}, %pair;
mov.b64 %pair, {%o22,%o23}; mul.f32x2 %pair, %pair, %sc1; mov.b64 {%o22,%o23}, %pair;
mov.b64 %pair, {%o24,%o25}; mul.f32x2 %pair, %pair, %sc0; mov.b64 {%o24,%o25}, %pair;
mov.b64 %pair, {%o26,%o27}; mul.f32x2 %pair, %pair, %sc1; mov.b64 {%o26,%o27}, %pair;
mov.b64 %pair, {%o28,%o29}; mul.f32x2 %pair, %pair, %sc0; mov.b64 {%o28,%o29}, %pair;
mov.b64 %pair, {%o30,%o31}; mul.f32x2 %pair, %pair, %sc1; mov.b64 {%o30,%o31}, %pair;

// Balanced sums update LSE before probabilities are rounded to half.
add.f32 %t0, %s0, %s1; add.f32 %t1, %s4, %s5;
add.f32 %t2, %s8, %s9; add.f32 %t3, %s12, %s13;
add.f32 %t0, %t0, %t1; add.f32 %t2, %t2, %t3;
add.f32 %z0, %t0, %t2;
shfl.sync.bfly.b32 %t0, %z0, 2, 31, -1; add.f32 %z0, %z0, %t0;
shfl.sync.bfly.b32 %t0, %z0, 1, 31, -1; add.f32 %z0, %z0, %t0;
sub.f32 %t0, %l0, %mx0; ex2.approx.f32 %t0, %t0;
add.f32 %norm0, %t0, %z0;
lg2.approx.f32 %t0, %norm0;
add.f32 %l0, %t0, %mx0;
add.f32 %t0, %s2, %s3; add.f32 %t1, %s6, %s7;
add.f32 %t2, %s10, %s11; add.f32 %t3, %s14, %s15;
add.f32 %t0, %t0, %t1; add.f32 %t2, %t2, %t3;
add.f32 %z1, %t0, %t2;
shfl.sync.bfly.b32 %t0, %z1, 2, 31, -1; add.f32 %z1, %z1, %t0;
shfl.sync.bfly.b32 %t0, %z1, 1, 31, -1; add.f32 %z1, %z1, %t0;
sub.f32 %t0, %l1, %mx1; ex2.approx.f32 %t0, %t0;
add.f32 %norm1, %t0, %z1;
lg2.approx.f32 %t0, %norm1;
add.f32 %l1, %t0, %mx1;

// Rounded probabilities directly supply A fragments for P V.
cvt.rn.f16x2.f32 %p0, %s1, %s0; cvt.rn.f16x2.f32 %p1, %s3, %s2;
cvt.rn.f16x2.f32 %p2, %s5, %s4; cvt.rn.f16x2.f32 %p3, %s7, %s6;
cvt.rn.f16x2.f32 %p4, %s9, %s8; cvt.rn.f16x2.f32 %p5, %s11, %s10;
cvt.rn.f16x2.f32 %p6, %s13, %s12; cvt.rn.f16x2.f32 %p7, %s15, %s14;
add.u32 %r19, %r18, 16384;
add.u32 %r19, %r19, %r8;
add.u32 %r20, %r16, %r19;
ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b0,%b1,%b2,%b3}, [%r20];
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%o0,%o1,%o2,%o3}, {%p0,%p1,%p2,%p3}, {%b0,%b1}, {%o0,%o1,%o2,%o3};
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%o4,%o5,%o6,%o7}, {%p0,%p1,%p2,%p3}, {%b2,%b3}, {%o4,%o5,%o6,%o7};
xor.b32 %r20, %r16, 32;
add.u32 %r20, %r20, %r19;
ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b0,%b1,%b2,%b3}, [%r20];
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%o8,%o9,%o10,%o11}, {%p0,%p1,%p2,%p3}, {%b0,%b1}, {%o8,%o9,%o10,%o11};
