cvt.rn.f16x2.f32 %p6, %s13, %s12;
cvt.rn.f16x2.f32 %p7, %s15, %s14;

// Select zero accumulator operands for the initial PV product.
@%first bra PV_INITIAL;
xor.b32 %addr, %av, 0;
