xor.b32 %addr, %av, 96;
stmatrix.sync.aligned.m8n8.x4.shared.b16 [%addr], {%pp12, %pp13, %pp14, %pp15};
bar.warp.sync -1;

// Reload and store four fully coalesced 16-byte vectors per thread.
shl.b32 %copy, %lane, 4;
mad.lo.u32 %copy, %warp, 2048, %copy;
mad.lo.u32 %tmp, %tile, 8192, %copy;
cvt.u64.u32 %off, %tmp;
add.u64 %go, %O, %off;
shr.u32 %sw, %lane, 3;
shl.b32 %sw, %sw, 4;
xor.b32 %av, %copy, %sw;
add.u32 %av, %av, %sm;
xor.b32 %addr, %av, 0;
ld.shared.v4.b32 {%b0, %b1, %b2, %b3}, [%addr+0];
st.global.v4.b32 [%go+0], {%b0, %b1, %b2, %b3};
