mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%o24, %o25, %o26, %o27}, {%p4, %p5, %p6, %p7}, {%b0, %b1}, {%o24, %o25, %o26, %o27};
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%o28, %o29, %o30, %o31}, {%p4, %p5, %p6, %p7}, {%b2, %b3}, {%o28, %o29, %o30, %o31};

// Advance across four complete, unmasked key tiles.
add.u32 %ak, %ak, 4096;
add.u32 %av, %av, 4096;
add.u32 %n, %n, 1;
setp.lt.u32 %loop, %n, 4;
@%loop bra KEY_TILE;

// Normalize and store natural-log LSE once per query row.
setp.eq.u32 %leader, %quad, 0;
sub.f32 %z0, %m0, %l0;
ex2.approx.ftz.f32 %z0, %z0;
mul.f32 %l0, %l0, 0f3f317218;
@%leader st.global.f32 [%gl+0], %l0;
sub.f32 %z1, %m1, %l1;
ex2.approx.ftz.f32 %z1, %z1;
mul.f32 %l1, %l1, 0f3f317218;
@%leader st.global.f32 [%gl+32], %l1;

// Pack normalized outputs for a coalesced epilogue.
mov.b64 %zz0, {%z0, %z0};
mov.b64 %zz1, {%z1, %z1};
mov.b64 %v0, {%o0, %o1}; mul.f32x2 %v0, %v0, %zz0; mov.b64 {%o0, %o1}, %v0; cvt.rn.f16x2.f32 %pp0, %o1, %o0;
mov.b64 %v0, {%o2, %o3}; mul.f32x2 %v0, %v0, %zz1; mov.b64 {%o2, %o3}, %v0; cvt.rn.f16x2.f32 %pp1, %o3, %o2;
mov.b64 %v0, {%o4, %o5}; mul.f32x2 %v0, %v0, %zz0; mov.b64 {%o4, %o5}, %v0; cvt.rn.f16x2.f32 %pp2, %o5, %o4;
mov.b64 %v0, {%o6, %o7}; mul.f32x2 %v0, %v0, %zz1; mov.b64 {%o6, %o7}, %v0; cvt.rn.f16x2.f32 %pp3, %o7, %o6;
mov.b64 %v0, {%o8, %o9}; mul.f32x2 %v0, %v0, %zz0; mov.b64 {%o8, %o9}, %v0; cvt.rn.f16x2.f32 %pp4, %o9, %o8;
mov.b64 %v0, {%o10, %o11}; mul.f32x2 %v0, %v0, %zz1; mov.b64 {%o10, %o11}, %v0; cvt.rn.f16x2.f32 %pp5, %o11, %o10;
mov.b64 %v0, {%o12, %o13}; mul.f32x2 %v0, %v0, %zz0; mov.b64 {%o12, %o13}, %v0; cvt.rn.f16x2.f32 %pp6, %o13, %o12;
mov.b64 %v0, {%o14, %o15}; mul.f32x2 %v0, %v0, %zz1; mov.b64 {%o14, %o15}, %v0; cvt.rn.f16x2.f32 %pp7, %o15, %o14;
mov.b64 %v0, {%o16, %o17}; mul.f32x2 %v0, %v0, %zz0; mov.b64 {%o16, %o17}, %v0; cvt.rn.f16x2.f32 %pp8, %o17, %o16;
mov.b64 %v0, {%o18, %o19}; mul.f32x2 %v0, %v0, %zz1; mov.b64 {%o18, %o19}, %v0; cvt.rn.f16x2.f32 %pp9, %o19, %o18;
mov.b64 %v0, {%o20, %o21}; mul.f32x2 %v0, %v0, %zz0; mov.b64 {%o20, %o21}, %v0; cvt.rn.f16x2.f32 %pp10, %o21, %o20;
mov.b64 %v0, {%o22, %o23}; mul.f32x2 %v0, %v0, %zz1; mov.b64 {%o22, %o23}, %v0; cvt.rn.f16x2.f32 %pp11, %o23, %o22;
mov.b64 %v0, {%o24, %o25}; mul.f32x2 %v0, %v0, %zz0; mov.b64 {%o24, %o25}, %v0; cvt.rn.f16x2.f32 %pp12, %o25, %o24;
