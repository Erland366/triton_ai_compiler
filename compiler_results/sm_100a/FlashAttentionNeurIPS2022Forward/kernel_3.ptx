mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%o24, %o25, %o26, %o27}, {%p0, %p1, %p2, %p3}, {%b0, %b1}, {%o24, %o25, %o26, %o27};
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%o28, %o29, %o30, %o31}, {%p0, %p1, %p2, %p3}, {%b2, %b3}, {%o28, %o29, %o30, %o31};
bra PV_SECOND;
PV_INITIAL:
// Initialize every output fragment from the first sixteen keys.
xor.b32 %addr, %av, 0;
ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b0, %b1, %b2, %b3}, [%addr];
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%o0, %o1, %o2, %o3}, {%p0, %p1, %p2, %p3}, {%b0, %b1}, {%zero, %zero, %zero, %zero};
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%o4, %o5, %o6, %o7}, {%p0, %p1, %p2, %p3}, {%b2, %b3}, {%zero, %zero, %zero, %zero};
xor.b32 %addr, %av, 32;
ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%b0, %b1, %b2, %b3}, [%addr];
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%o8, %o9, %o10, %o11}, {%p0, %p1, %p2, %p3}, {%b0, %b1}, {%zero, %zero, %zero, %zero};
mma.sync.aligned.m16n8k16.row.col.f32.f16.f16.f32 {%o12, %o13, %o14, %o15}, {%p0, %p1, %p2, %p3}, {%b2, %b3}, {%zero, %zero, %zero, %zero};
