mov.b64 %v0, {%o28, %o29}; mul.f32x2 %v0, %v0, %zz0; mov.b64 {%o28, %o29}, %v0; cvt.rn.f16x2.f32 %pp14, %o29, %o28;
mov.b64 %v0, {%o30, %o31}; mul.f32x2 %v0, %v0, %zz1; mov.b64 {%o30, %o31}, %v0; cvt.rn.f16x2.f32 %pp15, %o31, %o30;

// Keys 0..63 were retired earlier; reuse their bytes without another CTA barrier.
and.b32 %tmp, %lane, 7;
shl.b32 %sw, %tmp, 4;
and.b32 %addr, %lane, 15;
shl.b32 %addr, %addr, 7;
mad.lo.u32 %addr, %warp, 2048, %addr;
and.b32 %tmp, %lane, 16;
xor.b32 %tmp, %tmp, %sw;
add.u32 %av, %addr, %tmp;
add.u32 %av, %av, %sm;
xor.b32 %addr, %av, 0;
stmatrix.sync.aligned.m8n8.x4.shared.b16 [%addr], {%pp0, %pp1, %pp2, %pp3};
xor.b32 %addr, %av, 32;
stmatrix.sync.aligned.m8n8.x4.shared.b16 [%addr], {%pp4, %pp5, %pp6, %pp7};
