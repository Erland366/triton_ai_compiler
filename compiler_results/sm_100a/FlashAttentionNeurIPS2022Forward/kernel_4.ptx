    cp.async.cg.shared.global [%r10], [%rd9], 16;
    cp.async.cg.shared.global [%r10+2048], [%rd9+2048], 16;
    cp.async.cg.shared.global [%r10+4096], [%rd9+4096], 16;
    cp.async.cg.shared.global [%r10+6144], [%rd9+6144], 16;
    cp.async.cg.shared.global [%r10+8192], [%rd7], 16;
    cp.async.cg.shared.global [%r10+10240], [%rd7+2048], 16;
    cp.async.cg.shared.global [%r10+12288], [%rd7+4096], 16;
    cp.async.cg.shared.global [%r10+14336], [%rd7+6144], 16;
    cp.async.cg.shared.global [%r10+16384], [%rd7+8192], 16;
    cp.async.cg.shared.global [%r10+18432], [%rd7+10240], 16;
    cp.async.cg.shared.global [%r10+20480], [%rd7+12288], 16;
    cp.async.cg.shared.global [%r10+22528], [%rd7+14336], 16;
    cp.async.cg.shared.global [%r10+24576], [%rd8], 16;
    cp.async.cg.shared.global [%r10+26624], [%rd8+2048], 16;
    cp.async.cg.shared.global [%r10+28672], [%rd8+4096], 16;
    cp.async.cg.shared.global [%r10+30720], [%rd8+6144], 16;
