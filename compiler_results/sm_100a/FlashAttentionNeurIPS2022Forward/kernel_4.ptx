    add.u64 %rd12, %rd12, 2;
    add.u64 %rd13, %rd13, 2;
    tcgen05.mma.cta_group::1.kind::f16 [%r24], %rd12, %rd13, %r23, {%r25, %r25, %r25, %r25}, %pred0;
    add.u64 %rd12, %rd12, 2;
    add.u64 %rd13, %rd13, 2;
    tcgen05.mma.cta_group::1.kind::f16 [%r24], %rd12, %rd13, %r23, {%r25, %r25, %r25, %r25}, %pred0;
    add.u64 %rd12, %rd12, 2;
    add.u64 %rd13, %rd13, 2;
    tcgen05.mma.cta_group::1.kind::f16 [%r24], %rd12, %rd13, %r23, {%r25, %r25, %r25, %r25}, %pred0;
    tcgen05.commit.cta_group::1.mbarrier::arrive::one.shared::cluster.b64 [%r20];

SCORE_WAIT:
    // Wait for the complete score product before reusing query storage.
    mbarrier.try_wait.parity.acquire.cta.shared::cta.b64 %pred0, [%r20], 0;
    @!%pred0 bra SCORE_WAIT;
    tcgen05.fence::after_thread_sync;

    // Overlap loading values 64..127 with processing the first two score tiles.
    cp.async.cg.shared.global [%r10], [%rd8+8192], 16;
    cp.async.cg.shared.global [%r10+2048], [%rd8+10240], 16;
    cp.async.cg.shared.global [%r10+4096], [%rd8+12288], 16;
    cp.async.cg.shared.global [%r10+6144], [%rd8+14336], 16;
    cp.async.commit_group;
    shl.b32 %r14, %r4, 21;
    add.u32 %r14, %r14, %r22;
    mov.u32 %r17, 0;

KEY_TILE:
    // Read one 32-key score tile, preserving the online tile order.
    tcgen05.ld.sync.aligned.16x256b.x4.b32 {%c0, %c1, %c2, %c3, %c4, %c5, %c6, %c7, %c8, %c9, %c10, %c11, %c12, %c13, %c14, %c15}, [%r14];
    tcgen05.wait::ld.sync.aligned;

    // Each four-lane group reduces its two query-row maxima.
    max.f32 %mx0, %c0, %c1;
    max.f32 %mx0, %mx0, %c4;
    max.f32 %mx0, %mx0, %c5;
    max.f32 %mx0, %mx0, %c8;
    max.f32 %mx0, %mx0, %c9;
    max.f32 %mx0, %mx0, %c12;
    max.f32 %mx0, %mx0, %c13;
    shfl.sync.bfly.b32 %t0, %mx0, 1, 31, -1;
    max.f32 %mx0, %mx0, %t0;
    shfl.sync.bfly.b32 %t0, %mx0, 2, 31, -1;
    max.f32 %mx0, %mx0, %t0;
    mul.f32 %mx0, %mx0, 0f3E38AA3B;
    max.f32 %mx0, %mx0, %l0;
    max.f32 %mx1, %c2, %c3;
    max.f32 %mx1, %mx1, %c6;
    max.f32 %mx1, %mx1, %c7;
    max.f32 %mx1, %mx1, %c10;
    max.f32 %mx1, %mx1, %c11;
    max.f32 %mx1, %mx1, %c14;
    max.f32 %mx1, %mx1, %c15;
    shfl.sync.bfly.b32 %t0, %mx1, 1, 31, -1;
    max.f32 %mx1, %mx1, %t0;
    shfl.sync.bfly.b32 %t0, %mx1, 2, 31, -1;
    max.f32 %mx1, %mx1, %t0;
    mul.f32 %mx1, %mx1, 0f3E38AA3B;
    max.f32 %mx1, %mx1, %l1;

    // Base-two statistics avoid repeated logarithm-base conversions.
    sub.f32 %t0, %m0, %mx0;
    ex2.approx.f32 %scale0, %t0;
    mov.b64 %v0, {%scale0, %scale0};
    neg.f32 %t2, %mx0;
    mov.b64 %v4, {%t2, %t2};
    sub.f32 %t0, %m1, %mx1;
    ex2.approx.f32 %scale1, %t0;
    mov.b64 %v1, {%scale1, %scale1};
    neg.f32 %t3, %mx1;
    mov.b64 %v5, {%t3, %t3};

    // Packed FP32 FMA handles adjacent score columns together.
    mov.b64 %v3, 0x3E38AA3B3E38AA3B;
    mov.b64 %v2, {%c0, %c1};
    fma.rn.f32x2 %v2, %v2, %v3, %v4;
    mov.b64 {%c0, %c1}, %v2;
    ex2.approx.f32 %c0, %c0;
    ex2.approx.f32 %c1, %c1;
    mov.b64 %v2, {%c2, %c3};
    fma.rn.f32x2 %v2, %v2, %v3, %v5;
    mov.b64 {%c2, %c3}, %v2;
    ex2.approx.f32 %c2, %c2;
    ex2.approx.f32 %c3, %c3;
    mov.b64 %v2, {%c4, %c5};
    fma.rn.f32x2 %v2, %v2, %v3, %v4;
    mov.b64 {%c4, %c5}, %v2;
    ex2.approx.f32 %c4, %c4;
    ex2.approx.f32 %c5, %c5;
    mov.b64 %v2, {%c6, %c7};
    fma.rn.f32x2 %v2, %v2, %v3, %v5;
    mov.b64 {%c6, %c7}, %v2;
    ex2.approx.f32 %c6, %c6;
    ex2.approx.f32 %c7, %c7;
    mov.b64 %v2, {%c8, %c9};
    fma.rn.f32x2 %v2, %v2, %v3, %v4;
    mov.b64 {%c8, %c9}, %v2;
    ex2.approx.f32 %c8, %c8;
    ex2.approx.f32 %c9, %c9;
    mov.b64 %v2, {%c10, %c11};
    fma.rn.f32x2 %v2, %v2, %v3, %v5;
    mov.b64 {%c10, %c11}, %v2;
    ex2.approx.f32 %c10, %c10;
    ex2.approx.f32 %c11, %c11;
    mov.b64 %v2, {%c12, %c13};
    fma.rn.f32x2 %v2, %v2, %v3, %v4;
    mov.b64 {%c12, %c13}, %v2;
    ex2.approx.f32 %c12, %c12;
    ex2.approx.f32 %c13, %c13;
    mov.b64 %v2, {%c14, %c15};
    fma.rn.f32x2 %v2, %v2, %v3, %v5;
    mov.b64 {%c14, %c15}, %v2;
    ex2.approx.f32 %c14, %c14;
    ex2.approx.f32 %c15, %c15;

    // Sum FP32 probabilities before rounding them to FP16.
    mov.b64 %v6, {%c0, %c1};
    mov.b64 %v7, {%c4, %c5};
    mov.b64 %v8, {%c8, %c9};
    mov.b64 %v9, {%c12, %c13};
    add.f32x2 %v6, %v6, %v7;
    add.f32x2 %v8, %v8, %v9;
    add.f32x2 %v6, %v6, %v8;
    mov.b64 {%t0, %t1}, %v6;
    add.f32 %sum0, %t0, %t1;
    shfl.sync.bfly.b32 %t0, %sum0, 1, 31, -1;
    add.f32 %sum0, %sum0, %t0;
    shfl.sync.bfly.b32 %t0, %sum0, 2, 31, -1;
    add.f32 %sum0, %sum0, %t0;
    mov.b64 %v6, {%c2, %c3};
    mov.b64 %v7, {%c6, %c7};
    mov.b64 %v8, {%c10, %c11};
    mov.b64 %v9, {%c14, %c15};
    add.f32x2 %v6, %v6, %v7;
    add.f32x2 %v8, %v8, %v9;
    add.f32x2 %v6, %v6, %v8;
    mov.b64 {%t0, %t1}, %v6;
    add.f32 %sum1, %t0, %t1;
    shfl.sync.bfly.b32 %t0, %sum1, 1, 31, -1;
    add.f32 %sum1, %sum1, %t0;
