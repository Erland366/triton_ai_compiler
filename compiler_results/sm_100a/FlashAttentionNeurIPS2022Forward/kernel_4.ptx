{
    .reg .b32 %r<32>, %b<4>, %p<8>, %pack;
    .reg .b64 %rd<16>, %v<12>;
    .reg .f32 %c<16>, %o<32>, %m<2>, %l<2>, %mx<2>, %sum<2>, %scale<2>, %t<8>;
    .reg .pred %pred<3>;

    // Four warps own sixteen query rows each. All fixed-size tiles are in bounds.
    mov.u32 %r0, %tid.x;
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ctaid.y;
    and.b32 %r3, %r0, 31;
    shr.u32 %r4, %r0, 5;
    mul.wide.u32 %rd0, %r2, 16384;
    ld.param.u64 %rd1, [Q_ptr];
    ld.param.u64 %rd2, [K_ptr];
    ld.param.u64 %rd3, [V_ptr];
