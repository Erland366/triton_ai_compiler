    mov.f32 %m1, 0fFF800000;
    mov.f32 %l0, 0fFF800000;
    mov.f32 %l1, 0fFF800000;
    mov.f32 %o0, 0f00000000;
    mov.f32 %o1, 0f00000000;
    mov.f32 %o2, 0f00000000;
    mov.f32 %o3, 0f00000000;
    mov.f32 %o4, 0f00000000;
    mov.f32 %o5, 0f00000000;
    mov.f32 %o6, 0f00000000;
    mov.f32 %o7, 0f00000000;
    mov.f32 %o8, 0f00000000;
    mov.f32 %o9, 0f00000000;
    mov.f32 %o10, 0f00000000;
    mov.f32 %o11, 0f00000000;
    mov.f32 %o12, 0f00000000;
    mov.f32 %o13, 0f00000000;
    mov.f32 %o14, 0f00000000;
    mov.f32 %o15, 0f00000000;
    mov.f32 %o16, 0f00000000;
    mov.f32 %o17, 0f00000000;
    mov.f32 %o18, 0f00000000;
    mov.f32 %o19, 0f00000000;
    mov.f32 %o20, 0f00000000;
    mov.f32 %o21, 0f00000000;
    mov.f32 %o22, 0f00000000;
    mov.f32 %o23, 0f00000000;
    mov.f32 %o24, 0f00000000;
    mov.f32 %o25, 0f00000000;
    mov.f32 %o26, 0f00000000;
    mov.f32 %o27, 0f00000000;
    mov.f32 %o28, 0f00000000;
    mov.f32 %o29, 0f00000000;
