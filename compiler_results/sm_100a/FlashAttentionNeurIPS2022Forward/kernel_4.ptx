    mov.b64 %v2, {%o10, %o11}; mul.f32x2 %v2, %v2, %v1; mov.b64 {%o10, %o11}, %v2;
    mov.b64 %v2, {%o12, %o13}; mul.f32x2 %v2, %v2, %v0; mov.b64 {%o12, %o13}, %v2;
    mov.b64 %v2, {%o14, %o15}; mul.f32x2 %v2, %v2, %v1; mov.b64 {%o14, %o15}, %v2;
    mov.b64 %v2, {%o16, %o17}; mul.f32x2 %v2, %v2, %v0; mov.b64 {%o16, %o17}, %v2;
    mov.b64 %v2, {%o18, %o19}; mul.f32x2 %v2, %v2, %v1; mov.b64 {%o18, %o19}, %v2;
    mov.b64 %v2, {%o20, %o21}; mul.f32x2 %v2, %v2, %v0; mov.b64 {%o20, %o21}, %v2;
    mov.b64 %v2, {%o22, %o23}; mul.f32x2 %v2, %v2, %v1; mov.b64 {%o22, %o23}, %v2;
    mov.b64 %v2, {%o24, %o25}; mul.f32x2 %v2, %v2, %v0; mov.b64 {%o24, %o25}, %v2;
    mov.b64 %v2, {%o26, %o27}; mul.f32x2 %v2, %v2, %v1; mov.b64 {%o26, %o27}, %v2;
    mov.b64 %v2, {%o28, %o29}; mul.f32x2 %v2, %v2, %v0; mov.b64 {%o28, %o29}, %v2;
    mov.b64 %v2, {%o30, %o31}; mul.f32x2 %v2, %v2, %v1; mov.b64 {%o30, %o31}, %v2;

