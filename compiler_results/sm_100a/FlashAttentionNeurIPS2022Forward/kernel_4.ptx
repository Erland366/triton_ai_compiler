    sub.f32 %t0, %l0, %mx0;
    ex2.approx.f32 %t0, %t0;
    add.f32 %t0, %sum0, %t0;
    lg2.approx.f32 %t0, %t0;
    add.f32 %l0, %t0, %mx0;
