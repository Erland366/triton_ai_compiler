    add.u64 %rd7, %rd2, %rd6;
    add.u64 %rd8, %rd3, %rd6;
    mul.wide.u32 %rd9, %r1, 8192;
    add.u64 %rd9, %rd9, %rd1;
    add.u64 %rd9, %rd9, %rd6;

