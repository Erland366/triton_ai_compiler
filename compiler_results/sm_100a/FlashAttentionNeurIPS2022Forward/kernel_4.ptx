    cvt.rn.f16x2.f32 %p3, %c7, %c6;
    cvt.rn.f16x2.f32 %p4, %c9, %c8;
    cvt.rn.f16x2.f32 %p5, %c11, %c10;
    cvt.rn.f16x2.f32 %p6, %c13, %c12;
