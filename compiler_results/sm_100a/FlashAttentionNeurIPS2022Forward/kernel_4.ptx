.version 8.7
.target sm_100a
.address_size 64

.extern .shared .align 16 .b8 global_smem[];

.visible .entry kernel(
    .param .u64 Q_ptr,
    .param .u64 K_ptr,
    .param .u64 V_ptr,
    .param .u64 Bias_ptr,
    .param .u64 Out_ptr,
    .param .u64 Lse_ptr,
    .param .u64 TMP_ptr,
    .param .u64 dummy_ptr1,
    .param .u64 dummy_ptr2
