.version 8.7
.target sm_100a
.address_size 64

.extern .shared .align 16 .b8 global_smem[];

.visible .entry kernel(
    .param .u64 a_ptr,
    .param .u64 b_ptr,
    .param .u64 c_ptr,
    .param .u64 dummy_ptr1,
    .param .u64 dummy_ptr2
)
{
    .reg .pred %pf, %p0, %pw, %pa, %pt, %pd, %pl;
    .reg .b32 %prevphase, %sp, %sx;
    .reg .b32 %cur, %nxt, %la, %lb, %pre;
    .reg .b32 %t, %pm, %pn, %sbase, %bar, %slot;
    .reg .b32 %x, %y, %z, %u, %v, %sa, %sb;
    .reg .b32 %ta, %tb, %it, %phase, %idesc, %warp, %wg, %col, %tl, %zero;
    .reg .b64 %ap, %bp, %cp, %ag, %bg, %off, %ad, %bd, %a1, %sd;
    .reg .f32 %f<32>;
    .reg .b32 %h<16>;

    // Three 64-KiB operand stages and two barriers use exactly 196624 bytes.
    mov.u32 %t, %tid.x;
    mov.u32 %pm, %ctaid.x;
    mov.u32 %pn, %ctaid.y;
    mov.u32 %sbase, global_smem;
    add.u32 %bar, %sbase, 196608;
    mov.u32 %slot, %sbase;
    setp.eq.u32 %p0, %t, 0;
    setp.lt.u32 %pw, %t, 32;
    @%p0 mbarrier.init.shared::cta.b64 [%bar], 1;
    @%p0 mbarrier.init.shared::cta.b64 [%bar+8], 1;
    @!%pw bra ALLOC_DONE;

    // The allocation pointer temporarily occupies the first operand bytes.
    tcgen05.alloc.cta_group::1.sync.aligned.shared::cta.b32 [%slot], 512;
    tcgen05.relinquish_alloc_permit.cta_group::1.sync.aligned;
ALLOC_DONE:
    bar.sync 0;
    ld.shared.b32 %ta, [%slot];
    bar.sync 0;
    add.u32 %tb, %ta, 256;
    ld.param.u64 %ap, [a_ptr];
    ld.param.u64 %bp, [b_ptr];
    ld.param.u64 %cp, [c_ptr];

    // All 256 threads cooperatively load aligned vectors from A and B.
    shl.b32 %x, %pm, 21;
    cvt.u64.u32 %off, %x;
    add.u64 %ap, %ap, %off;
    shr.u32 %x, %t, 3;
    and.b32 %y, %t, 7;
    shl.b32 %z, %x, 13;
    shl.b32 %u, %y, 4;
    add.u32 %z, %z, %u;
    cvt.u64.u32 %off, %z;
    add.u64 %ag, %ap, %off;
    and.b32 %x, %x, 7;
    shl.b32 %x, %x, 4;
    shl.b32 %sa, %t, 4;
    xor.b32 %sa, %sa, %x;
    add.u32 %sa, %sa, %sbase;
    shl.b32 %x, %pn, 9;
    cvt.u64.u32 %off, %x;
    add.u64 %bp, %bp, %off;
    shr.u32 %x, %t, 5;
    and.b32 %y, %t, 31;
    shl.b32 %z, %x, 13;
    shl.b32 %u, %y, 4;
    add.u32 %z, %z, %u;
    cvt.u64.u32 %off, %z;
    add.u64 %bg, %bp, %off;

    // B uses N-major 64-column slabs with 128-byte XOR swizzling.
    shr.u32 %z, %y, 3;
    shl.b32 %z, %z, 13;
    shl.b32 %v, %x, 7;
    add.u32 %z, %z, %v;
    and.b32 %y, %y, 7;
    shl.b32 %y, %y, 4;
    add.u32 %z, %z, %y;
    shl.b32 %x, %x, 4;
    xor.b32 %sb, %z, %x;
    add.u32 %sb, %sb, 32768;
    add.u32 %sb, %sb, %sbase;
    shr.u32 %x, %sbase, 4;
    cvt.u64.u32 %sd, %x;

    // Describe 128 by 256 FP32 accumulators, FP16 inputs, and N-major B.
    mov.u32 %idesc, 0x08410010;
    mov.u32 %zero, 0;
    mov.u32 %it, 0;
    setp.eq.u32 %pt, %t, %t;

    // Prime the first two operand stages.
    mov.u32 %pre, 0;
    mov.u32 %nxt, 0;
PREFILL:
    add.u32 %la, %sa, %nxt;
    add.u32 %lb, %sb, %nxt;
    cp.async.cg.shared.global [%la+0], [%ag+0], 16;
    cp.async.cg.shared.global [%lb+0], [%bg+0], 16;
    cp.async.cg.shared.global [%la+4096], [%ag+262144], 16;
    cp.async.cg.shared.global [%lb+1024], [%bg+65536], 16;
    cp.async.cg.shared.global [%la+8192], [%ag+524288], 16;
    cp.async.cg.shared.global [%lb+2048], [%bg+131072], 16;
    cp.async.cg.shared.global [%la+12288], [%ag+786432], 16;
    cp.async.cg.shared.global [%lb+3072], [%bg+196608], 16;
    cp.async.cg.shared.global [%la+16384], [%ag+1048576], 16;
    cp.async.cg.shared.global [%lb+4096], [%bg+262144], 16;
    cp.async.cg.shared.global [%la+20480], [%ag+1310720], 16;
    cp.async.cg.shared.global [%lb+5120], [%bg+327680], 16;
    cp.async.cg.shared.global [%la+24576], [%ag+1572864], 16;
    cp.async.cg.shared.global [%lb+6144], [%bg+393216], 16;
    cp.async.cg.shared.global [%la+28672], [%ag+1835008], 16;
    cp.async.cg.shared.global [%lb+7168], [%bg+458752], 16;
    cp.async.commit_group;
    add.u64 %ag, %ag, 128;
    add.u64 %bg, %bg, 524288;
    add.u32 %nxt, %nxt, 65536;
    add.u32 %pre, %pre, 1;
    setp.lt.u32 %pl, %pre, 2;
    @%pl bra PREFILL;
    mov.u32 %cur, 0;
    mov.u32 %phase, 0;

K_LOOP:
    // Two unrolled K tiles alternate the fixed completion barriers.
    setp.lt.u32 %pf, %it, 62;
    xor.b32 %prevphase, %phase, 1;
    cp.async.wait_group 1;
    bar.sync 0;
    fence.proxy.async.shared::cta;
    @!%p0 bra MMA_DONE_0;

    // Four ordered K=16 steps update both FP32 accumulator panels.
    tcgen05.fence::after_thread_sync;
    setp.ne.u32 %pa, %it, 0;
    shr.u32 %x, %cur, 4;
    cvt.u64.u32 %off, %x;
    add.u64 %off, %off, %sd;
    add.u64 %ad, %off, 0x4000404000010000;
    add.u64 %bd, %off, 0x4000404002000800;
    tcgen05.mma.cta_group::1.kind::f16 [%ta], %ad, %bd, %idesc, {%zero, %zero, %zero, %zero}, %pa;
    add.u64 %a1, %ad, 1024;
    tcgen05.mma.cta_group::1.kind::f16 [%tb], %a1, %bd, %idesc, {%zero, %zero, %zero, %zero}, %pa;
    add.u64 %ad, %ad, 2;
    add.u64 %bd, %bd, 128;
    tcgen05.mma.cta_group::1.kind::f16 [%ta], %ad, %bd, %idesc, {%zero, %zero, %zero, %zero}, %pt;
    add.u64 %a1, %ad, 1024;
    tcgen05.mma.cta_group::1.kind::f16 [%tb], %a1, %bd, %idesc, {%zero, %zero, %zero, %zero}, %pt;
    add.u64 %ad, %ad, 2;
    add.u64 %bd, %bd, 128;
    tcgen05.mma.cta_group::1.kind::f16 [%ta], %ad, %bd, %idesc, {%zero, %zero, %zero, %zero}, %pt;
    add.u64 %a1, %ad, 1024;
    tcgen05.mma.cta_group::1.kind::f16 [%tb], %a1, %bd, %idesc, {%zero, %zero, %zero, %zero}, %pt;
    add.u64 %ad, %ad, 2;
    add.u64 %bd, %bd, 128;
    tcgen05.mma.cta_group::1.kind::f16 [%ta], %ad, %bd, %idesc, {%zero, %zero, %zero, %zero}, %pt;
    add.u64 %a1, %ad, 1024;
    tcgen05.mma.cta_group::1.kind::f16 [%tb], %a1, %bd, %idesc, {%zero, %zero, %zero, %zero}, %pt;
    tcgen05.commit.cta_group::1.mbarrier::arrive::one.shared::cluster.b64 [%bar];
MMA_DONE_0:
    setp.eq.u32 %pl, %it, 0;
    @%pl bra PREV_DONE_0;
WAIT_PREV_0:
    // Only the preceding group must complete before recycling its operands.
    mbarrier.try_wait.parity.shared::cta.b64 %pd, [%bar+8], %prevphase;
    @!%pd bra WAIT_PREV_0;
PREV_DONE_0:
    @!%pf bra PREFETCH_DONE_0;

    // Load the tile two K steps ahead while the current MMA executes.
    add.u32 %la, %sa, %nxt;
    add.u32 %lb, %sb, %nxt;
    cp.async.cg.shared.global [%la+0], [%ag+0], 16;
    cp.async.cg.shared.global [%lb+0], [%bg+0], 16;
    cp.async.cg.shared.global [%la+4096], [%ag+262144], 16;
    cp.async.cg.shared.global [%lb+1024], [%bg+65536], 16;
    cp.async.cg.shared.global [%la+8192], [%ag+524288], 16;
    cp.async.cg.shared.global [%lb+2048], [%bg+131072], 16;
    cp.async.cg.shared.global [%la+12288], [%ag+786432], 16;
    cp.async.cg.shared.global [%lb+3072], [%bg+196608], 16;
    cp.async.cg.shared.global [%la+16384], [%ag+1048576], 16;
    cp.async.cg.shared.global [%lb+4096], [%bg+262144], 16;
    cp.async.cg.shared.global [%la+20480], [%ag+1310720], 16;
    cp.async.cg.shared.global [%lb+5120], [%bg+327680], 16;
    cp.async.cg.shared.global [%la+24576], [%ag+1572864], 16;
    cp.async.cg.shared.global [%lb+6144], [%bg+393216], 16;
    cp.async.cg.shared.global [%la+28672], [%ag+1835008], 16;
    cp.async.cg.shared.global [%lb+7168], [%bg+458752], 16;
PREFETCH_DONE_0:
    cp.async.commit_group;
    add.u64 %ag, %ag, 128;
    add.u64 %bg, %bg, 524288;
    add.u32 %nxt, %nxt, 65536;
    setp.eq.u32 %pl, %nxt, 196608;
    @%pl mov.u32 %nxt, 0;
    add.u32 %cur, %cur, 65536;
    setp.eq.u32 %pl, %cur, 196608;
    @%pl mov.u32 %cur, 0;

    // The odd K tile consumes the second completion barrier.
    cp.async.wait_group 1;
    bar.sync 0;
    fence.proxy.async.shared::cta;
    @!%p0 bra MMA_DONE_1;
    tcgen05.fence::after_thread_sync;
    shr.u32 %x, %cur, 4;
    cvt.u64.u32 %off, %x;
    add.u64 %off, %off, %sd;
    add.u64 %ad, %off, 0x4000404000010000;
    add.u64 %bd, %off, 0x4000404002000800;
    tcgen05.mma.cta_group::1.kind::f16 [%ta], %ad, %bd, %idesc, {%zero, %zero, %zero, %zero}, %pt;
    add.u64 %a1, %ad, 1024;
    tcgen05.mma.cta_group::1.kind::f16 [%tb], %a1, %bd, %idesc, {%zero, %zero, %zero, %zero}, %pt;
    add.u64 %ad, %ad, 2;
    add.u64 %bd, %bd, 128;
    tcgen05.mma.cta_group::1.kind::f16 [%ta], %ad, %bd, %idesc, {%zero, %zero, %zero, %zero}, %pt;
    add.u64 %a1, %ad, 1024;
    tcgen05.mma.cta_group::1.kind::f16 [%tb], %a1, %bd, %idesc, {%zero, %zero, %zero, %zero}, %pt;
    add.u64 %ad, %ad, 2;
    add.u64 %bd, %bd, 128;
    tcgen05.mma.cta_group::1.kind::f16 [%ta], %ad, %bd, %idesc, {%zero, %zero, %zero, %zero}, %pt;
    add.u64 %a1, %ad, 1024;
    tcgen05.mma.cta_group::1.kind::f16 [%tb], %a1, %bd, %idesc, {%zero, %zero, %zero, %zero}, %pt;
    add.u64 %ad, %ad, 2;
    add.u64 %bd, %bd, 128;
    tcgen05.mma.cta_group::1.kind::f16 [%ta], %ad, %bd, %idesc, {%zero, %zero, %zero, %zero}, %pt;
    add.u64 %a1, %ad, 1024;
    tcgen05.mma.cta_group::1.kind::f16 [%tb], %a1, %bd, %idesc, {%zero, %zero, %zero, %zero}, %pt;
    tcgen05.commit.cta_group::1.mbarrier::arrive::one.shared::cluster.b64 [%bar+8];
MMA_DONE_1:
WAIT_PREV_1:
    // The even group's completion permits reuse of its shared stage.
    mbarrier.try_wait.parity.shared::cta.b64 %pd, [%bar], %phase;
    @!%pd bra WAIT_PREV_1;
    @!%pf bra PREFETCH_DONE_1;

    // Continue the two-tile lookahead.
    add.u32 %la, %sa, %nxt;
    add.u32 %lb, %sb, %nxt;
    cp.async.cg.shared.global [%la+0], [%ag+0], 16;
    cp.async.cg.shared.global [%lb+0], [%bg+0], 16;
    cp.async.cg.shared.global [%la+4096], [%ag+262144], 16;
    cp.async.cg.shared.global [%lb+1024], [%bg+65536], 16;
    cp.async.cg.shared.global [%la+8192], [%ag+524288], 16;
    cp.async.cg.shared.global [%lb+2048], [%bg+131072], 16;
    cp.async.cg.shared.global [%la+12288], [%ag+786432], 16;
    cp.async.cg.shared.global [%lb+3072], [%bg+196608], 16;
    cp.async.cg.shared.global [%la+16384], [%ag+1048576], 16;
    cp.async.cg.shared.global [%lb+4096], [%bg+262144], 16;
    cp.async.cg.shared.global [%la+20480], [%ag+1310720], 16;
    cp.async.cg.shared.global [%lb+5120], [%bg+327680], 16;
    cp.async.cg.shared.global [%la+24576], [%ag+1572864], 16;
    cp.async.cg.shared.global [%lb+6144], [%bg+393216], 16;
    cp.async.cg.shared.global [%la+28672], [%ag+1835008], 16;
    cp.async.cg.shared.global [%lb+7168], [%bg+458752], 16;
PREFETCH_DONE_1:
    cp.async.commit_group;
    add.u64 %ag, %ag, 128;
    add.u64 %bg, %bg, 524288;
    add.u32 %nxt, %nxt, 65536;
    setp.eq.u32 %pl, %nxt, 196608;
    @%pl mov.u32 %nxt, 0;
    add.u32 %cur, %cur, 65536;
    setp.eq.u32 %pl, %cur, 196608;
    @%pl mov.u32 %cur, 0;
    xor.b32 %phase, %phase, 1;
    add.u32 %it, %it, 2;
    setp.lt.u32 %pl, %it, 64;
    @%pl bra K_LOOP;
    cp.async.wait_group 0;

    // Drain all asynchronous operations before the epilogue.
WAIT_LAST:
    mbarrier.try_wait.parity.shared::cta.b64 %pd, [%bar+8], 1;
    @!%pd bra WAIT_LAST;
    bar.sync 0;

    // Map all eight warps to tensor-memory rows and output panels.
    tcgen05.fence::after_thread_sync;
    shr.u32 %warp, %t, 5;
    and.b32 %x, %warp, 3;
    shl.b32 %x, %x, 21;
    shr.u32 %wg, %t, 7;
    shl.b32 %y, %wg, 8;
    add.u32 %tl, %ta, %x;
    add.u32 %tl, %tl, %y;
    mov.u32 %col, 0;
PACK_LOOP:
    // Round once to FP16 and pack swizzled 8-column slabs in reused shared memory.
    tcgen05.ld.sync.aligned.32x32b.x32.b32 {%f0, %f1, %f2, %f3, %f4, %f5, %f6, %f7, %f8, %f9, %f10, %f11, %f12, %f13, %f14, %f15, %f16, %f17, %f18, %f19, %f20, %f21, %f22, %f23, %f24, %f25, %f26, %f27, %f28, %f29, %f30, %f31}, [%tl];
    tcgen05.wait::ld.sync.aligned;
    cvt.rn.f16x2.f32 %h0, %f1, %f0;
    cvt.rn.f16x2.f32 %h1, %f3, %f2;
    cvt.rn.f16x2.f32 %h2, %f5, %f4;
    cvt.rn.f16x2.f32 %h3, %f7, %f6;
    cvt.rn.f16x2.f32 %h4, %f9, %f8;
    cvt.rn.f16x2.f32 %h5, %f11, %f10;
    cvt.rn.f16x2.f32 %h6, %f13, %f12;
    cvt.rn.f16x2.f32 %h7, %f15, %f14;
    cvt.rn.f16x2.f32 %h8, %f17, %f16;
    cvt.rn.f16x2.f32 %h9, %f19, %f18;
    cvt.rn.f16x2.f32 %h10, %f21, %f20;
    cvt.rn.f16x2.f32 %h11, %f23, %f22;
    cvt.rn.f16x2.f32 %h12, %f25, %f24;
    cvt.rn.f16x2.f32 %h13, %f27, %f26;
    cvt.rn.f16x2.f32 %h14, %f29, %f28;
    cvt.rn.f16x2.f32 %h15, %f31, %f30;
    shr.u32 %x, %col, 3;
    and.b32 %y, %x, 7;
    xor.b32 %y, %y, %t;
    shl.b32 %y, %y, 4;
    shl.b32 %x, %x, 12;
    add.u32 %sp, %x, %y;
    add.u32 %sp, %sp, %sbase;
    st.shared.v4.b32 [%sp], {%h0, %h1, %h2, %h3};
    xor.b32 %sx, %sp, 16;
    st.shared.v4.b32 [%sx+4096], {%h4, %h5, %h6, %h7};
    xor.b32 %sx, %sp, 32;
    st.shared.v4.b32 [%sx+8192], {%h8, %h9, %h10, %h11};
    xor.b32 %sx, %sp, 48;
    st.shared.v4.b32 [%sx+12288], {%h12, %h13, %h14, %h15};
    add.u32 %tl, %tl, 32;
    add.u32 %col, %col, 32;
    setp.lt.u32 %pl, %col, 256;
    @%pl bra PACK_LOOP;
    bar.sync 0;

    // Redistribute slabs to coalesced 16-byte global stores.
    shr.u32 %x, %t, 5;
    and.b32 %y, %t, 31;
    and.b32 %z, %y, 7;
    xor.b32 %z, %z, %x;
    shl.b32 %z, %z, 4;
    shl.b32 %u, %y, 12;
    add.u32 %sp, %u, %z;
    add.u32 %sp, %sp, %sbase;
    shl.b32 %z, %pm, 8;
    add.u32 %x, %x, %z;
    shl.b32 %x, %x, 13;
    shl.b32 %z, %pn, 9;
    add.u32 %x, %x, %z;
    shl.b32 %y, %y, 4;
    add.u32 %x, %x, %y;
    cvt.u64.u32 %off, %x;
    add.u64 %cp, %cp, %off;
    mov.u32 %it, 0;
STORE_LOOP:
    // Four independent loads hide shared-memory latency.
    ld.shared.v4.b32 {%h0, %h1, %h2, %h3}, [%sp+0];
    ld.shared.v4.b32 {%h4, %h5, %h6, %h7}, [%sp+128];
    ld.shared.v4.b32 {%h8, %h9, %h10, %h11}, [%sp+256];
    ld.shared.v4.b32 {%h12, %h13, %h14, %h15}, [%sp+384];
    st.global.v4.b32 [%cp+0], {%h0, %h1, %h2, %h3};
    st.global.v4.b32 [%cp+65536], {%h4, %h5, %h6, %h7};
    st.global.v4.b32 [%cp+131072], {%h8, %h9, %h10, %h11};
    st.global.v4.b32 [%cp+196608], {%h12, %h13, %h14, %h15};
    add.u32 %sp, %sp, 512;
    add.u64 %cp, %cp, 262144;
    add.u32 %it, %it, 1;
    setp.lt.u32 %pl, %it, 8;
    @%pl bra STORE_LOOP;

    // All tensor-memory reads finished at the epilogue barrier.
    @!%pw bra EXIT;
    tcgen05.dealloc.cta_group::1.sync.aligned.b32 %ta, 512;
EXIT:
    ret;
}
