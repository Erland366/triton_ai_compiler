.version 8.7
.target sm_100a
.address_size 64

.extern .shared .align 16 .b8 global_smem[];

.visible .entry kernel(
    .param .u64 gate_ptr,
    .param .u64 value_ptr,
    .param .u64 output_ptr,
    .param .u64 dummy_ptr1,
    .param .u64 dummy_ptr2
)
{
    .reg .b64 %g,%v,%o,%off;
    .reg .b32 %t,%b,%idx,%G<4>,%V<4>,%O<4>;
    .reg .b16 %gh<8>,%vh<8>;
    .reg .f32 %x<8>,%y<8>,%e<8>,%r<8>;

    // Eight consecutive halves per thread cover the entire 1024-element tile.
    ld.param.u64 %g,[gate_ptr];
    ld.param.u64 %v,[value_ptr];
    ld.param.u64 %o,[output_ptr];
    mov.u32 %t,%tid.x;
    mov.u32 %b,%ctaid.x;
    shl.b32 %t,%t,3;
    mad.lo.u32 %idx,%b,1024,%t;
    mul.wide.u32 %off,%idx,2;
    add.u64 %g,%g,%off;
    add.u64 %v,%v,%off;
    add.u64 %o,%o,%off;

    // Load aligned 16-byte spans; all tile elements are valid without masking.
    ld.global.v4.b32 {%G0,%G1,%G2,%G3},[%g];
    ld.global.v4.b32 {%V0,%V1,%V2,%V3},[%v];

    // Unpack the half inputs and promote them to float32.
    mov.b32 {%gh0,%gh1},%G0;
    mov.b32 {%gh2,%gh3},%G1;
    mov.b32 {%gh4,%gh5},%G2;
    mov.b32 {%gh6,%gh7},%G3;
    mov.b32 {%vh0,%vh1},%V0;
    mov.b32 {%vh2,%vh3},%V1;
    mov.b32 {%vh4,%vh5},%V2;
    mov.b32 {%vh6,%vh7},%V3;
    cvt.f32.f16 %x0,%gh0;
    cvt.f32.f16 %x1,%gh1;
    cvt.f32.f16 %x2,%gh2;
    cvt.f32.f16 %x3,%gh3;
    cvt.f32.f16 %x4,%gh4;
    cvt.f32.f16 %x5,%gh5;
    cvt.f32.f16 %x6,%gh6;
    cvt.f32.f16 %x7,%gh7;
    cvt.f32.f16 %y0,%vh0;
    cvt.f32.f16 %y1,%vh1;
    cvt.f32.f16 %y2,%vh2;
    cvt.f32.f16 %y3,%vh3;
    cvt.f32.f16 %y4,%vh4;
    cvt.f32.f16 %y5,%vh5;
    cvt.f32.f16 %y6,%vh6;
    cvt.f32.f16 %y7,%vh7;

    // Compute exp(-gate) with the float32 constant -log2(e).
    mul.f32 %e0,%x0,0fBFB8AA3B;
    mul.f32 %e1,%x1,0fBFB8AA3B;
    mul.f32 %e2,%x2,0fBFB8AA3B;
    mul.f32 %e3,%x3,0fBFB8AA3B;
    mul.f32 %e4,%x4,0fBFB8AA3B;
    mul.f32 %e5,%x5,0fBFB8AA3B;
    mul.f32 %e6,%x6,0fBFB8AA3B;
    mul.f32 %e7,%x7,0fBFB8AA3B;
    ex2.approx.f32 %e0,%e0;
    ex2.approx.f32 %e1,%e1;
    ex2.approx.f32 %e2,%e2;
    ex2.approx.f32 %e3,%e3;
    ex2.approx.f32 %e4,%e4;
    ex2.approx.f32 %e5,%e5;
    ex2.approx.f32 %e6,%e6;
    ex2.approx.f32 %e7,%e7;

    // Compute independent sigmoid reciprocals to expose instruction parallelism.
    add.f32 %e0,%e0,0f3F800000;
    add.f32 %e1,%e1,0f3F800000;
    add.f32 %e2,%e2,0f3F800000;
    add.f32 %e3,%e3,0f3F800000;
    add.f32 %e4,%e4,0f3F800000;
    add.f32 %e5,%e5,0f3F800000;
    add.f32 %e6,%e6,0f3F800000;
    add.f32 %e7,%e7,0f3F800000;
    rcp.approx.f32 %r0,%e0;
    rcp.approx.f32 %r1,%e1;
    rcp.approx.f32 %r2,%e2;
    rcp.approx.f32 %r3,%e3;
    rcp.approx.f32 %r4,%e4;
    rcp.approx.f32 %r5,%e5;
    rcp.approx.f32 %r6,%e6;
    rcp.approx.f32 %r7,%e7;

    // Multiply gate by sigmoid, then multiply by value in float32.
    mul.f32 %x0,%x0,%r0;
    mul.f32 %x1,%x1,%r1;
    mul.f32 %x2,%x2,%r2;
    mul.f32 %x3,%x3,%r3;
    mul.f32 %x4,%x4,%r4;
    mul.f32 %x5,%x5,%r5;
    mul.f32 %x6,%x6,%r6;
    mul.f32 %x7,%x7,%r7;
    mul.f32 %x0,%x0,%y0;
    mul.f32 %x1,%x1,%y1;
    mul.f32 %x2,%x2,%y2;
    mul.f32 %x3,%x3,%y3;
    mul.f32 %x4,%x4,%y4;
    mul.f32 %x5,%x5,%y5;
    mul.f32 %x6,%x6,%y6;
    mul.f32 %x7,%x7,%y7;

    // Round to half, pack adjacent results, and write one vector per thread.
    cvt.rn.f16x2.f32 %O0,%x1,%x0;
    cvt.rn.f16x2.f32 %O1,%x3,%x2;
    cvt.rn.f16x2.f32 %O2,%x5,%x4;
    cvt.rn.f16x2.f32 %O3,%x7,%x6;
    st.global.v4.b32 [%o],{%O0,%O1,%O2,%O3};
    ret;
}
