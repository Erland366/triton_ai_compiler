    // Compute exact NCHW addresses for coalesced four-pixel output vectors.
    and.b32 %r40, %r0, 15;
    shl.b32 %r41, %r40, 2;
    add.u32 %r41, %r41, %r3;
    div.u32 %r42, %r41, 2916;
    rem.u32 %r43, %r41, 2916;
    shr.u32 %r44, %r0, 4;
    add.u32 %r45, %r44, %r4;
    mad.lo.u32 %r46, %r45, 2916, %r43;
    mad.lo.u32 %r46, %r42, 373248, %r46;
    mul.wide.u32 %rd13, %r46, 2;
    add.u64 %rd13, %rd2, %rd13;
    xor.b32 %r48, %r44, %r40;
    shl.b32 %r48, %r48, 3;
    mad.lo.u32 %r49, %r44, 128, %r48;
    add.u32 %r49, %r49, %r5;
    mov.u32 %r47, 0;
STORE_LOOP:
    // Each pass stores 32 channels with aligned vector writes.
    xor.b32 %r48, %r49, 64;
    ld.shared.v2.b32 {%r50, %r54}, [%r49];
    st.global.v2.b32 [%rd13], {%r50, %r54};
    ld.shared.v2.b32 {%r50, %r54}, [%r48+1024];
    st.global.v2.b32 [%rd13+46656], {%r50, %r54};
    ld.shared.v2.b32 {%r50, %r54}, [%r49+2048];
    st.global.v2.b32 [%rd13+93312], {%r50, %r54};
    ld.shared.v2.b32 {%r50, %r54}, [%r48+3072];
    st.global.v2.b32 [%rd13+139968], {%r50, %r54};
    add.u32 %r49, %r49, 4096;
    add.u64 %rd13, %rd13, 186624;
    add.u32 %r47, %r47, 1;
    setp.lt.u32 %p5, %r47, 4;
    @%p5 bra STORE_LOOP;

    // Retire tensor memory after all readers have completed.
    bar.sync 0;
    @%p1 tcgen05.dealloc.cta_group::1.sync.aligned.b32 %r8, 64;
    @%p0 mbarrier.inval.shared::cta.b64 [%r6];
    @%p0 mbarrier.inval.shared::cta.b64 [%r69];
    ret;
}
